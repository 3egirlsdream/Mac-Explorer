<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:MacExplorer.Controls" xmlns:icons="using:MacExplorer.Assets"
             x:Class="MacExplorer.Controls.BackgroundThemeSettingsView">
    <StackPanel Spacing="6">
        <Border Classes="settings-group">
            <StackPanel>
                <Border Classes="settings-row settings-divider">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Classes="settings-label" Text="{loc:Loc background.enabled}" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" x:Name="EnabledToggle" Classes="compact" OnContent="" OffContent=""
                                      AutomationProperties.Name="{loc:Loc background.enabled}" IsCheckedChanged="OptionsChanged"/>
                        <Button Grid.Column="2" x:Name="UseImageButton" Classes="icon-action" Width="28" Height="28" ToolTip.Tip="{loc:Loc background.custom}" AutomationProperties.Name="{loc:Loc background.custom}" Click="UseCustomImage" IsVisible="False">
                            <PathIcon Data="{x:Static icons:Icons.Image}" Width="16" Height="16"/>
                        </Button>
                        <Button Grid.Column="3" x:Name="ChooseButton" Classes="secondary compact" Content="{loc:Loc background.choose}" Click="ChooseImage"/>
                        <Button Grid.Column="4" x:Name="ResetButton" Classes="ghost compact" Content="{loc:Loc background.reset}" Click="ResetTheme"/>
                    </Grid>
                </Border>
                <Border x:Name="CustomImageRow" Classes="settings-row settings-divider" IsVisible="False">
                    <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                        <Border CornerRadius="{DynamicResource RadiusSm}" ClipToBounds="True" Height="36">
                            <Image x:Name="PreviewImage" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="ImageName" Classes="settings-label" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
                <UniformGrid x:Name="PatternRows" Columns="3" Margin="7,5"/>
                <Border x:Name="LayoutRow" Classes="settings-row settings-divider">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock x:Name="LayoutLabel" Classes="settings-label" Text="{loc:Loc background.layout}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="LayoutCombo" Width="200" Classes="settings-inline-input"
                                  AutomationProperties.Name="{loc:Loc background.layout}" SelectionChanged="OptionsChanged"/>
                    </Grid>
                </Border>
                <Border x:Name="StrengthRow" Classes="settings-row">
                    <Grid ColumnDefinitions="*,160,38" ColumnSpacing="8">
                        <TextBlock x:Name="StrengthLabel" Classes="settings-label" Text="{loc:Loc background.strength}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="StrengthSlider" Minimum="0" Maximum="100" TickFrequency="1"
                                IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                                AutomationProperties.Name="{loc:Loc background.strength}"/>
                        <TextBlock Grid.Column="2" x:Name="StrengthValue" Classes="settings-description" VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
        <TextBlock x:Name="ErrorText" Classes="settings-description" Foreground="{DynamicResource DangerBrush}" IsVisible="False"/>
    </StackPanel>
</UserControl>
