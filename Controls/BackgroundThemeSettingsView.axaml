<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:MacExplorer.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:MacExplorer.Controls" xmlns:icons="using:MacExplorer.Assets"
             x:Class="MacExplorer.Controls.BackgroundThemeSettingsView">
    <StackPanel Spacing="6">
        <Border Classes="settings-group">
            <StackPanel>
                <Border Classes="settings-row settings-divider">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Classes="settings-label" Text="{loc:Loc background.enabled}" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" x:Name="EnabledToggle" Classes="compact" OnContent="" OffContent=""
                                      HorizontalAlignment="Right" AutomationProperties.Name="{loc:Loc background.enabled}" IsCheckedChanged="OptionsChanged"/>
                    </Grid>
                </Border>
                <Border x:Name="CustomImageRow" Classes="settings-row settings-divider" IsVisible="False">
                    <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                        <Border CornerRadius="{DynamicResource RadiusSm}" ClipToBounds="True" Height="36">
                            <Image x:Name="PreviewImage" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="ImageName" Classes="settings-label" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
                <UniformGrid x:Name="PatternRows" Columns="3" Margin="7,5"/>
                <Border Classes="settings-row settings-divider">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <controls:AppButton x:Name="UseImageButton" Classes="icon-action" ToolTip.Tip="{loc:Loc background.custom}" AutomationProperties.Name="{loc:Loc background.custom}" Click="UseCustomImage" IsVisible="False">
                            <PathIcon Data="{x:Static icons:Icons.Image}" Width="16" Height="16"/>
                        </controls:AppButton>
                        <controls:AppButton x:Name="ChooseButton" Classes="secondary compact" Content="{loc:Loc background.choose}" Click="ChooseImage"/>
                    </StackPanel>
                </Border>
                <Border x:Name="StrengthRow" Classes="settings-row">
                    <Grid ColumnDefinitions="*,160,38" ColumnSpacing="8">
                        <TextBlock x:Name="StrengthLabel" Classes="settings-label" Text="{loc:Loc background.transparency}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="StrengthSlider" Minimum="0" Maximum="100" TickFrequency="1"
                                IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                                AutomationProperties.Name="{loc:Loc background.transparency}" ToolTip.Tip="{loc:Loc background.transparency_tip}"/>
                        <TextBlock Grid.Column="2" x:Name="StrengthValue" Classes="settings-description" VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
        <TextBlock x:Name="ErrorText" Classes="settings-description" Foreground="{DynamicResource DangerBrush}" IsVisible="False"/>
        <Popup x:Name="ColorPalettePopup" Placement="BottomEdgeAlignedLeft"
               HorizontalOffset="-12" VerticalOffset="-10" IsLightDismissEnabled="True"
               ShouldUseOverlayLayer="True" OverlayDismissEventPassThrough="True" WindowManagerAddShadowHint="False" Closed="PaletteClosed">
            <Border Classes="context-submenu-surface">
                <ContentControl x:Name="PaletteContent"/>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
