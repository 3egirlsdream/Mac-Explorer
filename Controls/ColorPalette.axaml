<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:MacExplorer.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:MacExplorer.Controls" xmlns:icons="using:MacExplorer.Assets" x:Class="MacExplorer.Controls.ColorPalette">
    <UserControl.Styles>
        <Style Selector="Border.color-palette-surface">
            <Setter Property="Background" Value="{DynamicResource ColorBgHover}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="PathIcon.color-palette-reset-icon">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="controls|ColorPalette.popover Border.color-palette-surface">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style Selector="controls|ColorPalette.popover TextBlock.color-palette-reset-label">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="controls|ColorPalette.popover PathIcon.color-palette-reset-icon">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="Border.color-palette-dot">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusFull}"/>
        </Style>
    </UserControl.Styles>
    <Border Classes="color-palette-surface">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel>
                    <TextBlock Classes="settings-label" Text="{loc:Loc ui.247}"/>
                    <TextBlock x:Name="DescriptionText" Classes="settings-description" IsVisible="False"/>
                </StackPanel>
                <controls:AppButton Grid.Column="1" x:Name="ResetButton" Classes="secondary compact"
                        ToolTip.Tip="{loc:Loc ui.177}" AutomationProperties.Name="{loc:Loc ui.177}" Click="ResetClicked">
                    <Grid>
                        <TextBlock Classes="color-palette-reset-label" Text="{loc:Loc ui.177}" VerticalAlignment="Center"/>
                        <PathIcon Classes="color-palette-reset-icon" Data="{x:Static icons:Icons.Refresh}" Width="14" Height="14"/>
                    </Grid>
                </controls:AppButton>
            </Grid>
            <WrapPanel x:Name="Swatches"/>
            <TextBox x:Name="ColorInput" Classes="settings-inline-input" PlaceholderText="#RRGGBB"
                     ToolTip.Tip="{loc:Loc color.palette.hex_hint}" AutomationProperties.Name="{loc:Loc background.palette.custom}" TextChanged="InputChanged" LostFocus="InputCommitted" KeyDown="InputKeyDown"/>
            <TextBlock x:Name="ErrorText" Classes="settings-description" Foreground="{DynamicResource DangerBrush}" IsVisible="False"/>
        </StackPanel>
    </Border>
</UserControl>
