<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MacExplorer.Controls"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="MacExplorer.Controls.WindowTitleBar"
             x:Name="TitleBarRoot"
             MinHeight="44">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TrafficLightInactiveBrush" Color="#C8C8C8"/>
                    <SolidColorBrush x:Key="TrafficLightOutlineBrush" Color="#24000000"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TrafficLightInactiveBrush" Color="#555555"/>
                    <SolidColorBrush x:Key="TrafficLightOutlineBrush" Color="#30000000"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="TrafficLightCloseSymbolBrush" Color="#760E08"/>
            <SolidColorBrush x:Key="TrafficLightMinimizeSymbolBrush" Color="#805400"/>
            <SolidColorBrush x:Key="TrafficLightFullScreenSymbolBrush" Color="#075D13"/>
            <SolidColorBrush x:Key="TrafficLightClosePressedBrush" Color="#E04A43"/>
            <SolidColorBrush x:Key="TrafficLightMinimizePressedBrush" Color="#DEA123"/>
            <SolidColorBrush x:Key="TrafficLightFullScreenPressedBrush" Color="#20AD35"/>
            <StreamGeometry x:Key="TrafficLightEnterFullScreenGeometry">M3,3 H7 L3,7 Z M9,9 H5 L9,5 Z</StreamGeometry>
            <StreamGeometry x:Key="TrafficLightExitFullScreenGeometry">M5.25,5.25 H2.75 L5.25,2.75 Z M6.75,6.75 H9.25 L6.75,9.25 Z</StreamGeometry>
            <ControlTheme x:Key="TrafficLightButtonTheme" TargetType="Button">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid Background="Transparent">
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"/>
                            <Ellipse x:Name="FocusRing" Width="22" Height="22"
                                     Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                     IsHitTestVisible="False"/>
                        </Grid>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^ /template/ Ellipse#FocusRing">
                    <Setter Property="Opacity" Value="0"/>
                </Style>
                <Style Selector="^:focus-visible /template/ Ellipse#FocusRing">
                    <Setter Property="Opacity" Value="1"/>
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.window-control">
            <Setter Property="Theme" Value="{StaticResource TrafficLightButtonTheme}"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions" Value="{x:Null}"/>
        </Style>
        <Style Selector="Button.window-control:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.window-control:pressed">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.window-control:disabled">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.window-control:focus-visible">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Ellipse.traffic-light">
            <Setter Property="Stroke" Value="{DynamicResource TrafficLightOutlineBrush}"/>
            <Setter Property="StrokeThickness" Value="0.5"/>
        </Style>
        <Style Selector="Ellipse.traffic-close">
            <Setter Property="Fill" Value="{DynamicResource WindowCloseBrush}"/>
        </Style>
        <Style Selector="Ellipse.traffic-minimize">
            <Setter Property="Fill" Value="{DynamicResource WindowMinimizeBrush}"/>
        </Style>
        <Style Selector="Ellipse.traffic-fullscreen">
            <Setter Property="Fill" Value="{DynamicResource WindowMaximizeBrush}"/>
        </Style>
        <Style Selector="Path.window-control-symbol">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Path.fullscreen-symbol">
            <Setter Property="Data" Value="{StaticResource TrafficLightEnterFullScreenGeometry}"/>
        </Style>
        <Style Selector="local|WindowTitleBar:fullscreen Path.fullscreen-symbol">
            <Setter Property="Data" Value="{StaticResource TrafficLightExitFullScreenGeometry}"/>
        </Style>
        <Style Selector="StackPanel.window-controls:pointerover Button.window-control:not(:disabled) Path.window-control-symbol,
                         Button.window-control:not(:disabled):focus-visible Path.window-control-symbol">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="local|WindowTitleBar:inactive StackPanel.window-controls:not(:pointerover) Ellipse.traffic-light,
                         Button.window-control:disabled Ellipse.traffic-light">
            <Setter Property="Fill" Value="{DynamicResource TrafficLightInactiveBrush}"/>
        </Style>
        <Style Selector="Button.window-control:pressed Ellipse.traffic-close">
            <Setter Property="Fill" Value="{DynamicResource TrafficLightClosePressedBrush}"/>
        </Style>
        <Style Selector="Button.window-control:pressed Ellipse.traffic-minimize">
            <Setter Property="Fill" Value="{DynamicResource TrafficLightMinimizePressedBrush}"/>
        </Style>
        <Style Selector="Button.window-control:pressed Ellipse.traffic-fullscreen">
            <Setter Property="Fill" Value="{DynamicResource TrafficLightFullScreenPressedBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid Height="44" Background="{DynamicResource TitleBarBackgroundBrush}">
        <ContentPresenter Content="{Binding #TitleBarRoot.TitleBarBackgroundContent}"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                          IsHitTestVisible="False"/>
        <Grid x:Name="TitleRow" Background="Transparent"
              chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <Border x:Name="WindowControlsReserve" Padding="14,0,12,0"
                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    chrome:WindowDecorationProperties.ElementRole="User">
                <StackPanel Classes="window-controls" Orientation="Horizontal" Spacing="0" Background="Transparent"
                            VerticalAlignment="Center"
                            chrome:WindowDecorationProperties.ElementRole="User">
                    <Button x:Name="CloseButton" Classes="window-control" ToolTip.Tip="关闭"
                            AutomationProperties.Name="关闭窗口">
                        <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                            <Grid Width="12" Height="12">
                                <Ellipse Classes="traffic-light traffic-close"/>
                                <Path Classes="window-control-symbol" Data="M3.75,3.75 L8.25,8.25 M8.25,3.75 L3.75,8.25"
                                      Stroke="{DynamicResource TrafficLightCloseSymbolBrush}"
                                      StrokeThickness="1.25" StrokeLineCap="Round"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="MinimizeButton" Classes="window-control" ToolTip.Tip="最小化"
                            AutomationProperties.Name="最小化窗口">
                        <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                            <Grid Width="12" Height="12">
                                <Ellipse Classes="traffic-light traffic-minimize"/>
                                <Path Classes="window-control-symbol" Data="M3,6 H9"
                                      Stroke="{DynamicResource TrafficLightMinimizeSymbolBrush}"
                                      StrokeThickness="1.25" StrokeLineCap="Round"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="FullScreenButton" Classes="window-control" ToolTip.Tip="进入全屏"
                            AutomationProperties.Name="进入全屏">
                        <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                            <Grid Width="12" Height="12">
                                <Ellipse Classes="traffic-light traffic-fullscreen"/>
                                <Path Classes="window-control-symbol fullscreen-symbol"
                                      Fill="{DynamicResource TrafficLightFullScreenSymbolBrush}"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TitleText" Text="{Binding Title, ElementName=TitleBarRoot}"
                       Margin="104,0"
                       HorizontalAlignment="Stretch" VerticalAlignment="Center"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                       FontSize="{DynamicResource FontSizeBody}" FontWeight="{StaticResource FontWeightSemibold}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       IsHitTestVisible="False"/>

            <Border x:Name="TitleBarContentRow"
                    Margin="104,0,8,0"
                    Background="Transparent" IsVisible="False" ClipToBounds="True"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar">
                <ContentPresenter Content="{Binding #TitleBarRoot.TitleBarContent}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  chrome:WindowDecorationProperties.ElementRole="TitleBar"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
