<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MacExplorer.Controls"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="MacExplorer.Controls.WindowTitleBar"
             x:Name="TitleBarRoot"
             MinHeight="44">
    <UserControl.Styles>
        <Style Selector="Button.window-control">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Padding" Value="3.25"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.window-control:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RenderTransform" Value="scale(1.04)"/>
        </Style>
        <Style Selector="Button.window-control:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)"/>
        </Style>
        <Style Selector="Button.window-control:disabled">
            <Setter Property="Opacity" Value="{DynamicResource InteractionDisabledOpacity}"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.window-control:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource InteractionSelectedBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="TextBlock.window-control-symbol">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeIconGlyph}"/>
            <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.08" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.window-controls:pointerover TextBlock.window-control-symbol">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="local|WindowTitleBar:inactive Ellipse.traffic-light">
            <Setter Property="Fill" Value="#A8A8A8"/>
        </Style>
    </UserControl.Styles>

    <Grid Height="44" Background="{DynamicResource TitleBarBackgroundBrush}">
        <Grid x:Name="TitleRow" Background="Transparent"
              chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <Border x:Name="WindowControlsReserve" Padding="14,0,12,0"
                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    chrome:WindowDecorationProperties.ElementRole="User">
                <StackPanel Classes="window-controls" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center"
                            chrome:WindowDecorationProperties.ElementRole="User">
                    <Button x:Name="CloseButton" Classes="window-control" ToolTip.Tip="关闭"
                            AutomationProperties.Name="关闭窗口">
                        <Grid Width="13.5" Height="13.5">
                            <Ellipse Classes="traffic-light" Fill="{DynamicResource WindowCloseBrush}"/>
                            <TextBlock Classes="window-control-symbol" Text="×" Foreground="#5C1A17" Margin="0,-1,0,0"/>
                        </Grid>
                    </Button>
                    <Button x:Name="MinimizeButton" Classes="window-control" ToolTip.Tip="最小化"
                            AutomationProperties.Name="最小化窗口">
                        <Grid Width="13.5" Height="13.5">
                            <Ellipse Classes="traffic-light" Fill="{DynamicResource WindowMinimizeBrush}"/>
                            <TextBlock Classes="window-control-symbol" Text="−" Foreground="#654200" Margin="0,-2,0,0"/>
                        </Grid>
                    </Button>
                    <Button x:Name="FullScreenButton" Classes="window-control" ToolTip.Tip="进入全屏"
                            AutomationProperties.Name="进入全屏">
                        <Grid Width="13.5" Height="13.5">
                            <Ellipse Classes="traffic-light" Fill="{DynamicResource WindowMaximizeBrush}"/>
                            <TextBlock Classes="window-control-symbol" Text="+" Foreground="#0C551C" Margin="0,-1,0,0"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TitleText" Text="{Binding Title, ElementName=TitleBarRoot}"
                       Margin="104,0"
                       HorizontalAlignment="Stretch" VerticalAlignment="Center"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                       FontSize="{DynamicResource FontSizeBody}" FontWeight="{StaticResource FontWeightSemibold}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       IsHitTestVisible="False"/>

            <Border x:Name="TitleBarContentRow"
                    Margin="104,0,8,0"
                    Background="Transparent" IsVisible="False" ClipToBounds="True"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar">
                <ContentPresenter Content="{Binding #TitleBarRoot.TitleBarContent}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  chrome:WindowDecorationProperties.ElementRole="TitleBar"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
