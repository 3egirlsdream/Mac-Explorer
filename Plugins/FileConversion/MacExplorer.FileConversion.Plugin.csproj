<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading><RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">osx-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SDK/MacExplorer.PluginSdk.csproj" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="Svg.Skia" Version="5.0.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4" />
    <EmbeddedResource Include="../../Resources/Conversion/*" LogicalName="MacExplorer.Resources.Conversion.%(Filename)%(Extension)" />
    <None Include="../../Assets/ConversionNotices.txt" Link="ConversionNotices.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="MacExplorer.Tests" />
  </ItemGroup>
  <Target Name="BuildConversionHelper" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <PropertyGroup>
      <_SwiftTarget Condition="'$(RuntimeIdentifier)' == 'osx-x64'">-target x86_64-apple-macosx15.0</_SwiftTarget>
    </PropertyGroup>
    <Exec Command="xcrun swiftc -O $(_SwiftTarget) '../../Platforms/MacOS/FileConversionHelper.swift' -framework AppKit -framework WebKit -framework ImageIO -framework UniformTypeIdentifiers -o '$(TargetDir)MacExplorer.FileConversion'" />
    <Exec Command="codesign --force --sign - '$(TargetDir)MacExplorer.FileConversion'" />
  </Target>
</Project>
