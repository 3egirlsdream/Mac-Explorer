<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../MacExplorer.csproj" />
  </ItemGroup>
  <Target Name="BundleBenchmark" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <PropertyGroup>
      <_BenchApp>$(TargetDir)FastListBench.app</_BenchApp>
    </PropertyGroup>
    <ItemGroup>
      <_BenchFiles Include="$(TargetDir)*" />
    </ItemGroup>
    <RemoveDir Directories="$(_BenchApp)" />
    <MakeDir Directories="$(_BenchApp)/Contents/MacOS" />
    <Copy SourceFiles="@(_BenchFiles)" DestinationFolder="$(_BenchApp)/Contents/MacOS" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Info.plist" DestinationFolder="$(_BenchApp)/Contents" />
    <Exec Command="codesign --force --deep --sign - &quot;$(_BenchApp)&quot;" />
  </Target>
</Project>
