<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>FastListBench</AssemblyName><RuntimeIdentifier>osx-arm64</RuntimeIdentifier><SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../../MacExplorer.csproj" /></ItemGroup>
  <Target Name="CopyNativeBridge" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <Copy SourceFiles="../../../bin/$(Configuration)/net10.0/osx-arm64/libMacExplorerNativeDrag.dylib" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>
