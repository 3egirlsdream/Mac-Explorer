<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier><SelfContained>true</SelfContained>
    <AssemblyName>FastListBench</AssemblyName><Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../MacExplorer.csproj" />
    <Compile Include="../../../Services/Impl/FrostedFolderRenderer.cs" Link="FrostedFolderRenderer.cs" />
    <Compile Include="../../../Services/Impl/SkeuomorphicFolderRenderer.cs" Link="SkeuomorphicFolderRenderer.cs" />
    <Compile Include="../../../Services/Impl/FrostedFolderEdge.cs" Link="FrostedFolderEdge.cs" />
    <Compile Include="../../../Services/Impl/FrostedFolderDepth.cs" Link="FrostedFolderDepth.cs" />
    <Compile Include="../FolderIconDemo/FolderCoverRenderService.cs" Link="FolderCoverRenderService.cs" />
    <Compile Include="../../../Services/Impl/FolderPhotoCoverService.cs" Link="FolderPhotoCoverService.cs" />
  </ItemGroup>
  <Target Name="BundleBenchmark" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <PropertyGroup><_App>$(TargetDir)FolderIconPerformance.app</_App></PropertyGroup>
    <Copy SourceFiles="../../../bin/$(Configuration)/net10.0/osx-arm64/libMacExplorerNativeDrag.dylib" DestinationFolder="$(TargetDir)" />
    <ItemGroup><_Files Include="$(TargetDir)*" /></ItemGroup>
    <MakeDir Directories="$(_App)/Contents/MacOS" />
    <Copy SourceFiles="@(_Files)" DestinationFolder="$(_App)/Contents/MacOS" />
    <Copy SourceFiles="Info.plist" DestinationFolder="$(_App)/Contents" />
    <Exec Command="codesign --force --deep --sign - &quot;$(_App)&quot;" />
  </Target>
</Project>
