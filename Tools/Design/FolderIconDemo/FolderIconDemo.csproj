<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../MacExplorer.csproj" />
    <Content Include="Assets/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BundleDemo" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <PropertyGroup><_DemoApp>$(TargetDir)Folder Icon Demo.app</_DemoApp></PropertyGroup>
    <ItemGroup>
      <_NativeFiles Include="../../../bin/$(Configuration)/net10.0/osx-arm64/libMacExplorer*.dylib" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeFiles)" DestinationFolder="$(TargetDir)" />
    <ItemGroup><_DemoFiles Include="$(TargetDir)*" /></ItemGroup>
    <MakeDir Directories="$(_DemoApp)/Contents/MacOS/Assets" />
    <Copy SourceFiles="@(_DemoFiles)" DestinationFolder="$(_DemoApp)/Contents/MacOS" />
    <Copy SourceFiles="@(Content)" DestinationFolder="$(_DemoApp)/Contents/MacOS/Assets" />
    <Copy SourceFiles="Info.plist" DestinationFolder="$(_DemoApp)/Contents" />
    <Exec Command="codesign --force --deep --sign - &quot;$(_DemoApp)&quot;" />
  </Target>
</Project>
