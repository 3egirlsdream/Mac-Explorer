<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:MacExplorer.Controls"
             xmlns:glass="clr-namespace:LiquidGlassAvaloniaUI;assembly=LiquidGlassAvaloniaUI"
             xmlns:loc="using:MacExplorer.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:MacExplorer.Models"
             xmlns:icons="using:MacExplorer.Assets"
             xmlns:converters="using:MacExplorer.Converters"
             x:Class="MacExplorer.Views.SuperPreviewView"
             Focusable="True"
             KeyDown="OnSuperPreviewKeyDown">
    <UserControl.Resources>
        <converters:FileEntryToIconConverter x:Key="FileIconConverter"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border.super-preview-shell">
            <Setter Property="Background" Value="{DynamicResource GlassMenuBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="{DynamicResource WindowShadow}"/>
        </Style>
        <Style Selector="ListBox.super-preview-items">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style Selector="ListBox.super-preview-items ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.super-preview-items ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        </Style>
        <Style Selector="ListBox.super-preview-items ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
        </Style>
    </UserControl.Styles>

    <Border x:Name="PreviewBackdrop" Background="{DynamicResource OverlayBrush}" Padding="18">
        <Border x:Name="Shell" Classes="super-preview-shell" CornerRadius="16" MaxWidth="1400" MaxHeight="900"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="False">
            <Border CornerRadius="{Binding CornerRadius, ElementName=Shell}" ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" x:Name="PreviewHeader" ColumnDefinitions="Auto,*,Auto" Margin="16,12,12,8">
                    <controls:AppButton AutomationProperties.Name="{loc:Loc ui.598}" Grid.Column="0" x:Name="BackButton" Classes="ghost icon-action" Click="GoBack" ToolTip.Tip="{loc:Loc ui.598}">
                        <PathIcon Data="{x:Static icons:Icons.Back}" Width="14" Height="14"/>
                    </controls:AppButton>
                    <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="{loc:Loc ui.599}" FontSize="{DynamicResource FontSizeTitle}"
                                   FontWeight="{StaticResource FontWeightSemibold}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BreadcrumbText" Text="" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <controls:AppButton AutomationProperties.Name="{loc:Loc ui.600}" Grid.Column="2" x:Name="ClosePreviewButton" Classes="ghost icon-action"
                            Click="ClosePreview" ToolTip.Tip="{loc:Loc ui.600}">
                        <PathIcon Data="{x:Static icons:Icons.Close}" Width="12" Height="12"/>
                    </controls:AppButton>
                </Grid>

                <Border Grid.Row="1" x:Name="HeaderDivider" Height="1" Background="{DynamicResource ColorDivider}"/>

                <Grid Grid.Row="2" x:Name="PreviewContentGrid" ColumnDefinitions="0,0,*">
                    <Border Grid.Column="0" x:Name="PreviewListCard" IsVisible="False" ClipToBounds="True">
                        <Grid>
                            <ScrollViewer x:Name="PreviewTreeScroll" HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <controls:FastFileList x:Name="PreviewTree"
                                    Background="{DynamicResource WorkspaceContentBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}" Secondary="{DynamicResource TextMutedBrush}"
                                    Hover="{DynamicResource InteractionHoverBrush}" Selected="{DynamicResource InteractionSelectedBrush}"
                                    SelectedHover="{DynamicResource InteractionSelectedHoverBrush}"
                                    FontFamily="{DynamicResource FontFamilyUi}" FontSize="{DynamicResource FontSizeBody}"
                                    FontWeight="{StaticResource FontWeightRegular}" DetailFontSize="{DynamicResource FontSizeLabel}"
                                    RowCornerRadius="{DynamicResource InteractionCornerRadius}"
                                    FocusRing="{DynamicResource FocusRingBrush}" SelectionOutline="{DynamicResource SelectionOutlineShadow}"
                                    FocusOutline="{DynamicResource FocusOutlineShadow}" AutomationProperties.Name="{loc:Loc ui.083}"
                                    PointerPressed="OnPreviewTreePressed"
                                    KeyDown="OnPreviewTreeKeyDown"/>
                            </ScrollViewer>
                            <ListBox x:Name="ItemsList" Classes="super-preview-items"
                                     IsVisible="False"
                                     SelectionMode="Single" SelectionChanged="OnItemSelectionChanged"
                                     DoubleTapped="OnItemDoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileSystemEntry">
                                        <Border Padding="9,7">
                                            <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="8">
                                                <Image Grid.Column="0" Width="26" Height="26" Stretch="Uniform"
                                                       Source="{Binding ., Converter={StaticResource FileIconConverter}, ConverterParameter=32}"
                                                       Loaded="OnPreviewEntryImageLoaded"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeLabel}"
                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                                    <TextBlock Text="{Binding FormattedSize}" FontSize="{DynamicResource FontSizeMeta}"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <PathIcon Grid.Column="2" x:Name="EntryChevron" Data="{x:Static icons:Icons.Forward}"
                                                          Width="10" Height="10" VerticalAlignment="Center"
                                                          IsVisible="{Binding IsDirectory}" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" x:Name="ContentDivider" IsVisible="False" Background="{DynamicResource ColorDivider}"/>
                    <Border Grid.Column="2" x:Name="PreviewCard" ClipToBounds="True" SizeChanged="OnPreviewCardSizeChanged">
                        <Grid>
                        <Grid x:Name="PreviewHost" ClipToBounds="True">
                            <TextBlock x:Name="PreviewPlaceholder" Text="{loc:Loc ui.603}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeBodyLarge}"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                            <Image x:Name="PreviewImage" IsVisible="False" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ScrollViewer x:Name="ZoomedImageScroll" IsVisible="False"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Image x:Name="ZoomedImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ScrollViewer>
                            <ScrollViewer x:Name="PreviewTextScroll" IsVisible="False"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="PreviewText" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="NoWrap" BorderThickness="0" Background="Transparent"
                                         FontFamily="{StaticResource FontFamilyMono}" FontSize="{DynamicResource FontSizeBody}"
                                         Padding="8" HorizontalContentAlignment="Left"
                                         VerticalContentAlignment="Top"/>
                            </ScrollViewer>
                            <StackPanel x:Name="FolderSummary" IsVisible="False" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Margin="12,0" Spacing="8">
                                <PathIcon x:Name="FolderSummaryIcon" Data="{x:Static icons:Icons.Folder}" Width="72" Height="72"
                                          Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="FolderSummaryTitle" FontSize="{DynamicResource FontSizeTitle}" FontWeight="{StaticResource FontWeightSemibold}"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="500"/>
                                <TextBlock x:Name="FolderSummaryDetails" FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="500"/>
                            </StackPanel>
                        </Grid>
                        <Border x:Name="PreviewPreviousSlot" Classes="preview-step-slot" HorizontalAlignment="Left"
                                Margin="12,0,0,0" IsVisible="False">
                            <Border x:Name="PreviewPreviousZone" Classes="preview-step-zone">
                                <controls:AppButton x:Name="PreviewPreviousButton" Classes="ghost preview-step-button"
                                        Click="OnPreviewStepClick" KeyDown="OnSuperPreviewKeyDown"
                                        AutomationProperties.Name="{loc:Loc preview.previous-file}" ToolTip.Tip="{loc:Loc preview.previous-file}">
                                    <Border Classes="preview-step-glass">
                                        <PathIcon Width="26" Height="26" FlowDirection="LeftToRight"
                                                  Data="{x:Static icons:Icons.ChevronRightGeometry}" RenderTransform="scale(-1,1)"/>
                                    </Border>
                                </controls:AppButton>
                            </Border>
                        </Border>
                        <Border x:Name="PreviewNextSlot" Classes="preview-step-slot" HorizontalAlignment="Right"
                                Margin="0,0,12,0" IsVisible="False">
                            <Border x:Name="PreviewNextZone" Classes="preview-step-zone">
                                <controls:AppButton x:Name="PreviewNextButton" Classes="ghost preview-step-button"
                                        Click="OnPreviewStepClick" KeyDown="OnSuperPreviewKeyDown"
                                        AutomationProperties.Name="{loc:Loc preview.next-file}" ToolTip.Tip="{loc:Loc preview.next-file}">
                                    <Border Classes="preview-step-glass">
                                        <PathIcon Width="26" Height="26" FlowDirection="LeftToRight"
                                                  Data="{x:Static icons:Icons.ChevronRightGeometry}"/>
                                    </Border>
                                </controls:AppButton>
                            </Border>
                        </Border>
                        <Popup x:Name="NativePreviewPreviousPopup" Placement="Center" PlacementTarget="PreviewPreviousSlot"
                               ShouldUseOverlayLayer="False" TakesFocusFromNativeControl="False" WindowManagerAddShadowHint="False">
                            <Border x:Name="NativePreviewPreviousSlot"/>
                        </Popup>
                        <Popup x:Name="NativePreviewNextPopup" Placement="Center" PlacementTarget="PreviewNextSlot"
                               ShouldUseOverlayLayer="False" TakesFocusFromNativeControl="False" WindowManagerAddShadowHint="False">
                            <Border x:Name="NativePreviewNextSlot"/>
                        </Popup>
                        <Border x:Name="PreviewToolbarSlot" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="12,0,12,12">
                            <Border x:Name="PreviewToolbar" IsVisible="False" Padding="4"
                                    CornerRadius="{DynamicResource RadiusFull}" controls:PopupGlass.IsEnabled="True"
                                    controls:PopupGlass.IsFloating="True"
                                    KeyDown="OnSuperPreviewKeyDown">
                                <StackPanel x:Name="PreviewToolbarButtons" Orientation="Horizontal" Spacing="2"/>
                            </Border>
                        </Border>
                        <Border x:Name="NativePreviewToolbarAnchor" VerticalAlignment="Bottom" Height="1" IsHitTestVisible="False"/>
                        <Popup x:Name="NativePreviewToolbarPopup" Placement="Top" PlacementTarget="NativePreviewToolbarAnchor"
                               ShouldUseOverlayLayer="False" TakesFocusFromNativeControl="False" WindowManagerAddShadowHint="False">
                            <Border x:Name="NativePreviewToolbarSlot" Padding="12"/>
                        </Popup>
                        </Grid>
                    </Border>
                    <Border x:Name="PreviewTreeResizeHandle" Grid.Column="0" IsVisible="False" ZIndex="1"
                            HorizontalAlignment="Right" Width="6" Background="Transparent" Cursor="SizeWestEast"
                            PointerPressed="OnPreviewResizePressed" PointerMoved="OnPreviewResizeMoved"
                            PointerReleased="OnPreviewResizeReleased" PointerCaptureLost="OnPreviewResizeCaptureLost"
                            glass:LiquidGlassBackdrop.IsExcludedFromCapture="True"/>
                </Grid>
            </Grid>
            </Border>
        </Border>
    </Border>
</UserControl>
