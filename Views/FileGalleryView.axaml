<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:MacExplorer.Controls"
             x:Class="MacExplorer.Views.FileGalleryView">
    <Grid RowDefinitions="*,Auto">
        <ContentControl x:Name="GalleryPreviewHost" Margin="12" HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"/>
        <StackPanel x:Name="GalleryPlaceholder" Margin="12" Spacing="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Viewbox Width="144" Height="144" Stretch="Uniform">
                <ContentControl x:Name="GalleryPlaceholderImage"/>
            </Viewbox>
            <TextBlock x:Name="GalleryPlaceholderName" FontSize="{DynamicResource FontSizeTitle}"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
            <TextBlock x:Name="GalleryPlaceholderKind" FontSize="{DynamicResource FontSizeLabel}"
                       Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
        </StackPanel>
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WorkspaceDividerBrush}">
            <ListBox x:Name="GalleryStrip" Classes="gallery-strip" Height="96" SelectionMode="Single" Focusable="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="{loc:Loc file_gallery.filmstrip}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
