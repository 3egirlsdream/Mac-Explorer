<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:MacExplorer.Assets">
    <Styles.Resources>
        <ControlTheme x:Key="SettingsNavigationItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusAdorner" Value="{StaticResource KeyboardFocusAdorner}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="NavigationSurface" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style Selector="^:selected:pointerover">
                <Setter Property="Background" Value="{DynamicResource InteractionSelectedHoverBrush}"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="{DynamicResource InteractionDisabledOpacity}"/>
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="TabControl.settings-shell">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="196,*">
                    <Border Background="{DynamicResource SurfaceMutedBrush}"
                            BorderBrush="{DynamicResource ColorBorderSubtle}" BorderThickness="0,0,1,0">
                        <DockPanel Margin="16,24,16,20">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="36,*" ColumnSpacing="10" Margin="8,0,0,24">
                                <Image Source="/Assets/appicon.ico" Width="36" Height="36"/>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="设置" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="MacExplorer" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel DockPanel.Dock="Bottom" Margin="12,20,0,0" Spacing="8">
                                <Border Height="1" Background="{DynamicResource ColorBorderSubtle}" Margin="0,0,12,4"/>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{x:Static icons:Icons.Checkmark}" Width="12" Height="12"
                                              Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="更改自动保存" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBackgroundBrush}">
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabControl.settings-shell > TabItem">
        <Setter Property="Theme" Value="{StaticResource SettingsNavigationItem}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="TabControl.settings-shell > TabItem:selected">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
    </Style>
    <Style Selector="TabControl.settings-shell > TabItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedHoverBrush}"/>
    </Style>
    <Style Selector="PathIcon.settings-nav-icon">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TabItem:selected PathIcon.settings-nav-icon">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="StackPanel.settings-page, Grid.settings-page">
        <Setter Property="MaxWidth" Value="760"/>
        <Setter Property="Margin" Value="32,28,32,32"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="StackPanel.settings-page">
        <Setter Property="Spacing" Value="24"/>
    </Style>
    <Style Selector="StackPanel.settings-header">
        <Setter Property="Spacing" Value="6"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style Selector="Border.settings-compact-row TextBlock.settings-label">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="PathIcon.settings-row-icon">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="ToggleSwitch.settings-toggle">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusAdorner" Value="{StaticResource KeyboardFocusAdorner}"/>
    </Style>
    <Style Selector="ToggleSwitch.settings-toggle /template/ Border#OuterBorder,
                     ToggleSwitch.settings-toggle /template/ Border#SwitchKnobBounds">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="ToggleSwitch.settings-toggle /template/ Canvas#PART_SwitchKnob">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="ToggleSwitch.settings-toggle /template/ Grid#PART_MovingKnobs">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="ToggleSwitch.settings-toggle:unchecked /template/ Border#OuterBorder">
        <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ToggleSwitch.settings-toggle:unchecked /template/ Ellipse#SwitchKnobOff">
        <Setter Property="Fill" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="ToggleSwitch.settings-toggle /template/ Ellipse#SwitchKnobOn,
                     ToggleSwitch.settings-toggle /template/ Ellipse#SwitchKnobOff">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.interaction-token-row">
        <Setter Property="MinHeight" Value="62"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderSubtle}"/>
    </Style>
    <Style Selector="TextBlock.settings-title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style Selector="TextBlock.settings-section-title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="4,0,0,2"/>
    </Style>

    <Style Selector="Border.settings-group">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style Selector="Border.settings-row">
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="MinHeight" Value="{DynamicResource TypographySettingsRowMinHeight}"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="Border.settings-row.settings-divider">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style Selector="Border.settings-compact-row">
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="MinHeight" Value="{DynamicResource TypographySettingsCompactRowMinHeight}"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="Border.settings-compact-row.settings-divider">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style Selector="TextBlock.settings-label">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="TextBlock.settings-description">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style Selector="Border.settings-note">
        <Setter Property="Background" Value="{DynamicResource ColorBgHover}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style Selector="Border.settings-about-card">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="28"/>
    </Style>

    <Style Selector="ToggleSwitch.settings-toggle">
        <Setter Property="OnContent" Value=""/>
        <Setter Property="OffContent" Value=""/>
        <Setter Property="MinWidth" Value="38"/>
    </Style>

    <Style Selector="Button.openwith-delete">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
    </Style>

    <Style Selector="Button.openwith-delete:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <Style Selector="Button.interaction-token-row">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="Button.interaction-token-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>

    <Style Selector="Button.interaction-token-row.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.interaction-palette-swatch">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="15"/>
    </Style>

    <Style Selector="Button.interaction-palette-swatch:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource InteractionSelectedBrush}"/>
    </Style>

    <Style Selector="ListBox.settings-locations">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="ListBox.settings-locations ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ListBox.settings-locations ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>

    <Style Selector="Button.settings-location-action">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="7"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.settings-location-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.settings-location-action PathIcon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>

</Styles>
