<controls:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:MacExplorer.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MacExplorer.Controls"
        x:Class="MacExplorer.Views.Dialogs.LocalSendPinDialog"
        Title="{loc:Loc ui.500}"
        Width="360" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <StyleInclude Source="avares://MacExplorer/Views/Dialogs/SettingsStyles.axaml"/>
    </Window.Styles>
    <controls:DialogWindow.TitleBarContent>
        <TextBlock Classes="dialog-window-title centered" Text="{loc:Loc ui.500}"/>
    </controls:DialogWindow.TitleBarContent>
    <Grid RowDefinitions="Auto,Auto" RowSpacing="12" Margin="16,12,16,16">
        <Border Classes="settings-group">
            <Border Classes="settings-compact-row">
                <TextBox x:Name="PinBox" Classes="settings-inline-input" PlaceholderText="{loc:Loc ui.501}"
                         AutomationProperties.Name="{loc:Loc ui.500}" MaxLength="12" Height="30"/>
            </Border>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <controls:AppButton Classes="secondary compact" Content="{loc:Loc ui.094}" IsCancel="True" Click="OnCancel"/>
            <controls:AppButton Classes="primary compact" Content="{loc:Loc ui.502}" IsDefault="True" Click="OnContinue"/>
        </StackPanel>
    </Grid>
</controls:DialogWindow>
