<controls:DialogWindow xmlns="https://github.com/avaloniaui" xmlns:loc="using:MacExplorer.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="using:MacExplorer.Controls" xmlns:icons="using:MacExplorer.Assets"
                       x:Class="MacExplorer.Views.Dialogs.HomeScriptCommandsDialog"
                       Width="620" Height="400" MinWidth="460" MinHeight="300" CanResize="True" Title="{loc:Loc ui.492}">
    <Window.Styles>
        <StyleInclude Source="avares://MacExplorer/Views/Dialogs/SettingsStyles.axaml"/>
    </Window.Styles>
    <controls:DialogWindow.TitleBarContent>
        <TextBlock Classes="dialog-window-title centered"
                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=controls:DialogWindow}}"/>
    </controls:DialogWindow.TitleBarContent>
    <Grid RowDefinitions="*,Auto,Auto" Margin="16,12,16,16">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="CommandRows" Spacing="10" Margin="0,0,8,0"/>
        </ScrollViewer>
        <TextBlock Grid.Row="1" x:Name="ErrorText" IsVisible="False" TextWrapping="Wrap"
                   Margin="0,8,0,0" Foreground="{DynamicResource DangerBrush}"/>
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,14,0,0">
            <controls:AppButton x:Name="AddButton" DockPanel.Dock="Left" Classes="ghost compact" Click="OnAdd">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{x:Static icons:Icons.Plus}" Width="12" Height="12"/>
                    <TextBlock Text="{loc:Loc ui.493}" VerticalAlignment="Center"/>
                </StackPanel>
            </controls:AppButton>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <controls:AppButton Content="{loc:Loc ui.094}" Classes="secondary compact" Click="OnCancel"/>
                <controls:AppButton Content="{loc:Loc ui.095}" Classes="primary compact" Click="OnSave"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:DialogWindow>
