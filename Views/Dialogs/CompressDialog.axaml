<controls:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:MacExplorer.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MacExplorer.Controls"
        xmlns:icons="clr-namespace:MacExplorer.Assets"
        x:Class="MacExplorer.Views.Dialogs.CompressDialog"
        Title="{loc:Loc ui.483}" Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="Transparent"/>
    </Window.Resources>
    <Window.Styles>
        <StyleInclude Source="avares://MacExplorer/Views/Dialogs/SettingsStyles.axaml"/>
        <Style Selector=":is(controls|AppWindow) /template/ Border#WindowFrame">
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto" RowSpacing="12" Margin="16,6,16,16">
        <Border Classes="settings-group">
            <StackPanel>
                <Border Classes="settings-compact-row settings-divider">
                    <Grid ColumnDefinitions="80,*" ColumnSpacing="8">
                        <TextBlock Classes="settings-label" Text="{loc:Loc ui.010}"/>
                        <TextBox Grid.Column="1" x:Name="ArchiveNameBox"
                                 Classes="settings-inline-input" Text="Archive.zip"
                                 AutomationProperties.Name="{loc:Loc ui.484}"/>
                    </Grid>
                </Border>

                <Border Classes="settings-compact-row settings-divider">
                    <Grid ColumnDefinitions="80,*" ColumnSpacing="8">
                        <TextBlock Classes="settings-label" Text="{loc:Loc ui.485}"/>
                        <Border Grid.Column="1" Classes="segmented-control">
                            <Grid ColumnDefinitions="*,*,*">
                                <Button x:Name="BtnZip" Classes="segment-btn"
                                        Click="OnFormatChanged" Tag="Zip">ZIP</Button>
                                <Button Grid.Column="1" x:Name="BtnTarGz" Classes="segment-btn"
                                        Click="OnFormatChanged" Tag="TarGz">tar.gz</Button>
                                <Button Grid.Column="2" x:Name="BtnTarBz2" Classes="segment-btn"
                                        Click="OnFormatChanged" Tag="TarBz2">tar.bz2</Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Classes="settings-compact-row settings-divider">
                    <Grid ColumnDefinitions="80,*" ColumnSpacing="8">
                        <TextBlock Classes="settings-label" Text="{loc:Loc ui.486}"/>
                        <Border Grid.Column="1" Classes="segmented-control">
                            <Grid ColumnDefinitions="*,*,*">
                                <Button x:Name="BtnFast" Classes="segment-btn"
                                        Click="OnLevelChanged" Tag="Fast" Content="{loc:Loc ui.658}"></Button>
                                <Button Grid.Column="1" x:Name="BtnStandard" Classes="segment-btn"
                                        Click="OnLevelChanged" Tag="Standard" Content="{loc:Loc ui.659}"></Button>
                                <Button Grid.Column="2" x:Name="BtnMaximum" Classes="segment-btn"
                                        Click="OnLevelChanged" Tag="Maximum" Content="{loc:Loc ui.660}"></Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="PasswordSection" Classes="settings-compact-row"
                        ToolTip.Tip="{loc:Loc ui.487}">
                    <Grid ColumnDefinitions="80,*" ColumnSpacing="8">
                        <TextBlock Classes="settings-label" Text="{loc:Loc ui.488}"/>
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <TextBox x:Name="PasswordBox" Classes="settings-inline-input"
                                     PasswordChar="●" PlaceholderText="{loc:Loc ui.489}"
                                     AutomationProperties.Name="{loc:Loc ui.490}"/>
                            <Button Grid.Column="1" x:Name="TogglePasswordBtn"
                                    Width="28" Height="28" Padding="0"
                                    Classes="secondary compact"
                                    ToolTip.Tip="{loc:Loc ui.491}"
                                    AutomationProperties.Name="{loc:Loc ui.491}"
                                    Click="TogglePasswordVisibility">
                                <PathIcon Data="{x:Static icons:Icons.Eye}" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:Loc ui.094}" Width="72" Height="30" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Classes="secondary compact"
                    Click="CancelClick"/>
            <Button Content="{loc:Loc ui.354}" Width="72" Height="30" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Classes="primary compact"
                    x:Name="ConfirmBtn" IsDefault="True"
                    Click="ConfirmClick"/>
        </StackPanel>
    </Grid>
</controls:DialogWindow>
