<controls:ToolWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:MacExplorer.Controls"
        xmlns:controls="using:MacExplorer.Controls"
        x:Class="MacExplorer.Views.Dialogs.TaskPanel"
        ExtendContentToTop="True" Title="{loc:Loc tasks.transfers}"
        Width="560" Height="360" MinWidth="320" MinHeight="220"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="CancelAllTasksMenuItem" Header="{loc:Loc tasks.literal.010}" Click="ClearAllTasks"/>
                <MenuItem x:Name="ClearFinishedTasksMenuItem" Header="{loc:Loc ui.069}" Click="ClearCompleted"/>
            </ContextMenu>
        </Grid.ContextMenu>
        <TextBlock x:Name="TaskRunningCountText" Margin="16,4,16,8" Grid.Row="0" Classes="task-meta"/>
        <ScrollViewer x:Name="TaskListScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TaskItemsPanel"/>
        </ScrollViewer>
    </Grid>
</controls:ToolWindow>
