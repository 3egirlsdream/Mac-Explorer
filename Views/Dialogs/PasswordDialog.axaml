<controls:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:MacExplorer.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MacExplorer.Controls"
        xmlns:icons="clr-namespace:MacExplorer.Assets"
        x:Class="MacExplorer.Views.Dialogs.PasswordDialog"
        Title="{loc:Loc ui.507}"
        Width="420"
        MinHeight="260"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GlassEffectBg}">

    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="20" Margin="24">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="40" Height="40" CornerRadius="10"
                    Background="{DynamicResource ColorBgHover}"
                    VerticalAlignment="Top">
                <PathIcon Data="{x:Static icons:Icons.PasswordHidden}"
                          Width="20" Height="20"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="DialogTitle"
                           Text="{loc:Loc ui.508}"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="{StaticResource FontWeightSemibold}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{loc:Loc ui.509}"
                           FontSize="{DynamicResource FontSizeBody}"
                           LineHeight="{DynamicResource LineHeightLabel}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="{loc:Loc ui.510}"
                       FontSize="{DynamicResource FontSizeLabel}"
                       FontWeight="{StaticResource FontWeightMedium}"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="PasswordBox" Grid.Column="0"
                         Height="38"
                         PasswordChar="●"
                         PlaceholderText="{loc:Loc ui.511}"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" x:Name="ToggleVisibilityBtn"
                        Width="38" Height="38"
                        Classes="secondary"
                        VerticalAlignment="Center"
                        Click="TogglePasswordVisibility">
                    <PathIcon Data="{x:Static icons:Icons.Eye}" Width="16" Height="16"/>
                </Button>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:Loc ui.094}" Width="80" Classes="secondary"
                    IsCancel="True"
                    Click="CancelClick"/>
            <Button Content="{loc:Loc ui.323}" Width="80" Classes="primary"
                    IsDefault="True"
                    Click="ConfirmClick"/>
        </StackPanel>
    </Grid>
</controls:DialogWindow>
