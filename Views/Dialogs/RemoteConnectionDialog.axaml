<controls:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:MacExplorer.Assets"
        xmlns:controls="using:MacExplorer.Controls"
        x:Class="MacExplorer.Views.Dialogs.RemoteConnectionDialog"
        Title="连接远程服务器"
        Width="480" Height="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GlassEffectBg}">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
            <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Saved servers list -->
        <Border Grid.Row="0" IsVisible="{Binding HasSavedServers}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="已保存的服务器" FontSize="{DynamicResource FontSizeCaption}" FontWeight="{StaticResource FontWeightSemibold}"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                <ListBox x:Name="SavedServersList" MaxHeight="120"
                         ItemsSource="{Binding SavedServers}"
                         SelectionChanged="OnSavedServerSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,2">
                                <PathIcon Data="{x:Static icons:Icons.ExternalDrive}"
                                          Width="16" Height="16" Foreground="{DynamicResource AccentBrush}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource FontSizeBody}"/>
                                    <TextBlock Text="{Binding ConnectionString}" FontSize="{DynamicResource FontSizeMeta}" Opacity="0.6"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Connection form -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="服务器名称"/>
                <TextBox x:Name="NameBox" PlaceholderText="可选，显示在侧边栏"/>

                <TextBlock Classes="label" Text="主机地址"/>
                <TextBox x:Name="HostBox" PlaceholderText="IP 地址或域名" AutomationProperties.Name="主机地址"/>
                <TextBlock x:Name="HostError" IsVisible="False" Text="请输入主机地址" FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8"/>

                <TextBlock Classes="label" Text="端口"/>
                <TextBox x:Name="PortBox" PlaceholderText="22"/>

                <TextBlock Classes="label" Text="用户名"/>
                <TextBox x:Name="UsernameBox" PlaceholderText="root"/>

                <TextBlock Classes="label" Text="认证方式"/>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                    <RadioButton x:Name="PasswordRadio" Content="密码" IsChecked="True"
                                 GroupName="Auth" Click="OnAuthMethodChanged"/>
                    <RadioButton x:Name="KeyRadio" Content="密钥文件"
                                 GroupName="Auth" Click="OnAuthMethodChanged"/>
                </StackPanel>

                <StackPanel x:Name="PasswordPanel">
                    <TextBlock Classes="label" Text="密码"/>
                    <TextBox x:Name="PasswordBox" PlaceholderText="密码" PasswordChar="•"/>
                </StackPanel>

                <StackPanel x:Name="KeyPanel" IsVisible="False">
                    <TextBlock Classes="label" Text="私钥文件路径"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="KeyPathBox" PlaceholderText="~/.ssh/id_rsa"/>
                        <Button Grid.Column="1" Content="浏览" Click="OnBrowseKeyFile"
                                Padding="12,6" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                    </Grid>
                </StackPanel>

                <TextBlock Classes="label" Text="默认路径"/>
                <TextBox x:Name="DefaultPathBox" PlaceholderText="/" Text="/"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,16,0,0">
            <Button x:Name="DeleteButton" Content="删除" Classes="ghost" Foreground="{DynamicResource DangerBrush}"
                    Click="OnDeleteServer" IsVisible="False" Padding="16,6"/>
            <Button Grid.Column="2" Content="取消" Classes="secondary" Click="OnCancel" Padding="16,6"/>
            <Button Grid.Column="3" x:Name="SaveButton" Content="保存" Classes="secondary" Click="OnSave" Padding="16,6"/>
            <Button Grid.Column="4" x:Name="ConnectButton" Content="连接" Classes="primary" Click="OnConnect" Padding="24,6"/>
        </Grid>
    </Grid>
</controls:DialogWindow>
