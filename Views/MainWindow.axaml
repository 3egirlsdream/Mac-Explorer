<controls:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MacExplorer.ViewModels"
        xmlns:icons="using:MacExplorer.Assets"
        xmlns:models="using:MacExplorer.Models"
        xmlns:local="using:MacExplorer.Views"
        xmlns:controls="using:MacExplorer.Controls"
        xmlns:glass="clr-namespace:LiquidGlassAvaloniaUI;assembly=LiquidGlassAvaloniaUI"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="MacExplorer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel" x:CompileBindings="False"
        Title="{Binding FileList.CurrentLocationTitle, FallbackValue='Mac Explorer'}"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="680">

    <controls:AppWindow.Styles>
        <Style Selector="Button.title-nav-button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Padding="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="QuadraticEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.title-nav-button PathIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>
        <Style Selector="Button.title-nav-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        </Style>
        <Style Selector="Button.title-nav-button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.94)"/>
        </Style>

        <Style Selector="Button.title-nav-button:disabled">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="{DynamicResource InteractionDisabledOpacity}"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="ListBox.tab-strip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.tab-strip ListBoxItem">
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="MaxWidth" Value="260"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <!-- Chromium overlaps adjacent tab slots so the active tab's
                 extension feet cover the neighboring separator cleanly. -->
            <Setter Property="Margin" Value="0,0,-6,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="ZIndex" Value="0"/>
        </Style>
        <Style Selector="ListBox.tab-strip ListBoxItem:last-child">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="ListBox.tab-strip ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Border.tab-hover-surface">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.browser-tab-divider">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.tab-strip ListBoxItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="ZIndex" Value="2"/>
        </Style>
        <Style Selector="ListBox.tab-strip ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.tab-strip ListBoxItem:pointerover Border.tab-hover-surface">
            <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        </Style>
        <Style Selector="ListBox.tab-strip ListBoxItem:pointerover Border.browser-tab-divider">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="ListBox.tab-strip ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="ZIndex" Value="3"/>
        </Style>
        <Style Selector="ListBox.tab-strip ListBoxItem:selected /template/ ContentPresenter,
                         ListBox.tab-strip ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.tab-strip ListBoxItem:selected Border.tab-hover-surface">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ListBox.tab-strip ListBoxItem:selected Border.browser-tab-divider,
                         ListBox.tab-strip ListBoxItem:selected:pointerover Border.browser-tab-divider">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="ListBox.tab-strip ListBoxItem:selected:pointerover">
            <Setter Property="ZIndex" Value="3"/>
        </Style>
        <Style Selector="Button.tab-close-button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Padding="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tab-close-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        </Style>
        <Style Selector="Button.layout-choice">
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.layout-choice controls|PaneLayoutIcon">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{DynamicResource PanePreviewFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanePreviewBorderBrush}"/>
        </Style>
        <Style Selector="Button.layout-choice TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.layout-choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        </Style>
        <Style Selector="Button.layout-choice.selected">
            <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.layout-choice.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InteractionSelectedHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.layout-choice.selected controls|PaneLayoutIcon">
            <Setter Property="Foreground" Value="{DynamicResource PanePreviewSelectedFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanePreviewSelectedBorderBrush}"/>
        </Style>
        <Style Selector="Button.layout-choice.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.global-search-panel">
            <Setter Property="Background" Value="{DynamicResource GlassMenuBg}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource WindowShadow}"/>
        </Style>
        <Style Selector="ListBox.global-search-results">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.global-search-results ListBoxItem">
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.global-search-results ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        </Style>
        <Style Selector="ListBox.global-search-results ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
        </Style>
        <Style Selector="Border#RootLayout">
            <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
        </Style>
        <Style Selector="controls|ChromiumTabStripSurface">
            <Setter Property="Fill" Value="{DynamicResource SurfaceBrush}"/>
        </Style>
    </controls:AppWindow.Styles>

    <controls:AppWindow.TitleBarBackgroundContent>
        <Grid>
            <controls:ChromiumTabStripSurface x:Name="TabSurface"/>
        </Grid>
    </controls:AppWindow.TitleBarBackgroundContent>

    <controls:AppWindow.TitleBarContent>
        <!-- Browser-style tabs share the native traffic-light row. -->
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto"
              chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <Border x:Name="TitleBarDragArea" Grid.ColumnSpan="5" Background="Transparent"
                    PointerPressed="OnTitleBarBlankPointerPressed"/>
            <Grid Grid.Column="0" ColumnDefinitions="*,Auto" HorizontalAlignment="Left" Margin="0,4,0,0">
                    <ScrollViewer Grid.Column="0" x:Name="TabScrollViewer"
                                  chrome:WindowDecorationProperties.ElementRole="User"
                                  HorizontalAlignment="Left" MaxWidth="840"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <ListBox x:Name="TabList"
                                 Classes="tab-strip"
                                 DragDrop.AllowDrop="True"
                                 DragDrop.DragOver="OnTabFileDragOver"
                                 DragDrop.Drop="OnTabFileDrop"
                                 ItemsSource="{Binding Tabs}"
                                 SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                 SelectionMode="Single">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExplorerTabViewModel">
                                    <Grid ClipToBounds="False">
                                        <Border Classes="tab-hover-surface" Margin="16,4,16,5"
                                                CornerRadius="10" IsHitTestVisible="False"/>
                                        <Border Classes="browser-tab-divider"
                                                Width="1" Height="20" Margin="0,0,0,4"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="{DynamicResource ColorBorderSubtle}"
                                                IsHitTestVisible="False"/>
                                        <!-- Account for the 16-DIP contour inset, close-button padding,
                                             and 2-DIP content join when balancing the visible spacing. -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7"
                                              Margin="28,0,22,2">
                                            <PathIcon Grid.Column="0" Data="{Binding FileList.CurrentLocationIcon}"
                                                      Width="14" Height="14"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding Title}"/>
                                            <Button Grid.Column="2" Classes="tab-close-button"
                                                    IsVisible="{Binding CanClose}"
                                                    Click="CloseTab"
                                                    ToolTip.Tip="关闭标签页 ⌘W"
                                                    AutomationProperties.Name="关闭标签页">
                                                <PathIcon Data="{x:Static icons:Icons.Close}" Width="9" Height="9"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                    <Button Grid.Column="1" x:Name="NewTabButton" Classes="title-nav-button"
                            Width="28" Height="28"
                            Click="AddTab"
                            ToolTip.Tip="新建标签页 ⌘T"
                            AutomationProperties.Name="新建标签页">
                        <PathIcon Data="{x:Static icons:Icons.Plus}" Width="13" Height="13"/>
                    </Button>
            </Grid>
                    <Button Grid.Column="1" x:Name="PaneLayoutButton" Classes="title-nav-button"
                            Margin="2,4,0,0"
                            Click="TogglePaneLayoutPopup"
                            ToolTip.Tip="窗格布局"
                            AutomationProperties.Name="窗格布局">
                        <PathIcon Data="{x:Static icons:Icons.SplitVertical}"/>
                    </Button>
                    <Popup x:Name="PaneLayoutPopup" Placement="BottomEdgeAlignedRight"
                           PlacementTarget="PaneLayoutButton" IsLightDismissEnabled="False"
                           ShouldUseOverlayLayer="True"
                           WindowManagerAddShadowHint="False">
                        <Border Classes="toolbar-popup" Padding="10" CornerRadius="12">
                            <Grid RowDefinitions="Auto,*" Width="320"
                                  KeyboardNavigation.TabNavigation="Cycle">
                                <TextBlock Grid.Row="0" Text="窗格布局" Margin="5,2,0,8"
                                           FontSize="12" FontWeight="{StaticResource FontWeightSemibold}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <UniformGrid Grid.Row="1" Columns="4" Rows="3">
                                    <Button Classes="layout-choice" Tag="Single" Click="ChoosePaneLayout" ToolTip.Tip="单窗格" AutomationProperties.Name="单窗格">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <controls:PaneLayoutIcon Layout="Single"/>
                                            <TextBlock Text="单窗格" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="layout-choice" Tag="TwoColumns" Click="ChoosePaneLayout" ToolTip.Tip="左右双窗格" AutomationProperties.Name="左右双窗格">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <controls:PaneLayoutIcon Layout="TwoColumns"/>
                                            <TextBlock Text="左右双窗格" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="layout-choice" Tag="TwoRows" Click="ChoosePaneLayout" ToolTip.Tip="上下双窗格" AutomationProperties.Name="上下双窗格">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <controls:PaneLayoutIcon Layout="TwoRows"/>
                                            <TextBlock Text="上下双窗格" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="layout-choice" Tag="ThreeColumns" Click="ChoosePaneLayout" ToolTip.Tip="三列" AutomationProperties.Name="三列">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <controls:PaneLayoutIcon Layout="ThreeColumns"/>
                                            <TextBlock Text="三列" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="layout-choice" Tag="ThreeRows" Click="ChoosePaneLayout" ToolTip.Tip="三行" AutomationProperties.Name="三行">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <controls:PaneLayoutIcon Layout="ThreeRows"/>
                                            <TextBlock Text="三行" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="layout-choice" Tag="MainLeftTwoRowsRight" Click="ChoosePaneLayout" ToolTip.Tip="左一右二" AutomationProperties.Name="左一右二">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <controls:PaneLayoutIcon Layout="MainLeftTwoRowsRight"/>
                                            <TextBlock Text="左一右二" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="layout-choice" Tag="MainRightTwoRowsLeft" Click="ChoosePaneLayout" ToolTip.Tip="左二右一" AutomationProperties.Name="左二右一">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <controls:PaneLayoutIcon Layout="MainRightTwoRowsLeft"/>
                                            <TextBlock Text="左二右一" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="layout-choice" Tag="FourGrid" Click="ChoosePaneLayout" ToolTip.Tip="四宫格" AutomationProperties.Name="四宫格">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <controls:PaneLayoutIcon Layout="FourGrid"/>
                                            <TextBlock Text="四宫格" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="layout-choice" Tag="FourColumns" Click="ChoosePaneLayout" ToolTip.Tip="四列" AutomationProperties.Name="四列">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <controls:PaneLayoutIcon Layout="FourColumns"/>
                                            <TextBlock Text="四列" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="layout-choice" Tag="FourRows" Click="ChoosePaneLayout" ToolTip.Tip="四行" AutomationProperties.Name="四行">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <controls:PaneLayoutIcon Layout="FourRows"/>
                                            <TextBlock Text="四行" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="layout-choice" Tag="MainLeftThreeRowsRight" Click="ChoosePaneLayout" ToolTip.Tip="左一右三" AutomationProperties.Name="左一右三">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <controls:PaneLayoutIcon Layout="MainLeftThreeRowsRight"/>
                                            <TextBlock Text="左一右三" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="layout-choice" Tag="MainRightThreeRowsLeft" Click="ChoosePaneLayout" ToolTip.Tip="左三右一" AutomationProperties.Name="左三右一">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <controls:PaneLayoutIcon Layout="MainRightThreeRowsLeft"/>
                                            <TextBlock Text="左三右一" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </Popup>
                    <Button Grid.Column="2" x:Name="TaskButton" IsVisible="False"
                            Classes="title-nav-button" Margin="2,4,0,0"
                            Click="ToggleTaskPanel" ToolTip.Tip="后台任务"
                            AutomationProperties.Name="后台任务">
                        <Grid>
                            <PathIcon Data="{x:Static icons:Icons.Refresh}"/>
                            <TextBlock x:Name="TaskButtonText" IsVisible="False"/>
                        </Grid>
                    </Button>
                    <Button Grid.Column="3" x:Name="CopilotStatusButton" Classes="title-nav-button"
                            Margin="2,4,0,0" Click="ToggleCopilot"
                            ToolTip.Tip="Copilot" AutomationProperties.Name="打开 Copilot">
                        <PathIcon Data="{x:Static icons:Icons.Copilot}"/>
                    </Button>
                    <Button Grid.Column="4" x:Name="WindowSettingsButton" Classes="title-nav-button"
                            Margin="2,4,0,0" Click="OpenSettingsFromTitleBar"
                            ToolTip.Tip="设置" AutomationProperties.Name="设置">
                        <PathIcon Data="{x:Static icons:Icons.Settings}"/>
                    </Button>
        </Grid>
    </controls:AppWindow.TitleBarContent>

    <Grid>
    <Border x:Name="RootLayout" CornerRadius="0">
        <Grid>
            <!-- Match the tab and toolbar through the top inset, including translucent themes.
                 Paint this band once so stacked translucent fills cannot create a dark seam. -->
            <Border x:Name="TabContentJoin" Height="8" VerticalAlignment="Top"
                    Background="{DynamicResource SurfaceBrush}" IsHitTestVisible="False"/>
            <Grid Margin="8">
                <Grid x:Name="PaneLayoutRoot"/>
            </Grid>
        </Grid>
    </Border>
    <Grid x:Name="HomeFolderOverlayHost" IsVisible="False" Background="Transparent"
          glass:LiquidGlassBackdrop.IsExcludedFromCapture="True"/>
    <Border x:Name="CopilotPanel" IsVisible="False"
            glass:LiquidGlassBackdrop.IsExcludedFromCapture="True"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Width="440" Height="570" MaxHeight="650" Margin="0,0,12,46"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource ColorBorderSubtle}" BorderThickness="1"
            CornerRadius="{DynamicResource RadiusLg}" BoxShadow="{DynamicResource WindowShadow}">
        <Grid ColumnDefinitions="Auto,*">
          <Border x:Name="CopilotHistoryPane" IsVisible="False" Grid.Column="0"
                  Width="224" Background="{DynamicResource SurfaceMutedBrush}"
                  BorderBrush="{DynamicResource ColorBorderSubtle}" BorderThickness="0,0,1,0"
                  CornerRadius="{DynamicResource RadiusLg}" Padding="12,14,10,12">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Text="历史会话" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,12"/>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CopilotHistoryList" Spacing="3"/>
              </ScrollViewer>
            </Grid>
          </Border>
          <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="14,12,14,14">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="2,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <PathIcon Data="{x:Static icons:Icons.Copilot}" Width="17" Height="17"
                              Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Copilot" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="CopilotHistoryToggle" Grid.Column="1" Classes="ghost compact copilot-history-toggle"
                        Click="ToggleCopilotHistory" ToolTip.Tip="历史会话"
                        AutomationProperties.Name="展开历史会话">
                    <PathIcon Data="{x:Static icons:Icons.ListTree}" Width="16" Height="16"/>
                </Button>
                <Button Grid.Column="2" Classes="ghost compact" Content="新对话"
                        Click="NewCopilotSession" AutomationProperties.Name="新建 Copilot 对话"/>
                <Button Grid.Column="3" Classes="ghost compact copilot-close"
                        Click="ToggleCopilot" ToolTip.Tip="关闭 Copilot"
                        AutomationProperties.Name="关闭 Copilot">
                    <PathIcon Data="{x:Static icons:Icons.Close}" Width="11" Height="11"/>
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" x:Name="CopilotTranscriptScroll"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CopilotTranscript" Spacing="10" Margin="2,6,8,12"/>
            </ScrollViewer>
            <Border Grid.Row="2" x:Name="CopilotApprovalCard" Classes="copilot-approval-card"
                    IsVisible="False" Margin="0,8,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="操作确认" FontWeight="SemiBold"/>
                    <ScrollViewer MaxHeight="155" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="CopilotApprovalText" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="secondary compact" Content="拒绝" Click="RejectCopilotPlan"/>
                        <Button x:Name="CopilotApproveButton" Classes="primary compact"
                                Content="确认执行" Click="ApproveCopilotPlan"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Row="3" x:Name="CopilotAttachmentDropZone"
                    Classes="copilot-attachment-drop-zone" Margin="0,2,0,0"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="CopilotAttachmentDragOver"
                    DragDrop.DragLeave="CopilotAttachmentDragLeave"
                    DragDrop.Drop="CopilotAttachmentDrop"
                    ToolTip.Tip="将文件列表中的文件或文件夹拖到这里，仅添加路径作为附件">
                <StackPanel Spacing="3">
                    <StackPanel x:Name="CopilotAttachmentEmptyHint" Orientation="Horizontal" Spacing="5">
                        <PathIcon Data="{x:Static icons:Icons.File}" Width="13" Height="13"
                                  Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="拖入文件或文件夹作为附件" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                    </StackPanel>
                    <ScrollViewer x:Name="CopilotAttachmentScroll" IsVisible="False"
                                  MaxHeight="84" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="CopilotAttachmentList" IsVisible="False"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            <Border Grid.Row="4" Classes="copilot-composer" Margin="0,4,0,0">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
                    <TextBox x:Name="CopilotInput" Classes="multiline copilot-input"
                             MinHeight="50" MaxHeight="118" AcceptsReturn="True"
                             TextWrapping="Wrap"
                             PlaceholderText="询问文件、整理任务，或描述你想完成的操作…"
                             AutomationProperties.Name="Copilot 消息"/>
                    <Button x:Name="CopilotSendButton" Grid.Row="1" HorizontalAlignment="Right"
                            Classes="primary compact copilot-send"
                            Click="SendCopilotMessage" ToolTip.Tip="发送消息"
                            AutomationProperties.Name="发送 Copilot 消息">
                        <PathIcon Data="{x:Static icons:Icons.Up}" Width="14" Height="14"/>
                    </Button>
                    <Button x:Name="CopilotStopButton" Grid.Row="1" HorizontalAlignment="Right"
                            Margin="0,0,38,0" IsVisible="False" Classes="secondary compact"
                            Click="StopCopilotResponse" ToolTip.Tip="停止生成"
                            AutomationProperties.Name="停止 Copilot 生成">
                        <PathIcon Data="{x:Static icons:Icons.Stop}" Width="12" Height="12"/>
                    </Button>
                </Grid>
            </Border>
          </Grid>
        </Grid>
    </Border>
    <!-- Task overlay panel — bottom-right overlay (before DialogHost so dialogs paint above it) -->
    <Border x:Name="TaskOverlayPanel"
            IsVisible="False"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Width="356" MaxHeight="432"
            Margin="0,0,10,42">
        <Border.RenderTransform>
            <TranslateTransform X="380" Y="0"/>
        </Border.RenderTransform>
        <!-- Outer Grid with margin to make room for shadow (same pattern as ContextMenu template) -->
        <Grid Margin="12">
            <!-- Shadow layer — full-size, not clipped -->
            <Border Background="{DynamicResource GlassMenuBg}"
                    CornerRadius="12"
                    BoxShadow="{DynamicResource WindowShadow}"/>
            <!-- Content layer — clipped for rounded corners -->
            <Border Background="{DynamicResource GlassMenuBg}"
                    CornerRadius="12"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,*,Auto" Margin="6">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0">
                        <TextBlock Grid.Column="0" x:Name="TaskPanelTitle"
                                   Text="后台任务" FontSize="{DynamicResource FontSizeBody}" FontWeight="{StaticResource FontWeightSemibold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,1,0,0"/>
                        <Button Grid.Column="1" x:Name="ClearPanelButton"
                                Classes="ghost compact" Content="清空"
                                Click="ClearAllPanelTasks" Margin="0,0,2,0"
                                FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" x:Name="ClosePanelButton"
                                Classes="ghost compact"
                                Width="26" Height="26" Padding="4"
                                VerticalAlignment="Center" Click="CloseTaskPanel">
                            <PathIcon Data="{x:Static icons:Icons.Close}"
                                      Width="10" Height="10"
                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Task list -->
                    <ScrollViewer Grid.Row="1" x:Name="TaskListScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  MaxHeight="330">
                        <StackPanel x:Name="TaskItemsPanel" Margin="0,2,0,4" Spacing="0"/>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="2" x:Name="PanelFooter"
                          IsVisible="False" Margin="0,2,0,0">
                        <Button x:Name="ClearCompletedButton" Content="清除已完成"
                                Classes="ghost compact" FontSize="{DynamicResource FontSizeLabel}"
                                HorizontalAlignment="Right"
                                Click="ClearCompletedPanel"/>
                    </Grid>
                </Grid>
            </Border>
	        </Grid>
	    </Border>
	    <!-- App-wide quick search. It stays above content but below actual modal dialogs. -->
	    <!-- Overlays paint above the sidebar glass; exclude them from its backdrop capture,
	         otherwise the frame after they close replays their content inside the pane. -->
	    <Border x:Name="GlobalSearchOverlay"
	            IsVisible="False"
	            Background="{DynamicResource OverlayBrush}"
	            glass:LiquidGlassBackdrop.IsExcludedFromCapture="True"
	            PointerPressed="CloseGlobalSearchFromBackdrop">
	        <Border x:Name="GlobalSearchPanel"
	                Classes="global-search-panel"
	                Width="860" MaxHeight="560"
	                CornerRadius="16"
	                Padding="16"
	                HorizontalAlignment="Center"
	                VerticalAlignment="Top"
	                Margin="0,94,0,0">
	                <Grid RowDefinitions="Auto,Auto,*,Auto">
	                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="2,0,2,11">
	                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
	                            Background="{DynamicResource InteractionSelectedBrush}">
	                        <PathIcon Data="{x:Static icons:Icons.Search}" Width="15" Height="15"
	                                  Foreground="{DynamicResource AccentBrush}"
	                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
	                    </Border>
	                    <TextBlock Grid.Column="1" Text="全局快速搜索" Margin="10,0,0,0"
	                               VerticalAlignment="Center" FontSize="17"
	                               FontWeight="{StaticResource FontWeightSemibold}"/>
	                    <ComboBox Grid.Column="2" x:Name="GlobalSearchScopeCombo"
	                              Width="150" Height="28" Margin="8,0,8,0"
	                              SelectionChanged="OnGlobalSearchScopeChanged">
	                        <ComboBoxItem Tag="CurrentFolder">当前文件夹</ComboBoxItem>
	                        <ComboBoxItem Tag="ThisMac">这台 Mac</ComboBoxItem>
	                        <ComboBoxItem Tag="CustomFolders">自定义位置…</ComboBoxItem>
	                    </ComboBox>
	                    <Button AutomationProperties.Name="添加搜索文件夹" Grid.Column="3" x:Name="GlobalSearchAddFolderButton"
	                            Classes="ghost compact" Content="＋" Width="28" Height="28"
	                            IsVisible="False" ToolTip.Tip="添加搜索文件夹"
	                            Click="OnAddGlobalSearchFolder"/>
	                    <TextBlock Grid.Column="4" Text="⌘K  ·  Esc 关闭"
	                               VerticalAlignment="Center" FontSize="11"
	                               Foreground="{DynamicResource TextMutedBrush}"/>
	                </Grid>
	                <Border Grid.Row="1" CornerRadius="10" Padding="10,7"
	                        Background="{DynamicResource SurfaceElevatedBrush}"
	                        BorderBrush="{DynamicResource ColorBorderSubtle}" BorderThickness="1">
	                    <Grid ColumnDefinitions="Auto,*">
	                        <PathIcon Grid.Column="0" Data="{x:Static icons:Icons.Search}" Width="16" Height="16"
	                                  Margin="1,0,9,0" VerticalAlignment="Center"
	                                  Foreground="{DynamicResource TextMutedBrush}"/>
	                        <TextBox Grid.Column="1" x:Name="GlobalSearchBox"
	                                 Classes="search-input omnibox-input"
	                                 FontSize="16"
	                                 PlaceholderText="输入文件名、文件夹名或路径中的几个字…"
	                                 TextChanged="OnGlobalSearchTextChanged"
	                                 KeyDown="OnGlobalSearchKeyDown"/>
	                    </Grid>
	                </Border>
	                <Grid Grid.Row="2" ColumnDefinitions="*,220" ColumnSpacing="12" Margin="0,12,0,6">
	                    <Grid Grid.Column="0">
	                        <TextBlock x:Name="GlobalSearchEmptyHint"
	                                   Text="输入内容即可搜索已索引的本地文件、常用位置和最近位置"
	                                   HorizontalAlignment="Center" VerticalAlignment="Center"
	                                   Foreground="{DynamicResource TextMutedBrush}"/>
	                        <ListBox x:Name="GlobalSearchResults"
	                                 Classes="global-search-results"
	                                 IsVisible="False"
	                                 SelectionChanged="OnGlobalSearchSelectionChanged">
	                            <ListBox.ItemTemplate>
	                                <DataTemplate>
                                    <Grid ColumnDefinitions="34,*,Auto" DoubleTapped="OnGlobalSearchResultDoubleTapped">
	                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7"
	                                                Background="{DynamicResource ColorBgHover}">
	                                            <PathIcon Data="{Binding IconData}" Width="16" Height="16"
	                                                      Foreground="{Binding IconColor}"
	                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
	                                        </Border>
	                                        <StackPanel Grid.Column="1" Margin="8,0,8,0" Spacing="1"
	                                                    VerticalAlignment="Center">
	                                            <TextBlock Text="{Binding Title}" FontSize="14"
	                                                       TextTrimming="CharacterEllipsis"/>
	                                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
	                                                       Foreground="{DynamicResource TextSecondaryBrush}"
	                                                       TextTrimming="CharacterEllipsis"/>
	                                        </StackPanel>
	                                        <TextBlock Grid.Column="2" Text="↩" FontSize="12"
	                                                   VerticalAlignment="Center"
	                                                   Foreground="{DynamicResource TextMutedBrush}"/>
	                                    </Grid>
	                                </DataTemplate>
	                            </ListBox.ItemTemplate>
	                        </ListBox>
	                    </Grid>
	                    <Border Grid.Column="1" x:Name="GlobalSearchPreviewPanel"
	                            CornerRadius="10" Padding="10"
	                            Background="{DynamicResource SurfaceElevatedBrush}"
	                            BorderBrush="{DynamicResource ColorBorderSubtle}" BorderThickness="1">
	                        <Grid RowDefinitions="Auto,*,Auto">
	                            <Grid ColumnDefinitions="*,Auto">
	                                <TextBlock Text="预览" FontSize="12" VerticalAlignment="Center"
	                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
	                                <ComboBox Grid.Column="1" x:Name="GlobalSearchPreviewSizeCombo"
	                                          Width="70" Height="25"
	                                          SelectionChanged="OnGlobalSearchPreviewSizeChanged">
	                                    <ComboBoxItem Tag="Small">小</ComboBoxItem>
	                                    <ComboBoxItem Tag="Medium">中</ComboBoxItem>
	                                    <ComboBoxItem Tag="Large">大</ComboBoxItem>
	                                </ComboBox>
	                            </Grid>
                            <Grid Grid.Row="1" Margin="0,8">
                                <TextBlock x:Name="GlobalSearchPreviewPlaceholder"
                                           Text="选择文件以预览"
	                                           TextAlignment="Center"
	                                           HorizontalAlignment="Center" VerticalAlignment="Center"
	                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <Image x:Name="GlobalSearchPreviewImage"
                                       IsVisible="False"
                                       Width="180" Height="180"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ListBox x:Name="GlobalSearchFolderContents"
                                         IsVisible="False"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:FileSystemEntry">
                                            <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="6"
                                                  Margin="2,3" MinHeight="38"
                                                  DoubleTapped="OnGlobalSearchFolderEntryDoubleTapped">
                                                <Image Grid.Column="0" Width="32" Height="32"
                                                       Stretch="Uniform"
                                                       Loaded="OnGlobalSearchFolderImageLoaded"
                                                       DataContextChanged="OnGlobalSearchFolderImageDataContextChanged"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Name}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding KindText}"
                                                           FontSize="9" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
	                            <StackPanel Grid.Row="2" Spacing="2">
	                                <TextBlock x:Name="GlobalSearchPreviewTitle" FontSize="12"
	                                           TextTrimming="CharacterEllipsis"/>
	                                <TextBlock x:Name="GlobalSearchPreviewPath" FontSize="10"
	                                           TextTrimming="CharacterEllipsis"
	                                           Foreground="{DynamicResource TextMutedBrush}"/>
	                            </StackPanel>
	                        </Grid>
	                    </Border>
	                </Grid>
	                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="2,7,2,0">
	                    <TextBlock x:Name="GlobalSearchResultCount" Text="仅搜索 Mac Explorer 已获权限并建立索引的位置"
	                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
	                    <TextBlock Grid.Column="1" Text="↑↓ 选择  ·  ↩ 打开"
	                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
	                </Grid>
	            </Grid>
	        </Border>
	    </Border>
	    <!-- Finder-style in-window super preview. It sits above the active tab
	         without changing its navigation state, and can browse folders and
	         archive entries recursively. -->
	    <local:SuperPreviewView x:Name="SuperPreviewControl"
	                            IsVisible="False"
	                            glass:LiquidGlassBackdrop.IsExcludedFromCapture="True"/>
	    <Border x:Name="ModalInteractionOverlay"
	            IsVisible="False"
	            Background="{DynamicResource OverlayBrush}"
	            glass:LiquidGlassBackdrop.IsExcludedFromCapture="True"
	            IsHitTestVisible="True"/>
	    <controls:DialogHost x:Name="DialogHost"
	                         glass:LiquidGlassBackdrop.IsExcludedFromCapture="True"/>
	    </Grid>
	</controls:AppWindow>
