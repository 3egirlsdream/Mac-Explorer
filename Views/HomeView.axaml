<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MacExplorer.ViewModels"
             xmlns:icons="using:MacExplorer.Assets"
             xmlns:models="using:MacExplorer.Models"
             x:Class="MacExplorer.Views.HomeView"
             x:DataType="vm:FileListViewModel"
             x:CompileBindings="False">

    <Grid Background="{DynamicResource ColorBgContent}" x:Name="HomeRoot">
        <Grid.ContextMenu><ContextMenu x:Name="HomeCtxMenu"/></Grid.ContextMenu>
        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Spacing="20" Margin="24,24,24,80" MaxWidth="560">
            <StackPanel Spacing="6">
                <TextBlock Text="打开位置或搜索文件" FontSize="{DynamicResource FontSizeDisplay}" FontWeight="{StaticResource FontWeightSemibold}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="输入路径直接打开，或搜索索引中的文件。⌘K 打开全局搜索。" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <Grid>
                <Border x:Name="HomeSearchContainer" Classes="home-search-box">
                    <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Grid.Column="0" Data="{x:Static icons:Icons.Search}"
                                  Width="18" Height="18" Margin="14,0,8,0"
                                  Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBox Grid.Column="1" x:Name="HomeSearchBox"
                                 Classes="home-search-input omnibox-input"
                                 PlaceholderText="输入路径、网址或文件名" AutomationProperties.Name="打开位置或搜索文件"
                                 GotFocus="OnHomeSearchGotFocus"
                                 TextChanged="OnHomeSearchTextChanged"
                                 LostFocus="OnHomeSearchLostFocus"
                                 KeyDown="OnHomeSearchKeyDown"/>
                    </Grid>
                </Border>
                <Popup x:Name="HomeSearchPopup"
                       PlacementTarget="{Binding #HomeSearchContainer}"
                       Placement="Bottom"
                       IsLightDismissEnabled="False">
                    <Border x:Name="HomeSearchSurface"
                            MaxHeight="340"
                            Classes="omnibox-popup omnibox-input">
                        <ListBox x:Name="HomeSearchSuggestionList"
                                 Classes="omnibox-suggestions">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:OmniboxSuggestion">
                                    <Grid ColumnDefinitions="32,*"
                                          Background="Transparent"
                                          Tapped="OnHomeSuggestionTapped">
                                        <Border Width="28" Height="28" CornerRadius="6"
                                                Background="{DynamicResource ColorBgHover}">
                                            <PathIcon Data="{Binding IconData}"
                                                      Width="15" Height="15"
                                                      Foreground="{Binding IconColor}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,4,0"
                                                    VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeBody}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>

            <WrapPanel HorizontalAlignment="Left" Margin="-6,0">
                <Button Classes="ghost home-shortcut" Click="NavigateHomeDirectory" AutomationProperties.Name="打开主目录" Margin="6,0,6,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{x:Static icons:Icons.Home}" Width="24" Height="24" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="主目录" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost home-shortcut" Click="NavigateDesktop" AutomationProperties.Name="打开桌面" Margin="6,0,6,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{x:Static icons:Icons.Desktop}" Width="24" Height="24" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="桌面" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost home-shortcut" Click="NavigateMacintoshHd" AutomationProperties.Name="打开Macintosh HD" Margin="6,0,6,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{x:Static icons:Icons.ExternalDrive}" Width="24" Height="24" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="Macintosh HD" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
