<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:MacExplorer.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MacExplorer.ViewModels"
             xmlns:icons="using:MacExplorer.Assets"
             xmlns:models="using:MacExplorer.Models"
             xmlns:views="using:MacExplorer.Views"
             xmlns:glass="clr-namespace:LiquidGlassAvaloniaUI;assembly=LiquidGlassAvaloniaUI"
             x:Class="MacExplorer.Views.HomeView"
             x:DataType="vm:FileListViewModel"
             x:CompileBindings="False">

    <Grid Background="Transparent" x:Name="HomeRoot" RowDefinitions="Auto,*">
        <Grid x:Name="HeaderLayout" Margin="24,24,24,20"
              glass:LiquidGlassBackdrop.IsExcludedFromCapture="True">
            <Grid x:Name="HeaderActions" ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
            <Grid>
                <glass:LiquidGlassSurface Classes="home-glass" CornerRadius="{StaticResource RadiusLg}" Height="44">
                <Border x:Name="HomeSearchContainer" Classes="home-search-box" Height="44" CornerRadius="{StaticResource RadiusLg}">
                    <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Grid.Column="0" Data="{x:Static icons:Icons.Search}"
                                  Width="18" Height="18" Margin="14,0,8,0"
                                  Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBox Grid.Column="1" x:Name="HomeSearchBox"
                                 Classes="home-search-input omnibox-input"
                                 PlaceholderText="{loc:Loc ui.563}" AutomationProperties.Name="{loc:Loc ui.564}"
                                 GotFocus="OnHomeSearchGotFocus"
                                 TextChanged="OnHomeSearchTextChanged"
                                 LostFocus="OnHomeSearchLostFocus"
                                 KeyDown="OnHomeSearchKeyDown"/>
                    </Grid>
                </Border>
                </glass:LiquidGlassSurface>
                <Popup x:Name="HomeSearchPopup"
                       PlacementTarget="{Binding #HomeSearchContainer}"
                       Placement="Bottom"
                       IsLightDismissEnabled="False">
                    <Border x:Name="HomeSearchSurface"
                            MaxHeight="340"
                            Classes="omnibox-popup omnibox-input">
                        <ListBox x:Name="HomeSearchSuggestionList"
                                 Classes="omnibox-suggestions">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:OmniboxSuggestion">
                                    <Grid ColumnDefinitions="32,*"
                                          Background="Transparent"
                                          Tapped="OnHomeSuggestionTapped">
                                        <Border Width="28" Height="28" CornerRadius="6"
                                                Background="{DynamicResource ColorBgHover}">
                                            <PathIcon Data="{Binding IconData}"
                                                      Width="15" Height="15"
                                                      Foreground="{Binding IconColor}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,4,0"
                                                    VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeBody}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <glass:LiquidGlassSurface Classes="home-glass" CornerRadius="{StaticResource RadiusLg}"><Button Classes="ghost home-quick-action" Click="NavigateHomeDirectory" ToolTip.Tip="{loc:Loc ui.565}" AutomationProperties.Name="{loc:Loc ui.566}">
                    <PathIcon Data="{x:Static icons:Icons.Home}" Width="18" Height="18"/>
                </Button></glass:LiquidGlassSurface>
                <glass:LiquidGlassSurface Classes="home-glass" CornerRadius="{StaticResource RadiusLg}"><Button Classes="ghost home-quick-action" Click="NavigateDesktop" ToolTip.Tip="{loc:Loc ui.219}" AutomationProperties.Name="{loc:Loc ui.567}">
                    <PathIcon Data="{x:Static icons:Icons.Desktop}" Width="18" Height="18"/>
                </Button></glass:LiquidGlassSurface>
                <glass:LiquidGlassSurface Classes="home-glass" CornerRadius="{StaticResource RadiusLg}"><Button Classes="ghost home-quick-action" Click="NavigateMacintoshHd" ToolTip.Tip="Macintosh HD" AutomationProperties.Name="{loc:Loc ui.568}">
                    <PathIcon Data="{x:Static icons:Icons.ExternalDrive}" Width="18" Height="18"/>
                </Button></glass:LiquidGlassSurface>
            </StackPanel>
            </Grid>
        </Grid>
        <views:HomeDashboard Grid.Row="1"/>
    </Grid>
</UserControl>
