<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MacExplorer.ViewModels"
             xmlns:icons="using:MacExplorer.Assets"
             xmlns:local="using:MacExplorer.Views"
             x:Class="MacExplorer.Views.FinderToolbar"
             x:DataType="vm:FileListViewModel"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="PathIcon.toolbar-icon">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
        </Style>
        <Style Selector="Button#DeleteButton:pointerover PathIcon, Button#DeleteOverflowButton:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>
        <Style Selector="Image.new-item-icon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>
        <Style Selector="local|FinderToolbar:compact Button.toolbar-regular-action, local|FinderToolbar:compact Separator.toolbar-regular-action">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="local|FinderToolbar:not(:compact) Button.compact-overflow-item, local|FinderToolbar:not(:compact) Separator.compact-overflow-item">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="finder-toolbar">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="4" Margin="0,0">

            <!-- New button + Dropdown Popup -->
            <Button Grid.Column="0" Classes="ghost toolbar-btn w32" ToolTip.Tip="新建"
                    AutomationProperties.Name="新建" x:Name="NewBtn" Click="ToggleNewDropdown">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.Plus}"/>
                    <TextBlock Classes="compact-label" Text="新建" FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- New dropdown popup -->
            <Popup x:Name="NewDropdown" Placement="BottomEdgeAlignedLeft" PlacementTarget="NewBtn"
                   IsOpen="False" IsLightDismissEnabled="True"
                   OverlayDismissEventPassThrough="True" WindowManagerAddShadowHint="False"
                   Opened="OnDropdownStateChanged" Closed="OnDropdownStateChanged">
                <Border Classes="toolbar-popup" MinWidth="200">
                    <ItemsControl x:Name="NewItems" ItemsSource="{Binding NewItemActions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Separator IsVisible="{Binding IsSeparator}"/>
                                    <Button AutomationProperties.Name="{Binding Label}" Classes="toolbar-popup-item"
                                            IsVisible="{Binding !IsSeparator}" IsEnabled="{Binding IsEnabled}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Click="CreateNewItem">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Classes="new-item-icon" Source="{Binding IconImage}"/>
                                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FontSizeBody}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>

            <Separator Grid.Column="1" Classes="toolbar-separator toolbar-regular-action"/>

            <!-- Clipboard -->
            <Button Grid.Column="2" x:Name="CutButton" Classes="ghost toolbar-btn w32 toolbar-regular-action" ToolTip.Tip="剪切 ⌘X" AutomationProperties.Name="剪切" Click="CutSelected">
                <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.Cut}"/>
            </Button>
            <Button Grid.Column="3" x:Name="CopyButton" Classes="ghost toolbar-btn w32 toolbar-regular-action" ToolTip.Tip="复制 ⌘C" AutomationProperties.Name="复制" Click="CopySelected">
                <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.Copy}"/>
            </Button>
            <Button Grid.Column="4" x:Name="PasteButton" Classes="ghost toolbar-btn w32 toolbar-regular-action" ToolTip.Tip="粘贴 ⌘V" AutomationProperties.Name="粘贴" Click="PasteItems">
                <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.Paste}"/>
            </Button>
            <Button Grid.Column="5" x:Name="DeleteButton" Classes="ghost toolbar-btn w32 toolbar-regular-action" ToolTip.Tip="删除 ⌘⌫" AutomationProperties.Name="删除" Click="DeleteSelected">
                <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.Delete}"/>
            </Button>

            <Button Grid.Column="6" x:Name="HomeButton" Classes="ghost toolbar-btn w32 toolbar-regular-action" ToolTip.Tip="首页 ⌘H" AutomationProperties.Name="首页" Click="GoHome">
                <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.Home}"/>
            </Button>

            <Border Grid.Column="7" MinWidth="12"/>

            <!-- View mode toggle -->
            <Grid Grid.Column="8" Grid.ColumnSpan="2" Classes="view-mode-segmented">
                <Path Data="{DynamicResource ViewModeTrackGeometry}"
                      Fill="{DynamicResource ViewModeToggleBg}" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal" Margin="2">
                    <ToggleButton x:Name="GridViewToggle" Classes="view-mode-toggle"
                                  ToolTip.Tip="图标视图" AutomationProperties.Name="图标视图" Click="ToggleGridView">
                        <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.Grid}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ListViewToggle" Classes="view-mode-toggle"
                                  ToolTip.Tip="列表视图" AutomationProperties.Name="列表视图" Click="ToggleListView">
                        <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.List}"/>
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <Separator Grid.Column="10" Classes="toolbar-separator toolbar-regular-action"/>

            <!-- Sort & Group -->
            <Button Grid.Column="11" x:Name="SortButton" Classes="ghost toolbar-btn" ToolTip.Tip="排序和分组" AutomationProperties.Name="排序和分组" Click="ToggleSortDropdown">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.SortUpDown}"/>
                    <TextBlock Classes="compact-label" Text="排序" FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Popup x:Name="SortDropdown" Placement="BottomEdgeAlignedLeft" PlacementTarget="SortButton"
                   IsOpen="False" IsLightDismissEnabled="True"
                   OverlayDismissEventPassThrough="True" WindowManagerAddShadowHint="False"
                   Opened="OnDropdownStateChanged" Closed="OnDropdownStateChanged">
                <Border Classes="toolbar-popup" MinWidth="190">
                    <StackPanel>
                        <TextBlock Text="排序方式" Classes="toolbar-popup-header"/>
                        <Button AutomationProperties.Name="分组方式" Content="名称" Tag="Name" Classes="toolbar-popup-item" Click="SelectSortField"/>
                        <Button Content="修改日期" Tag="Modified" Classes="toolbar-popup-item" Click="SelectSortField"/>
                        <Button Content="大小" Tag="Size" Classes="toolbar-popup-item" Click="SelectSortField"/>
                        <Button Content="类型" Tag="Type" Classes="toolbar-popup-item" Click="SelectSortField"/>
                        <Separator/>
                        <Button x:Name="SortDirectionButton" Content="升序 ↑" Classes="toolbar-popup-item" Click="ToggleSortDirection"/>
                        <Separator/>
                        <TextBlock Text="分组方式" Classes="toolbar-popup-header"/>
                        <Button Content="不分组" Tag="None" Classes="toolbar-popup-item" Click="SelectGroupField"/>
                        <Button Content="类型" Tag="Type" Classes="toolbar-popup-item" Click="SelectGroupField"/>
                        <Button Content="修改日期" Tag="Modified" Classes="toolbar-popup-item" Click="SelectGroupField"/>
                        <Button Content="大小" Tag="Size" Classes="toolbar-popup-item" Click="SelectGroupField"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Info panel toggle -->
            <Button Grid.Column="13" Classes="ghost toolbar-btn w32" ToolTip.Tip="信息面板 ⌘I" AutomationProperties.Name="信息面板" Click="ToggleInfoPanel">
                <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.Info}"/>
            </Button>

            <!-- More button -->
            <Button Grid.Column="14" Classes="ghost toolbar-btn w32" ToolTip.Tip="更多"
                    AutomationProperties.Name="更多" x:Name="MoreBtn" Click="ToggleMoreDropdown">
                <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.MoreHorizontal}"/>
            </Button>

            <!-- More dropdown popup -->
            <Popup x:Name="MoreDropdown" Placement="BottomEdgeAlignedRight" PlacementTarget="MoreBtn"
                   IsOpen="False" IsLightDismissEnabled="True"
                   OverlayDismissEventPassThrough="True" WindowManagerAddShadowHint="False"
                   Opened="OnDropdownStateChanged" Closed="OnDropdownStateChanged">
                <Border Classes="toolbar-popup" MinWidth="180">
                    <StackPanel>
                        <Button x:Name="CutOverflowButton" AutomationProperties.Name="剪切" Classes="toolbar-popup-item compact-overflow-item"
                                ToolTip.Tip="剪切 ⌘X"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Click="CutSelected">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.Cut}"/>
                                <TextBlock Text="剪切" FontSize="{DynamicResource FontSizeBody}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CopyOverflowButton" AutomationProperties.Name="复制" Classes="toolbar-popup-item compact-overflow-item"
                                ToolTip.Tip="复制 ⌘C"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Click="CopySelected">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.Copy}"/>
                                <TextBlock Text="复制" FontSize="{DynamicResource FontSizeBody}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PasteOverflowButton" AutomationProperties.Name="粘贴" Classes="toolbar-popup-item compact-overflow-item"
                                ToolTip.Tip="粘贴 ⌘V"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Click="PasteItems">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.Paste}"/>
                                <TextBlock Text="粘贴" FontSize="{DynamicResource FontSizeBody}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteOverflowButton" AutomationProperties.Name="删除" Classes="toolbar-popup-item compact-overflow-item"
                                ToolTip.Tip="删除 ⌘⌫"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Click="DeleteSelected">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.Delete}"/>
                                <TextBlock Text="删除" FontSize="{DynamicResource FontSizeBody}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HomeOverflowButton" AutomationProperties.Name="返回首页" Classes="toolbar-popup-item compact-overflow-item"
                                ToolTip.Tip="首页 ⌘H"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Click="GoHome">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.Home}"/>
                                <TextBlock Text="返回首页" FontSize="{DynamicResource FontSizeBody}"/>
                            </StackPanel>
                        </Button>
                        <Separator Classes="compact-overflow-item"/>
                        <Button Classes="toolbar-popup-item"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                AutomationProperties.Name="批量重命名" Click="OnBatchRename">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.Rename}"/>
                                <TextBlock Text="批量重命名" FontSize="{DynamicResource FontSizeBody}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="toolbar-popup-item"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                AutomationProperties.Name="连接远程服务器" Click="OnConnectRemoteServer">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Classes="toolbar-icon" Data="{x:Static icons:Icons.ExternalDrive}"/>
                                <TextBlock Text="连接远程服务器" FontSize="{DynamicResource FontSizeBody}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
