<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:MacExplorer.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MacExplorer.ViewModels"
             xmlns:models="using:MacExplorer.Models"
             xmlns:icons="using:MacExplorer.Assets"
             xmlns:converters="using:MacExplorer.Converters"
             xmlns:glass="clr-namespace:LiquidGlassAvaloniaUI;assembly=LiquidGlassAvaloniaUI"
             x:Class="MacExplorer.Views.FinderSidebarView"
             x:DataType="vm:FileListViewModel"
             x:CompileBindings="False"
             DragDrop.AllowDrop="True"
             DragDrop.DragOver="OnSidebarDragOver"
             DragDrop.DragLeave="OnSidebarDragLeave"
             DragDrop.Drop="OnSidebarDrop">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="InteractionSelectedBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="InteractionSelectedHoverBrush" Color="Transparent"/>
                    <x:Double x:Key="SidebarActionBackdropOpacity">1</x:Double>
                    <x:Double x:Key="SidebarActionRefraction">12</x:Double>
                    <x:Double x:Key="SidebarActionHoverHighlight">0.55</x:Double>
                    <x:Double x:Key="SidebarActionFocusHighlight">0.75</x:Double>
                    <BoxShadows x:Key="SidebarSelectedOutline">inset 0 0 0 1 #702463D4</BoxShadows>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="InteractionSelectedBrush" Color="#16FFFFFF"/>
                    <SolidColorBrush x:Key="InteractionSelectedHoverBrush" Color="#1CFFFFFF"/>
                    <x:Double x:Key="SidebarActionBackdropOpacity">0</x:Double>
                    <x:Double x:Key="SidebarActionRefraction">0</x:Double>
                    <x:Double x:Key="SidebarActionHoverHighlight">0</x:Double>
                    <x:Double x:Key="SidebarActionFocusHighlight">0</x:Double>
                    <BoxShadows x:Key="SidebarSelectedOutline">0 0 0 0 Transparent</BoxShadows>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- The demo uses a transparent button inside an interactive glass surface, not a filled hover theme. -->
            <Template x:Key="SidebarGlassFocusAdorner">
                <Border BorderBrush="{DynamicResource FocusRingBrush}" BorderThickness="2"
                    CornerRadius="{DynamicResource InteractionCornerRadius}" IsHitTestVisible="False"
                    glass:LiquidGlassBackdrop.IsExcludedFromCapture="True"/>
            </Template>
            <ControlTheme x:Key="SidebarGlassButton" TargetType="Button">
                <Setter Property="Template">
                    <ControlTemplate>
                        <glass:LiquidGlassInteractiveSurface x:Name="ButtonGlass"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            TintColor="Transparent" SurfaceColor="Transparent"
                            BackdropOpacity="{DynamicResource SidebarActionBackdropOpacity}"
                            BlurRadius="0" RefractionHeight="8" RefractionAmount="0"
                            HighlightOpacity="0" HighlightWidth="0.75"
                            ShadowEnabled="False" InnerShadowEnabled="False"
                            InteractiveMaxScaleDip="0.8">
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                Background="Transparent" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </glass:LiquidGlassInteractiveSurface>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ glass|LiquidGlassInteractiveSurface#ButtonGlass">
                    <Setter Property="RefractionAmount" Value="{DynamicResource SidebarActionRefraction}"/>
                    <Setter Property="HighlightOpacity" Value="{DynamicResource SidebarActionHoverHighlight}"/>
                </Style>
                <Style Selector="^:focus-visible /template/ glass|LiquidGlassInteractiveSurface#ButtonGlass">
                    <Setter Property="RefractionAmount" Value="{DynamicResource SidebarActionRefraction}"/>
                    <Setter Property="HighlightOpacity" Value="{DynamicResource SidebarActionFocusHighlight}"/>
                </Style>
                <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                </Style>
            </ControlTheme>
            <converters:StringToGeometryConverter x:Key="StringToGeometry"/>
            <converters:IsNotEmptyConverter x:Key="IsNotEmpty"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.sidebar-item-action, Button.sidebar-header-action, Button.sidebar-inline-confirm">
            <Setter Property="Theme" Value="{StaticResource SidebarGlassButton}"/>
            <Setter Property="FocusAdorner" Value="{StaticResource SidebarGlassFocusAdorner}"/>
        </Style>
        <Style Selector="Button.sidebar-item-action:pressed, Button.sidebar-header-action:pressed, Button.sidebar-inline-confirm:pressed">
            <Setter Property="RenderTransform" Value="{x:Null}"/>
        </Style>
        <Style Selector=":is(Control).sidebar-category-header">
            <Setter Property="Margin" Value="0,8,0,2"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style Selector="Grid.sidebar-category-header > TextBlock.sidebar-section-title">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="PathIcon.sidebar-icon">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.sidebar-item">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="Border.sidebar-item:pointerover">
            <Setter Property="BoxShadow" Value="{DynamicResource SidebarHoverOutline}"/>
        </Style>
        <Style Selector="Border.sidebar-item.active PathIcon.sidebar-icon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.sidebar-item.active">
            <Setter Property="BoxShadow" Value="{DynamicResource SidebarSelectedOutline}"/>
        </Style>
        <Style Selector="Border.sidebar-item.active:pointerover">
            <Setter Property="BoxShadow" Value="{DynamicResource SidebarSelectedOutline}"/>
        </Style>
        <Style Selector="Border.sidebar-item.folder-drop-target">
            <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource SidebarHoverOutline}"/>
        </Style>
        <Style Selector="Border.sidebar-item:focus-visible, Border.sidebar-item.active:focus-visible">
            <Setter Property="BoxShadow" Value="{DynamicResource FocusOutlineShadow}"/>
        </Style>
        <Style Selector="TextBlock.rail-text-hidden">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Button.sidebar-item-action.rail-action-hidden">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ItemsControl.rail-secondary.rail-hidden">
            <Setter Property="MaxHeight" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="TextBlock.rail-secondary.rail-hidden">
            <Setter Property="MaxHeight" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Grid.rail-secondary.rail-hidden">
            <Setter Property="MaxHeight" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="StackPanel.rail-secondary.rail-hidden">
            <Setter Property="MaxHeight" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel x:Name="SidebarRoot" Margin="4,8,4,4">

                    <!-- ═══ 收藏 Favorites ═══ -->
                    <TextBlock Classes="sidebar-section-title sidebar-category-header rail-secondary" Text="{loc:Loc ui.318}" Margin="0,0,0,2"/>

                    <!-- Username -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarUsername}"
                            x:Name="UsernameItem"
                            ToolTip.Tip="{Binding UserName}"
                            AutomationProperties.Name="{Binding UserName}"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.Person}"
                                      Classes="sidebar-icon"/>
                            <TextBlock Text="{Binding UserName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Desktop -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarDesktop}"
                            x:Name="DesktopItem"
                            ToolTip.Tip="{Binding DesktopName}"
                            AutomationProperties.Name="{loc:Loc ui.219}"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.Desktop}"
                                      Classes="sidebar-icon"/>
                            <TextBlock Text="{Binding DesktopName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Documents -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarDocuments}"
                            x:Name="DocumentsItem"
                            ToolTip.Tip="{Binding DocumentsName}"
                            AutomationProperties.Name="{loc:Loc ui.199}"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.FileText}"
                                      Classes="sidebar-icon"/>
                            <TextBlock Text="{Binding DocumentsName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Downloads -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarDownloads}"
                            x:Name="DownloadsItem"
                            ToolTip.Tip="{Binding DownloadsName}"
                            AutomationProperties.Name="{loc:Loc ui.137}"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.Download}"
                                      Classes="sidebar-icon"/>
                            <TextBlock Text="{Binding DownloadsName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Pictures -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarPictures}"
                            x:Name="PicturesItem"
                            ToolTip.Tip="{Binding PicturesName}"
                            AutomationProperties.Name="{loc:Loc ui.160}"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.Image}"
                                      Classes="sidebar-icon"/>
                            <TextBlock Text="{Binding PicturesName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Music -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarMusic}"
                            x:Name="MusicItem"
                            ToolTip.Tip="{Binding MusicName}"
                            AutomationProperties.Name="{loc:Loc ui.271}"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.Music}"
                                      Classes="sidebar-icon"/>
                            <TextBlock Text="{Binding MusicName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Pinned folders (kept from existing, already working) -->
                    <ItemsControl x:Name="PinnedFoldersControl" Classes="sidebar-items rail-secondary"
                                  ItemsSource="{Binding PinnedFolders}"
                                  MinHeight="8"
                                  >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PinnedFolder">
                                <Border Classes="sidebar-item"
                                        Tag="{Binding FolderPath}"
                                        PointerPressed="OnPinnedFolderPressed">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Background="Transparent">
                                            <PathIcon Data="{x:Static icons:Icons.Folder}"
                                                      Classes="sidebar-icon"/>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                            Classes="ghost sidebar-item-action pinned-unpin"
                                            Tag="{Binding FolderPath}"
                                            ToolTip.Tip="{loc:Loc ui.315}" AutomationProperties.Name="{loc:Loc ui.315}"
                                            PointerPressed="OnUnpinPointerPressed"
                                            Click="UnpinFolder">
                                            <PathIcon Data="{x:Static icons:Icons.Pin}"
                                                      Width="12" Height="12"
                                                      Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ═══ 位置 Locations ═══ -->
                    <TextBlock Classes="sidebar-section-title sidebar-category-header rail-secondary" Text="{loc:Loc ui.145}"/>

                    <!-- Macintosh HD -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarMacintoshHd}"
                            x:Name="VolumeItem"
                            ToolTip.Tip="{Binding VolumeName}"
                            AutomationProperties.Name="Macintosh HD"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.ExternalDrive}"
                                      Classes="sidebar-icon"/>
                            <TextBlock Text="{Binding VolumeName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- External volumes -->
                    <ItemsControl x:Name="ExternalVolumesControl"
                                  Classes="sidebar-items rail-secondary"
                                  ItemsSource="{Binding ExternalVolumes}"
                                  IsVisible="{Binding ExternalVolumes, Converter={StaticResource IsNotEmpty}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:VolumeInfo">
                                <Border Classes="sidebar-item"
                                        Tag="{Binding .}"
                                        PointerPressed="OnVolumePressed">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Background="Transparent">
                                            <PathIcon Data="{x:Static icons:Icons.ExternalDrive}"
                                                      Classes="sidebar-icon"/>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="ghost sidebar-item-action"
                                                Tag="{Binding .}"
                                                ToolTip.Tip="{loc:Loc ui.319}" AutomationProperties.Name="{loc:Loc ui.319}"
                                                PointerPressed="OnUnpinPointerPressed"
                                                Click="EjectVolume">
                                            <PathIcon Data="{x:Static icons:Icons.Eject}"
                                                      Width="12" Height="12"
                                                      Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Applications -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarApplications}"
                            x:Name="ApplicationsItem"
                            ToolTip.Tip="{Binding ApplicationsName}"
                            AutomationProperties.Name="{loc:Loc ui.172}"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.Apps}"
                                      Classes="sidebar-icon"/>
                            <TextBlock Text="{Binding ApplicationsName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Trash -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarTrash}"
                            x:Name="TrashItem"
                            ToolTip.Tip="{Binding TrashName}"
                            AutomationProperties.Name="{loc:Loc ui.173}"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.Trash}"
                                      Classes="sidebar-icon"/>
                            <TextBlock Text="{Binding TrashName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ 远程服务器 Remote Servers ═══ -->
                    <Grid ColumnDefinitions="Auto,*" Classes="sidebar-category-header rail-secondary"
                          x:Name="RemoteServersHeader"
                          IsVisible="False">
                        <TextBlock Grid.Column="0" Text="{loc:Loc ui.324}"
                                   Classes="sidebar-section-title"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Padding="18,4,0,4"/>
                    </Grid>

                    <!-- Remote server list -->
                    <ItemsControl x:Name="RemoteServersList" Classes="sidebar-items rail-secondary" IsVisible="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="sidebar-item"
                                        Tag="{Binding}"
                                        PointerPressed="OnRemoteServerPressed">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                                        <!-- Connection status dot -->
                                        <Grid Grid.Column="0" Width="6" Height="6" Margin="0,0,6,0"
                                              VerticalAlignment="Center">
                                            <Ellipse Fill="{DynamicResource ColorSuccess}"
                                                     IsVisible="{Binding IsConnected}"/>
                                            <Ellipse Fill="{DynamicResource TextDisabledBrush}"
                                                     IsVisible="{Binding !IsConnected}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Background="Transparent"
                                                    Margin="0">
                                            <PathIcon Data="{x:Static icons:Icons.ExternalDrive}"
                                                      Classes="sidebar-icon"/>
                                            <StackPanel Margin="6,0,0,0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBodyLarge}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding StatusText}"
                                                           Classes="sidebar-secondary-text"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Classes="ghost sidebar-item-action"
                                                Tag="{Binding}"
                                                ToolTip.Tip="{loc:Loc ui.320}" AutomationProperties.Name="{loc:Loc ui.320}" IsEnabled="{Binding IsConnected}"
                                                PointerPressed="OnUnpinPointerPressed"
                                                Click="OnDisconnectRemoteServer">
                                            <PathIcon Data="{x:Static icons:Icons.Delete}"
                                                      Width="12" Height="12"
                                                      Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ═══ 标签 Tags ═══ -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Classes="sidebar-section-header sidebar-category-header rail-secondary"
                          x:Name="TagsSectionHeader" Focusable="True" FocusAdorner="{StaticResource SidebarGlassFocusAdorner}" AutomationProperties.Name="{loc:Loc ui.317}"
                          PointerPressed="OnToggleTagsCollapsed">
                        <TextBlock Grid.Column="0" x:Name="TagsSectionTitle" Text="{loc:Loc ui.322}"
                                   Classes="sidebar-section-title"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Padding="18,4,0,4"
                                   Cursor="Hand"/>
                        <Button Grid.Column="2"
                                x:Name="AddTagBtn" Opacity="1" IsHitTestVisible="True"
                                Classes="ghost sidebar-header-action"
                                Background="Transparent" BorderThickness="0"
                                Padding="4" Margin="0,2,6,2"
                                PointerPressed="OnUnpinPointerPressed"
                                Click="StartNewTag"
                                ToolTip.Tip="{loc:Loc ui.321}" AutomationProperties.Name="{loc:Loc ui.321}">
                            <PathIcon Data="{x:Static icons:Icons.Plus}"
                                      Width="10" Height="10"
                                      Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        <PathIcon Grid.Column="3" Data="{x:Static icons:Icons.ChevronRight}"
                                  Classes="sidebar-header-reveal"
                                  Width="10" Height="10"
                                  Foreground="{DynamicResource TextSubtleBrush}"
                                  Margin="0,4,12,4"
                                  x:Name="TagsChevron"/>
                    </Grid>

                    <StackPanel Classes="rail-secondary" IsVisible="{Binding !IsTagsSectionCollapsed}"
                                x:Name="TagsPanel">

                        <!-- Tag list -->
                        <ItemsControl x:Name="TagItems"
                                      Classes="sidebar-items"
                                      ItemsSource="{Binding SidebarTags}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:FileTag">
                                    <Border Classes="sidebar-item tag-row"
                                            Tag="{Binding}"
                                            PointerPressed="OnTagPressed" DragDrop.AllowDrop="True"
                                            DragDrop.DragOver="OnTagDragOver" DragDrop.Drop="OnTagDrop">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                              Classes="tag-row-content"
                                              Background="Transparent"
                                              VerticalAlignment="Center">
                                            <PathIcon Data="{x:Static icons:Icons.Tag}"
                                                      Classes="sidebar-icon" Foreground="{Binding ColorHex}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                       Classes="tag-name-label" TextTrimming="CharacterEllipsis"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBodyLarge}"/>
                                            <TextBox Grid.Column="1"
                                                     Classes="inline-rename-editor tag-name-editor"
                                                     Tag="{Binding}"
                                                     IsVisible="False"
                                                     Margin="8,0,4,0"
                                                     MinWidth="72"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     FontSize="{DynamicResource FontSizeBody}"
                                                     KeyDown="OnTagEditorKeyDown"
                                                     LostFocus="OnTagEditorLostFocus"/>
                                            <Button AutomationProperties.Name="{loc:Loc ui.325}" Grid.Column="2" Tag="{Binding}"
                                                    Classes="ghost sidebar-item-action tag-normal-action"
                                                    ToolTip.Tip="{loc:Loc ui.325}"
                                                    PointerPressed="OnUnpinPointerPressed"
                                                    Click="RenameTag" IsVisible="{Binding IsCustom}">
                                                <PathIcon Data="{x:Static icons:Icons.Rename}" Width="12" Height="12"/>
                                            </Button>
                                            <Button AutomationProperties.Name="{loc:Loc ui.006}" Grid.Column="3" Tag="{Binding}"
                                                    Classes="ghost sidebar-item-action tag-normal-action"
                                                    ToolTip.Tip="{loc:Loc ui.006}"
                                                    PointerPressed="OnUnpinPointerPressed"
                                                    Click="DeleteTag" IsVisible="{Binding IsCustom}">
                                                <PathIcon Data="{x:Static icons:Icons.Delete}" Width="12" Height="12"/>
                                            </Button>
                                            <Button AutomationProperties.Name="{loc:Loc ui.323}" Grid.Column="2" Grid.ColumnSpan="2"
                                                    Classes="ghost sidebar-inline-confirm tag-confirm-action"
                                                    IsVisible="False"
                                                    Tag="{Binding}"
                                                    ToolTip.Tip="{loc:Loc ui.323}"
                                                    PointerPressed="OnUnpinPointerPressed"
                                                    Click="CommitTagEdit">
                                                <PathIcon Data="{x:Static icons:Icons.Checkmark}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- New tag uses the same complete row as existing items. -->
                        <Border x:Name="NewTagEditorRow"
                                Classes="sidebar-item tag-row"
                                IsVisible="False">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                  Classes="tag-row-content"
                                  Background="Transparent"
                                  VerticalAlignment="Center">
                                <PathIcon Data="{x:Static icons:Icons.Tag}"
                                          Classes="sidebar-icon"/>
                                <TextBox x:Name="NewTagInput"
                                         Grid.Column="1"
                                         Classes="inline-rename-editor tag-name-editor"
                                         Margin="8,0,4,0"
                                         MinWidth="72"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         FontSize="{DynamicResource FontSizeBody}"
                                         KeyDown="OnTagEditorKeyDown"
                                         LostFocus="OnTagEditorLostFocus"/>
                                <Button AutomationProperties.Name="{loc:Loc ui.323}" Grid.Column="2" Grid.ColumnSpan="2"
                                        Classes="ghost sidebar-inline-confirm tag-confirm-action"
                                        ToolTip.Tip="{loc:Loc ui.323}"
                                        PointerPressed="OnUnpinPointerPressed"
                                        Click="CommitTagEdit">
                                    <PathIcon Data="{x:Static icons:Icons.Checkmark}"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ═══ AI 智能 AI ═══ -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Classes="sidebar-section-header sidebar-category-header rail-secondary"
                          x:Name="AiSectionHeader" Focusable="True" FocusAdorner="{StaticResource SidebarGlassFocusAdorner}" AutomationProperties.Name="{loc:Loc ui.316}"
                          PointerPressed="OnToggleAiCollapsed"
                          Cursor="Hand">
                        <TextBlock Grid.Column="0" Text="{loc:Loc ui.131}"
                                   Classes="sidebar-section-title"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Padding="18,4,0,4"/>
                        <PathIcon Grid.Column="2" Data="{x:Static icons:Icons.ChevronRight}"
                                  Classes="sidebar-header-reveal"
                                  Width="10" Height="10"
                                  Foreground="{DynamicResource TextSubtleBrush}"
                                  Margin="0,4,12,4"
                                  x:Name="AiChevron"/>
                    </Grid>

                    <StackPanel Classes="rail-secondary" IsVisible="{Binding !IsAiSectionCollapsed}"
                                x:Name="AiPanel">

                        <!-- People -->
                        <Border Classes="sidebar-item"
                                IsVisible="{Binding ShowSidebarAiPeople}"
                                x:Name="AiPeopleItem"
                                PointerPressed="OnSidebarItemPressed">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <PathIcon Data="{x:Static icons:Icons.People}"
                                          Classes="sidebar-icon"/>
                                <TextBlock Text="{loc:Loc ui.143}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBodyLarge}"/>
                            </StackPanel>
                        </Border>

                        <!-- Categories -->
                        <Border Classes="sidebar-item"
                                IsVisible="{Binding ShowSidebarAiCategories}"
                                x:Name="AiCategoriesItem"
                                PointerPressed="OnSidebarItemPressed">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <PathIcon Data="{x:Static icons:Icons.Grid}"
                                          Classes="sidebar-icon"/>
                                <TextBlock Text="{loc:Loc ui.152}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBodyLarge}"/>
                            </StackPanel>
                        </Border>

                        <!-- Locations -->
                        <Border Classes="sidebar-item"
                                IsVisible="{Binding ShowSidebarAiLocations}"
                                x:Name="AiLocationsItem"
                                PointerPressed="OnSidebarItemPressed">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <PathIcon Data="{x:Static icons:Icons.Location}"
                                          Classes="sidebar-icon"/>
                                <TextBlock Text="{loc:Loc ui.163}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBodyLarge}"/>
                            </StackPanel>
                        </Border>

                        <!-- Dates -->
                        <Border Classes="sidebar-item"
                                IsVisible="{Binding ShowSidebarAiDates}"
                                x:Name="AiDatesItem"
                                PointerPressed="OnSidebarItemPressed">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <PathIcon Data="{x:Static icons:Icons.Calendar}"
                                          Classes="sidebar-icon"/>
                                <TextBlock Text="{loc:Loc ui.200}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBodyLarge}"/>
                            </StackPanel>
                        </Border>

                        <!-- Text Search -->
                        <Border Classes="sidebar-item"
                                IsVisible="{Binding ShowSidebarAiTextSearch}"
                                x:Name="AiTextSearchItem"
                                PointerPressed="OnSidebarItemPressed">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <PathIcon Data="{x:Static icons:Icons.Search}"
                                          Classes="sidebar-icon"/>
                                <TextBlock Text="{loc:Loc ui.196}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBodyLarge}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>


                </StackPanel>
            </ScrollViewer>
</UserControl>
