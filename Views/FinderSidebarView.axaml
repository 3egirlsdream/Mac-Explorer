<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MacExplorer.ViewModels"
             xmlns:models="using:MacExplorer.Models"
             xmlns:icons="using:MacExplorer.Assets"
             xmlns:converters="using:MacExplorer.Converters"
             x:Class="MacExplorer.Views.FinderSidebarView"
             x:DataType="vm:FileListViewModel"
             x:CompileBindings="False"
             DragDrop.AllowDrop="True"
             DragDrop.DragOver="OnPinnedFoldersDragOver"
             DragDrop.DragLeave="OnPinnedFoldersDragLeave"
             DragDrop.Drop="OnPinnedFoldersDrop">

    <UserControl.Resources>
        <converters:StringToGeometryConverter x:Key="StringToGeometry"/>
        <converters:IsNotEmptyConverter x:Key="IsNotEmpty"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="PathIcon.sidebar-icon">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
        </Style>
        <Style Selector="Border.sidebar-item.pin-drop-target">
            <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="4,8,4,4">

                    <!-- ═══ 收藏 Favorites ═══ -->
                    <!-- <TextBlock Classes="sidebar-section-title" Text="收藏"/> -->

                    <!-- Username -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarUsername}"
                            x:Name="UsernameItem"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.Person}"
                                      Classes="sidebar-icon" Foreground="#54A3F7"/>
                            <TextBlock Text="{Binding UserName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Desktop -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarDesktop}"
                            x:Name="DesktopItem"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.Desktop}"
                                      Classes="sidebar-icon" Foreground="#54A3F7"/>
                            <TextBlock Text="{Binding DesktopName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Documents -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarDocuments}"
                            x:Name="DocumentsItem"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.FileText}"
                                      Classes="sidebar-icon" Foreground="#3B82F6"/>
                            <TextBlock Text="{Binding DocumentsName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Downloads -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarDownloads}"
                            x:Name="DownloadsItem"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.Download}"
                                      Classes="sidebar-icon" Foreground="#22C55E"/>
                            <TextBlock Text="{Binding DownloadsName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Pictures -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarPictures}"
                            x:Name="PicturesItem"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.Image}"
                                      Classes="sidebar-icon" Foreground="#E8912D"/>
                            <TextBlock Text="{Binding PicturesName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Music -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarMusic}"
                            x:Name="MusicItem"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.Music}"
                                      Classes="sidebar-icon" Foreground="#EC4899"/>
                            <TextBlock Text="{Binding MusicName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Pinned folders (kept from existing, already working) -->
                    <ItemsControl x:Name="PinnedFoldersControl" Classes="sidebar-items"
                                  ItemsSource="{Binding PinnedFolders}"
                                  MinHeight="8"
                                  >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PinnedFolder">
                                <Border Classes="sidebar-item"
                                        Tag="{Binding FolderPath}"
                                        PointerPressed="OnPinnedFolderPressed">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Background="Transparent">
                                            <PathIcon Data="{x:Static icons:Icons.Folder}"
                                                      Classes="sidebar-icon" Foreground="#F59E0B"/>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                            Classes="ghost sidebar-item-action pinned-unpin"
                                            Tag="{Binding FolderPath}"
                                            ToolTip.Tip="取消固定"
                                            PointerPressed="OnUnpinPointerPressed"
                                            Click="UnpinFolder">
                                            <PathIcon Data="{x:Static icons:Icons.Pin}"
                                                      Width="12" Height="12"
                                                      Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ═══ 位置 Locations ═══ -->
                    <TextBlock Classes="sidebar-section-title" Text="位置"/>

                    <!-- Macintosh HD -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarMacintoshHd}"
                            x:Name="VolumeItem"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.ExternalDrive}"
                                      Classes="sidebar-icon" Foreground="#22D3EE"/>
                            <TextBlock Text="{Binding VolumeName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- External volumes -->
                    <ItemsControl Classes="sidebar-items"
                                  ItemsSource="{Binding ExternalVolumes}"
                                  IsVisible="{Binding ExternalVolumes, Converter={StaticResource IsNotEmpty}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:VolumeInfo">
                                <Border Classes="sidebar-item"
                                        Tag="{Binding .}"
                                        PointerPressed="OnVolumePressed">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Background="Transparent">
                                            <PathIcon Data="{x:Static icons:Icons.ExternalDrive}"
                                                      Classes="sidebar-icon" Foreground="#F97316"/>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="ghost sidebar-item-action"
                                                Tag="{Binding .}"
                                                ToolTip.Tip="推出"
                                                PointerPressed="OnUnpinPointerPressed"
                                                Click="EjectVolume">
                                            <PathIcon Data="{x:Static icons:Icons.Eject}"
                                                      Width="12" Height="12"
                                                      Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Applications -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarApplications}"
                            x:Name="ApplicationsItem"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.Apps}"
                                      Classes="sidebar-icon" Foreground="#818CF8"/>
                            <TextBlock Text="{Binding ApplicationsName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Trash -->
                    <Border Classes="sidebar-item"
                            IsVisible="{Binding ShowSidebarTrash}"
                            x:Name="TrashItem"
                            PointerPressed="OnSidebarItemPressed">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <PathIcon Data="{x:Static icons:Icons.Trash}"
                                      Classes="sidebar-icon" Foreground="#A78BFA"/>
                            <TextBlock Text="{Binding TrashName}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ 远程服务器 Remote Servers ═══ -->
                    <Grid ColumnDefinitions="Auto,*"
                          Margin="0,8,0,2"
                          x:Name="RemoteServersHeader"
                          IsVisible="False">
                        <TextBlock Grid.Column="0" Text="远程服务器"
                                   Classes="sidebar-section-title"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Padding="18,4,0,4"/>
                    </Grid>

                    <!-- Remote server list -->
                    <ItemsControl x:Name="RemoteServersList" Classes="sidebar-items" IsVisible="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="sidebar-item"
                                        Tag="{Binding}"
                                        PointerPressed="OnRemoteServerPressed">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                                        <!-- Connection status dot -->
                                        <Grid Grid.Column="0" Width="6" Height="6" Margin="0,0,6,0"
                                              VerticalAlignment="Center">
                                            <Ellipse Fill="{DynamicResource ColorSuccess}"
                                                     IsVisible="{Binding IsConnected}"/>
                                            <Ellipse Fill="{DynamicResource TextDisabledBrush}"
                                                     IsVisible="{Binding !IsConnected}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Background="Transparent"
                                                    Margin="0">
                                            <PathIcon Data="{x:Static icons:Icons.ExternalDrive}"
                                                      Classes="sidebar-icon" Foreground="#06B6D4"/>
                                            <StackPanel Margin="6,0,0,0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBodyLarge}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding StatusText}"
                                                           Classes="sidebar-secondary-text"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Classes="ghost sidebar-item-action"
                                                Tag="{Binding}"
                                                ToolTip.Tip="断开连接"
                                                PointerPressed="OnUnpinPointerPressed"
                                                Click="OnDisconnectRemoteServer">
                                            <PathIcon Data="{x:Static icons:Icons.Delete}"
                                                      Width="12" Height="12"
                                                      Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ═══ AI 智能 AI ═══ -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          x:Name="AiSectionHeader"
                          Classes="sidebar-section-header"
                          Margin="0,8,0,2"
                          PointerPressed="OnToggleAiCollapsed"
                          Cursor="Hand">
                        <TextBlock Grid.Column="0" Text="AI 智能"
                                   Classes="sidebar-section-title"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Padding="18,4,0,4"/>
                        <PathIcon Grid.Column="2" Data="{x:Static icons:Icons.ChevronRight}"
                                  Classes="sidebar-header-reveal"
                                  Width="10" Height="10"
                                  Foreground="{DynamicResource TextSubtleBrush}"
                                  Margin="0,4,12,4"
                                  x:Name="AiChevron"/>
                    </Grid>

                    <StackPanel IsVisible="{Binding !IsAiSectionCollapsed}"
                                x:Name="AiPanel">

                        <!-- People -->
                        <Border Classes="sidebar-item"
                                IsVisible="{Binding ShowSidebarAiPeople}"
                                x:Name="AiPeopleItem"
                                PointerPressed="OnSidebarItemPressed">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <PathIcon Data="{x:Static icons:Icons.People}"
                                          Classes="sidebar-icon" Foreground="#EC4899"/>
                                <TextBlock Text="人物" Margin="8,0,0,0"
                                           VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBodyLarge}"/>
                            </StackPanel>
                        </Border>

                        <!-- Categories -->
                        <Border Classes="sidebar-item"
                                IsVisible="{Binding ShowSidebarAiCategories}"
                                x:Name="AiCategoriesItem"
                                PointerPressed="OnSidebarItemPressed">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <PathIcon Data="{x:Static icons:Icons.Grid}"
                                          Classes="sidebar-icon" Foreground="#8B5CF6"/>
                                <TextBlock Text="分类" Margin="8,0,0,0"
                                           VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBodyLarge}"/>
                            </StackPanel>
                        </Border>

                        <!-- Locations -->
                        <Border Classes="sidebar-item"
                                IsVisible="{Binding ShowSidebarAiLocations}"
                                x:Name="AiLocationsItem"
                                PointerPressed="OnSidebarItemPressed">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <PathIcon Data="{x:Static icons:Icons.Location}"
                                          Classes="sidebar-icon" Foreground="#EF4444"/>
                                <TextBlock Text="地点" Margin="8,0,0,0"
                                           VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBodyLarge}"/>
                            </StackPanel>
                        </Border>

                        <!-- Dates -->
                        <Border Classes="sidebar-item"
                                IsVisible="{Binding ShowSidebarAiDates}"
                                x:Name="AiDatesItem"
                                PointerPressed="OnSidebarItemPressed">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <PathIcon Data="{x:Static icons:Icons.Calendar}"
                                          Classes="sidebar-icon" Foreground="#F59E0B"/>
                                <TextBlock Text="日期" Margin="8,0,0,0"
                                           VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBodyLarge}"/>
                            </StackPanel>
                        </Border>

                        <!-- Text Search -->
                        <Border Classes="sidebar-item"
                                IsVisible="{Binding ShowSidebarAiTextSearch}"
                                x:Name="AiTextSearchItem"
                                PointerPressed="OnSidebarItemPressed">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <PathIcon Data="{x:Static icons:Icons.Search}"
                                          Classes="sidebar-icon" Foreground="#3B82F6"/>
                                <TextBlock Text="文字搜索" Margin="8,0,0,0"
                                           VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBodyLarge}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══ 收藏夹 Collections ═══ -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                          x:Name="CollectionsSectionHeader"
                          Classes="sidebar-section-header"
                          Margin="0,8,0,2"
                          PointerPressed="OnToggleCollectionsCollapsed">
                        <TextBlock Grid.Column="0" Text="收藏夹"
                                   Classes="sidebar-section-title"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Padding="18,4,0,4"
                                   Cursor="Hand"/>
                        <Button Grid.Column="2"
                                x:Name="AddCollectionBtn"
                                Classes="ghost sidebar-header-action"
                                Background="Transparent" BorderThickness="0"
                                Padding="4" Margin="0,2,6,2"
                                PointerPressed="OnUnpinPointerPressed"
                                Click="StartNewCollection"
                                ToolTip.Tip="新建收藏夹">
                            <PathIcon Data="{x:Static icons:Icons.Plus}"
                                      Width="10" Height="10"
                                      Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        <PathIcon Grid.Column="3" Data="{x:Static icons:Icons.ChevronRight}"
                                  Classes="sidebar-header-reveal"
                                  Width="10" Height="10"
                                  Foreground="{DynamicResource TextSubtleBrush}"
                                  Margin="0,4,12,4"
                                  x:Name="CollChevron"/>
                    </Grid>

                    <StackPanel IsVisible="{Binding !IsCollectionsSectionCollapsed}"
                                x:Name="CollectionsPanel">

                        <!-- Collection list -->
                        <ItemsControl x:Name="CollectionItems"
                                      Classes="sidebar-items"
                                      ItemsSource="{Binding Collections}"
                                      IsVisible="{Binding Collections, Converter={StaticResource IsNotEmpty}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Collection">
                                    <Border Classes="sidebar-item collection-row"
                                            Tag="{Binding}"
                                            PointerPressed="OnCollectionPressed">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                              Classes="collection-row-content"
                                              Background="Transparent"
                                              VerticalAlignment="Center">
                                            <PathIcon Data="{x:Static icons:Icons.Folder}"
                                                      Classes="sidebar-icon" Foreground="#F59E0B"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       Classes="collection-name-label"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBodyLarge}"/>
                                            <TextBox Grid.Column="1"
                                                     Classes="inline-rename-editor collection-name-editor"
                                                     Tag="{Binding}"
                                                     IsVisible="False"
                                                     Margin="8,0,4,0"
                                                     MinWidth="72"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     FontSize="{DynamicResource FontSizeBody}"
                                                     KeyDown="OnCollectionEditorKeyDown"
                                                     LostFocus="OnCollectionEditorLostFocus"/>
                                            <Button Grid.Column="2" Tag="{Binding}"
                                                    Classes="ghost sidebar-item-action collection-normal-action"
                                                    ToolTip.Tip="重命名"
                                                    PointerPressed="OnUnpinPointerPressed"
                                                    Click="RenameCollection">
                                                <PathIcon Data="{x:Static icons:Icons.Rename}" Width="12" Height="12"/>
                                            </Button>
                                            <Button Grid.Column="3" Tag="{Binding}"
                                                    Classes="ghost sidebar-item-action collection-normal-action"
                                                    ToolTip.Tip="删除"
                                                    PointerPressed="OnUnpinPointerPressed"
                                                    Click="DeleteCollection">
                                                <PathIcon Data="{x:Static icons:Icons.Delete}" Width="12" Height="12"/>
                                            </Button>
                                            <Button Grid.Column="2" Grid.ColumnSpan="2"
                                                    Classes="ghost sidebar-inline-confirm collection-confirm-action"
                                                    IsVisible="False"
                                                    Tag="{Binding}"
                                                    ToolTip.Tip="确认"
                                                    PointerPressed="OnUnpinPointerPressed"
                                                    Click="CommitCollectionEdit">
                                                <PathIcon Data="{x:Static icons:Icons.Checkmark}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- New collection uses the same complete row as existing items. -->
                        <Border x:Name="NewCollectionEditorRow"
                                Classes="sidebar-item collection-row"
                                IsVisible="False">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                  Classes="collection-row-content"
                                  Background="Transparent"
                                  VerticalAlignment="Center">
                                <PathIcon Data="{x:Static icons:Icons.CollectionAdd}"
                                          Classes="sidebar-icon" Foreground="#F59E0B"/>
                                <TextBox x:Name="NewCollectionInput"
                                         Grid.Column="1"
                                         Classes="inline-rename-editor collection-name-editor"
                                         Margin="8,0,4,0"
                                         MinWidth="72"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         FontSize="{DynamicResource FontSizeBody}"
                                         KeyDown="OnCollectionEditorKeyDown"
                                         LostFocus="OnCollectionEditorLostFocus"/>
                                <Button Grid.Column="2" Grid.ColumnSpan="2"
                                        Classes="ghost sidebar-inline-confirm collection-confirm-action"
                                        ToolTip.Tip="确认"
                                        PointerPressed="OnUnpinPointerPressed"
                                        Click="CommitCollectionEdit">
                                    <PathIcon Data="{x:Static icons:Icons.Checkmark}"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ═══ 标签 Tags ═══ -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          x:Name="TagsSectionHeader"
                          Classes="sidebar-section-header"
                          Margin="0,8,0,2"
                          PointerPressed="OnToggleTagsCollapsed"
                          Cursor="Hand">
                        <TextBlock Grid.Column="0" Text="标签"
                                   Classes="sidebar-section-title"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Padding="18,4,0,4"/>
                        <PathIcon Grid.Column="2" Data="{x:Static icons:Icons.ChevronRight}"
                                  Classes="sidebar-header-reveal"
                                  Width="10" Height="10"
                                  Foreground="{DynamicResource TextSubtleBrush}"
                                  Margin="0,4,12,4"
                                  x:Name="TagsChevron"/>
                    </Grid>

                    <ItemsControl Classes="sidebar-items"
                                  ItemsSource="{Binding SidebarTags}"
                                  IsVisible="{Binding !IsTagsSectionCollapsed}"
                                  x:Name="TagsPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:FileTag">
                                <Border Classes="sidebar-item"
                                        Tag="{Binding}"
                                        PointerPressed="OnTagPressed">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                                        <Grid Grid.Column="0" Width="15" Height="15">
                                            <Ellipse Width="9" Height="9"
                                                     Fill="{Binding ColorHex}"
                                                     IsVisible="{Binding IsFinderColor}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                            <PathIcon Data="{x:Static icons:Icons.Tag}"
                                                      Classes="sidebar-icon"
                                                      Foreground="{Binding ColorHex}"
                                                      IsVisible="{Binding IsCustom}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBodyLarge}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
</UserControl>
