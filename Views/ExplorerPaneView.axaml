<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MacExplorer.ViewModels"
             xmlns:local="using:MacExplorer.Views"
             xmlns:icons="using:MacExplorer.Assets"
             x:Class="MacExplorer.Views.ExplorerPaneView"
             x:DataType="vm:ExplorerTabViewModel"
             x:CompileBindings="False">
    <UserControl.Styles>
        <Style Selector="Border.pane-surface">
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.pane-surface.active">
            <!-- The active pane should not look like a focused input control.
                 Keep the same neutral edge as every other pane instead of a
                 bright blue outline. -->
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.pane-nav">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.pane-nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        </Style>
    </UserControl.Styles>

    <Border x:Name="PaneSurface" Classes="pane-surface" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
            <Border x:Name="PaneHeader" Grid.Row="0" Height="31"
                    BorderBrush="{DynamicResource ColorBorderSubtle}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="5,2">
                    <Button Grid.Column="0" Classes="pane-nav" Click="NavigateBack"
                            IsEnabled="{Binding FileList.CanGoBack}" ToolTip.Tip="后退">
                        <PathIcon Data="{x:Static icons:Icons.Back}" Width="11" Height="11"/>
                    </Button>
                    <Button Grid.Column="1" Classes="pane-nav" Click="NavigateForward"
                            IsEnabled="{Binding FileList.CanGoForward}" ToolTip.Tip="前进">
                        <PathIcon Data="{x:Static icons:Icons.Forward}" Width="11" Height="11"/>
                    </Button>
                    <Button Grid.Column="2" Classes="pane-nav" Click="NavigateUp" ToolTip.Tip="上级目录">
                        <PathIcon Data="{x:Static icons:Icons.Up}" Width="11" Height="11"/>
                    </Button>
                    <local:BreadcrumbBar Grid.Column="3" DataContext="{Binding FileList}"
                                         Margin="4,0,0,0" MinWidth="80"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <local:FileListView x:Name="FileListControl" DataContext="{Binding FileList}"/>
                <local:HomeView x:Name="HomeViewControl" DataContext="{Binding FileList}" IsVisible="False"/>
                <local:AiView x:Name="AiViewControl" DataContext="{Binding FileList}" IsVisible="False"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
