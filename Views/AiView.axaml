<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MacExplorer.ViewModels"
             xmlns:icons="using:MacExplorer.Assets"
             xmlns:local="using:MacExplorer.Views"
             x:Class="MacExplorer.Views.AiView"
             x:DataType="vm:FileListViewModel"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource ColorBgContent}">
        <Border Grid.Row="0" Padding="16,12" Background="Transparent">
            <Border Classes="ai-search-box">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Grid.Column="0" Data="{x:Static icons:Icons.Search}"
                          Width="18" Height="18" Margin="0,0,10,0"
                          Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox Grid.Column="1" x:Name="AiSearchBox"
                         Classes="search-input"
                         PlaceholderText="搜索图片中识别的文字..."
                         KeyDown="OnAiSearchKeyDown"/>
                <Button Grid.Column="2" x:Name="ClearSearchButton" AutomationProperties.Name="清除文字搜索" ToolTip.Tip="清除文字搜索"
                        Classes="ghost close-btn"
                        Width="28" Height="28" MinHeight="28" IsVisible="False"
                        Background="Transparent" BorderThickness="0"
                        Click="ClearSearch">
                    <PathIcon Data="{x:Static icons:Icons.Close}" Width="16" Height="16"/>
                </Button>
            </Grid>
            </Border>
        </Border>

        <Grid Grid.Row="1">
            <local:FileListView x:Name="ResultsView" DataContext="{Binding}" IsVisible="False"/>

            <ScrollViewer x:Name="TokenView">
                <StackPanel Margin="20" Spacing="14">
                    <TextBlock Text="热门文字" FontSize="{DynamicResource FontSizeHeading}" FontWeight="{StaticResource FontWeightSemibold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="选择 AI 从图片中识别出的文字，或在上方输入关键词搜索。"
                               FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <WrapPanel x:Name="TextTokensPanel"/>
                    <StackPanel x:Name="EmptyState" Margin="0,70,0,0"
                                HorizontalAlignment="Center" Spacing="8">
                        <PathIcon Data="{x:Static icons:Icons.FileText}" Width="48" Height="48"
                                  Opacity="0.3" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyTitle" Text="还没有可搜索的识别内容"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="EmptyHint" Text="开启 AI 智能分析后，浏览图片文件夹以建立文字索引"
                                   FontSize="{DynamicResource FontSizeLabel}" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
