<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:MacExplorer.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MacExplorer.ViewModels"
             xmlns:icons="using:MacExplorer.Assets"
             xmlns:local="using:MacExplorer.Views"
             x:Class="MacExplorer.Views.AiView"
             x:DataType="vm:FileListViewModel"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource ColorBgContent}">
        <Border Grid.Row="0" Padding="16,12,16,0" Background="Transparent">
            <Border Classes="ai-search-box">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Grid.Column="0" Data="{x:Static icons:Icons.Search}"
                          Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox Grid.Column="1" x:Name="AiSearchBox"
                         Classes="search-input"
                         MinHeight="30" Padding="0,3" VerticalContentAlignment="Center"
                         FontSize="{DynamicResource FontSizeLabel}"
                         AutomationProperties.Name="{loc:Loc ui.423}"
                         PlaceholderText="{loc:Loc ui.424}"
                         KeyDown="OnAiSearchKeyDown"/>
                <Button Grid.Column="2" x:Name="ClearSearchButton" AutomationProperties.Name="{loc:Loc ui.425}" ToolTip.Tip="{loc:Loc ui.425}"
                        Classes="ghost close-btn"
                        Width="28" Height="28" MinHeight="28" IsVisible="False"
                        Background="Transparent" BorderThickness="0"
                        Click="ClearSearch">
                    <PathIcon Data="{x:Static icons:Icons.Close}" Width="16" Height="16"/>
                </Button>
            </Grid>
            </Border>
        </Border>

        <Grid Grid.Row="1">
            <local:FileListView x:Name="ResultsView" DataContext="{Binding}" IsVisible="False"/>

            <ScrollViewer x:Name="TokenView" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,12,16,16" Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MinHeight="22"
                          ToolTip.Tip="{loc:Loc ui.426}">
                        <TextBlock Text="{loc:Loc ui.427}" FontSize="{DynamicResource FontSizeLabel}"
                                   FontWeight="{StaticResource FontWeightSemibold}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{loc:Loc ui.428}" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                    <WrapPanel x:Name="TextTokensPanel"/>
                    <StackPanel x:Name="EmptyState" Margin="0,70,0,0"
                                HorizontalAlignment="Center" Spacing="8">
                        <PathIcon Data="{x:Static icons:Icons.FileText}" Width="48" Height="48"
                                  Opacity="0.3" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyTitle" Text="{loc:Loc ui.429}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="EmptyHint" Text="{loc:Loc ui.430}"
                                   FontSize="{DynamicResource FontSizeLabel}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
