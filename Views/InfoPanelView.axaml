<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:MacExplorer.Controls"
             xmlns:loc="using:MacExplorer.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MacExplorer.ViewModels"
             xmlns:models="using:MacExplorer.Models"
             xmlns:icons="using:MacExplorer.Assets"
             x:Class="MacExplorer.Views.InfoPanelView"
             x:DataType="vm:FileListViewModel"
             x:CompileBindings="False">

    <Border x:Name="InfoPanelRoot" Classes="info-panel" ClipToBounds="True"
            BorderBrush="{DynamicResource WorkspaceDividerBrush}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">
                <!-- Header with preview controls -->
                <DockPanel Grid.Row="0" Margin="16,0" MinHeight="40" LastChildFill="True">
                    <controls:AppButton DockPanel.Dock="Right" x:Name="ClosePanelBtn" AutomationProperties.Name="{loc:Loc ui.569}" ToolTip.Tip="{loc:Loc ui.569}"
                            Classes="ghost info-panel-icon" Click="ClosePanel" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <PathIcon Data="{x:Static icons:Icons.Close}" Width="11" Height="11"
                                  Foreground="{DynamicResource TextMutedBrush}"/>
                    </controls:AppButton>
                    <controls:AppButton DockPanel.Dock="Right" x:Name="ExpandPreviewBtn" AutomationProperties.Name="{loc:Loc ui.570}"
                            Classes="ghost info-panel-icon" Margin="0,0,6,0" Click="TogglePreviewExpanded"
                            ToolTip.Tip="{loc:Loc ui.570}" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <PathIcon x:Name="ExpandPreviewIcon"
                                  Data="{x:Static icons:Icons.ExpandPreview}"
                                  Width="11" Height="11"
                                  Foreground="{DynamicResource TextMutedBrush}"/>
                    </controls:AppButton>
                    <TextBlock x:Name="PanelTitle" Text="{loc:Loc ui.571}" FontWeight="{StaticResource FontWeightMedium}" FontSize="{DynamicResource FontSizeBodyLarge}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>

            <ScrollViewer Grid.Row="1">
              <StackPanel Spacing="0">
                <!-- Type-aware preview host -->
                <Border x:Name="PreviewImageArea" Classes="workspace-preview-surface" Margin="14,10,14,0"
                        MinHeight="160" MaxHeight="220"
                        ClipToBounds="True">
                    <Panel>
                        <Image x:Name="PreviewImage" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="PreviewFileIcon" IsVisible="False" Width="96" Height="96"
                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox x:Name="PreviewText"
                                 IsVisible="False" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" FontFamily="{StaticResource FontFamilyMono}"
                                 FontSize="{DynamicResource FontSizeLabel}" Padding="12,32,12,12" BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Top"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <TextBlock x:Name="PreviewPlaceholder"
                                   Text="{loc:Loc ui.572}" FontSize="{DynamicResource FontSizeBody}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <Border x:Name="PreviewKindBadge" IsVisible="False"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="8" Padding="7,3" CornerRadius="6"
                                Background="{DynamicResource WorkspacePreviewBadgeBrush}">
                            <TextBlock x:Name="PreviewKindText" FontSize="{DynamicResource FontSizeMeta}" Foreground="{DynamicResource TextOnAccentBrush}"/>
                        </Border>
                        <controls:AppButton AutomationProperties.Name="{loc:Loc ui.573}" x:Name="CopyImageTextBtn" IsVisible="False"
                                Classes="ghost compact preview-action" Click="CopyImageText"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="8"
                                Content="{loc:Loc ui.574}"
                                ToolTip.Tip="{loc:Loc ui.573}">
                        </controls:AppButton>
                    </Panel>
                </Border>

                <StackPanel x:Name="PreviewFeedback" Margin="16,10,16,0" Spacing="8" IsVisible="False">
                    <TextBlock x:Name="PreviewFeedbackText" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <controls:AppButton x:Name="RetryPreviewButton" Content="{loc:Loc ui.093}" Classes="secondary compact" Click="RetryPreview" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel x:Name="DetailsPanel" Spacing="0" IsVisible="False">
                    <TextBlock x:Name="SelectedFileName" Margin="8,16,8,0" FontSize="{DynamicResource FontSizeBodyLarge}" FontWeight="{StaticResource FontWeightSemibold}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SelectedFileSummary" Margin="8,2,8,0" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <!-- Metadata sections share one scrolling page. -->
                <StackPanel Margin="8,12,8,0">
                    <TextBlock Text="{loc:Loc ui.571}" Classes="info-section-title"/>
                    <Border Classes="info-field-row">
                        <Grid ColumnDefinitions="72,*">
                            <TextBlock Text="{loc:Loc ui.444}" Classes="info-field-label"/>
                            <TextBlock Grid.Column="1" x:Name="InfoCreated" Text="—" Classes="info-field-value"/>
                        </Grid>
                    </Border>
                    <Border Classes="info-field-row">
                        <Grid ColumnDefinitions="72,*">
                            <TextBlock Text="{loc:Loc ui.003}" Classes="info-field-label"/>
                            <TextBlock Grid.Column="1" x:Name="InfoModified" Text="—" Classes="info-field-value"/>
                        </Grid>
                    </Border>
                    <Border Classes="info-field-row">
                        <Grid ColumnDefinitions="72,*">
                            <TextBlock Text="{loc:Loc ui.575}" Classes="info-field-label"/>
                            <TextBlock Grid.Column="1" x:Name="InfoPath" Text="—" Classes="info-field-value"/>
                        </Grid>
                    </Border>
                    <Border Classes="info-field-row">
                        <Grid ColumnDefinitions="72,*">
                            <TextBlock Text="{loc:Loc ui.013}" Classes="info-field-label"/>
                            <TextBlock Grid.Column="1" x:Name="InfoSize" Text="—" Classes="info-field-value"/>
                        </Grid>
                    </Border>
                    <Border Classes="info-field-row">
                        <Grid ColumnDefinitions="72,*">
                            <TextBlock Text="{loc:Loc ui.025}" Classes="info-field-label"/>
                            <TextBlock Grid.Column="1" x:Name="InfoType" Text="—" Classes="info-field-value"/>
                        </Grid>
                    </Border>
                    <Border Classes="info-field-row">
                        <Grid ColumnDefinitions="72,*">
                            <TextBlock Text="{loc:Loc ui.576}" Classes="info-field-label"/>
                            <TextBlock Grid.Column="1" x:Name="InfoAccessed" Text="—" Classes="info-field-value"/>
                        </Grid>
                    </Border>
                    <Border Classes="info-field-row">
                        <Grid ColumnDefinitions="72,*,Auto">
                            <TextBlock Text="SHA-256" Classes="info-field-label"/>
                            <TextBlock Grid.Column="1" x:Name="InfoHash" Text="—" Classes="info-field-value" Margin="0,0,4,0"/>
                            <controls:AppButton Grid.Column="2" x:Name="ComputeHashBtn" IsVisible="False"
                                    Content="{loc:Loc ui.577}" Classes="ghost compact small"
                                    AutomationProperties.Name="{loc:Loc ui.578}"
                                    VerticalAlignment="Center" Click="ComputeHash"/>
                            <controls:AppButton Grid.Column="2" x:Name="CopyHashBtn" IsVisible="False"
                                    AutomationProperties.Name="{loc:Loc ui.579}" ToolTip.Tip="{loc:Loc ui.579}"
                                    Classes="ghost info-panel-icon" Margin="2,0,0,0"
                                    VerticalAlignment="Center" Click="CopyHash">
                                <PathIcon Data="{x:Static icons:Icons.Copy}" Width="11" Height="11"
                                          Foreground="{DynamicResource TextMutedBrush}"/>
                            </controls:AppButton>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Margin="8,16,8,0">
                    <TextBlock Text="{loc:Loc ui.580}" Classes="info-section-title"/>
                    <TextBlock x:Name="ExifNoDataLabel" Text="{loc:Loc ui.581}" FontSize="{DynamicResource FontSizeLabel}"
                               Foreground="{DynamicResource TextMutedBrush}" IsVisible="False"/>
                    <StackPanel x:Name="ExifFieldsPanel"/>
                </StackPanel>

                <!-- Tags Section -->
                <StackPanel Margin="8,16,8,0" Spacing="8">
                    <TextBlock Text="{loc:Loc ui.322}" Classes="info-section-title" Margin="0"/>

                    <!-- System color tags (Apple style) -->
                    <StackPanel x:Name="SystemTagsPanel" Spacing="6" Orientation="Horizontal"/>

                    <!-- Custom tags -->
                    <WrapPanel x:Name="CustomTagsPanel"/>

                    <!-- Add tag input -->
                    <Border Margin="0,2,0,0">
                        <TextBox x:Name="TagInput" AutomationProperties.Name="{loc:Loc ui.372}"
                                 PlaceholderText="{loc:Loc ui.582}"
                                 TextChanged="OnTagInputTextChanged" GotFocus="OnTagInputGotFocus"
                                 LostFocus="OnTagInputLostFocus"
                                 KeyDown="OnTagInputKeyDown"/>
                    </Border>
                    <Popup x:Name="TagSuggestionsPopup" PlacementTarget="{Binding #TagInput}"
                           Placement="BottomEdgeAlignedLeft" HorizontalOffset="-12" VerticalOffset="-10"
                           IsLightDismissEnabled="False" WindowManagerAddShadowHint="False">
                        <Border x:Name="TagSuggestionsSurface" Classes="context-submenu-surface">
                            <ListBox x:Name="TagSuggestions" Classes="omnibox-suggestions tag-suggestions"
                                     MaxHeight="240" KeyDown="OnTagInputKeyDown" LostFocus="OnTagInputLostFocus"
                                     Tapped="OnTagSuggestionTapped"
                                     AutomationProperties.Name="{loc:Loc tags.matches}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileTag">
                                        <Grid ColumnDefinitions="16,*" ColumnSpacing="8" Background="Transparent"
                                              ToolTip.Tip="{Binding Name}">
                                            <PathIcon Data="{x:Static icons:Icons.Tag}" Width="14" Height="14"
                                                      Foreground="{Binding ColorHex}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- Quick Actions -->
                <Border Height="1" Background="{DynamicResource WorkspaceDividerBrush}" Margin="8,16,8,12"/>
                <StackPanel Margin="8,0,8,14" Spacing="8">
                    <TextBlock Text="{loc:Loc ui.583}" Classes="info-section-title" Margin="0"/>
                    <controls:AppButton Classes="ghost info-quick-action" Click="CopyPath" AutomationProperties.Name="{loc:Loc ui.355}">
                        <Grid ColumnDefinitions="24,*">
                            <PathIcon Grid.Column="0" Data="{x:Static icons:Icons.CopyPath}"
                                      Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc ui.355}" FontSize="{DynamicResource FontSizeBody}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </controls:AppButton>
                    <controls:AppButton Classes="ghost info-quick-action" Click="OpenInTerminal" AutomationProperties.Name="{loc:Loc ui.584}">
                        <Grid ColumnDefinitions="24,*">
                            <PathIcon Grid.Column="0" Data="{x:Static icons:Icons.Terminal}"
                                      Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc ui.584}" FontSize="{DynamicResource FontSizeBody}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </controls:AppButton>
                    <controls:AppButton Classes="ghost info-quick-action" Click="CompressFile" AutomationProperties.Name="{loc:Loc ui.354}">
                        <Grid ColumnDefinitions="24,*">
                            <PathIcon Grid.Column="0" Data="{x:Static icons:Icons.Compress}"
                                      Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc ui.354}" FontSize="{DynamicResource FontSizeBody}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </controls:AppButton>
                </StackPanel>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
