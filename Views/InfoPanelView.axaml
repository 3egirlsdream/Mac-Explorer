<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MacExplorer.ViewModels"
             xmlns:icons="using:MacExplorer.Assets"
             x:Class="MacExplorer.Views.InfoPanelView"
             x:DataType="vm:FileListViewModel"
             x:CompileBindings="False">

    <Border x:Name="InfoPanelRoot" Classes="info-panel" ClipToBounds="True"
            BorderBrush="{DynamicResource ColorBorderSubtle}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">
                <!-- Header with preview controls -->
                <DockPanel Grid.Row="0" Margin="16,0" MinHeight="40" LastChildFill="True">
                    <Button DockPanel.Dock="Right" x:Name="ClosePanelBtn" AutomationProperties.Name="关闭信息面板" ToolTip.Tip="关闭信息面板"
                            Classes="ghost info-panel-icon"
                            Padding="0" Click="ClosePanel" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <PathIcon Data="{x:Static icons:Icons.Close}" Width="11" Height="11"
                                  Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                    <Button DockPanel.Dock="Right" x:Name="ExpandPreviewBtn" AutomationProperties.Name="展开预览"
                            Classes="ghost info-panel-icon" Margin="0,0,6,0"
                            Padding="0" Click="TogglePreviewExpanded"
                            ToolTip.Tip="展开预览" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <PathIcon x:Name="ExpandPreviewIcon"
                                  Data="{x:Static icons:Icons.ExpandPreview}"
                                  Width="11" Height="11"
                                  Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                    <TextBlock x:Name="PanelTitle" Text="信息" FontWeight="{StaticResource FontWeightMedium}" FontSize="{DynamicResource FontSizeBodyLarge}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>

            <ScrollViewer Grid.Row="1">
              <StackPanel Spacing="0">
                <!-- Type-aware preview host -->
                <Border x:Name="PreviewImageArea" Margin="14,10,14,0" CornerRadius="10"
                        Background="{DynamicResource SurfaceMutedBrush}" MinHeight="160" MaxHeight="220"
                        ClipToBounds="True">
                    <Panel>
                        <Image x:Name="PreviewImage" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="PreviewFileIcon" IsVisible="False" Width="96" Height="96"
                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox x:Name="PreviewText"
                                 IsVisible="False" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" FontFamily="{StaticResource FontFamilyMono}"
                                 FontSize="{DynamicResource FontSizeLabel}" Padding="12,32,12,12" BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Top"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <TextBlock x:Name="PreviewPlaceholder"
                                   Text="选择文件以预览" FontSize="{DynamicResource FontSizeBody}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <Border x:Name="PreviewKindBadge" IsVisible="False"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="8" Padding="7,3" CornerRadius="6"
                                Background="#B8202024">
                            <TextBlock x:Name="PreviewKindText" FontSize="{DynamicResource FontSizeMeta}" Foreground="{DynamicResource TextOnAccentBrush}"/>
                        </Border>
                        <Button AutomationProperties.Name="使用 macOS Vision 识别并复制文字" x:Name="CopyImageTextBtn" IsVisible="False"
                                Classes="ghost compact" Click="CopyImageText"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="8" Padding="9,5" CornerRadius="{DynamicResource InteractionCornerRadius}"
                                Background="#D9202024" Foreground="{DynamicResource TextOnAccentBrush}"
                                Content="复制图片文字" FontSize="{DynamicResource FontSizeLabel}"
                                ToolTip.Tip="使用 macOS Vision 识别并复制文字">
                        </Button>
                    </Panel>
                </Border>

                <StackPanel x:Name="PreviewFeedback" Margin="16,10,16,0" Spacing="8" IsVisible="False">
                    <TextBlock x:Name="PreviewFeedbackText" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button x:Name="RetryPreviewButton" Content="重试" Classes="secondary compact" Click="RetryPreview" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel x:Name="DetailsPanel" Spacing="0" IsVisible="False">
                    <TextBlock x:Name="SelectedFileName" Margin="16,16,16,0" FontSize="{DynamicResource FontSizeHeading}" FontWeight="{StaticResource FontWeightMedium}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SelectedFileSummary" Margin="16,4,16,0" FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <!-- Tabs -->
                <Grid Margin="14,12,14,0" ColumnDefinitions="*,*">
                    <Button Grid.Column="0" x:Name="TabBasicBtn" Content="基本信息"
                            Classes="ghost info-tab-active" Click="SwitchToBasicTab"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Height="32" Padding="0,4"/>
                    <Button Grid.Column="1" x:Name="TabExifBtn" Content="EXIF 信息"
                            Classes="ghost info-tab" Click="SwitchToExifTab"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Height="32" Padding="0,4"/>
                </Grid>

                <!-- Tab: Basic Info -->
                <StackPanel x:Name="BasicTabContent" Margin="16,12,16,0" Spacing="10">
                    <Grid ColumnDefinitions="72,*">
                        <TextBlock Text="位置" FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="InfoPath" Text="—" FontSize="{DynamicResource FontSizeLabel}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="72,*">
                        <TextBlock Text="大小" FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="InfoSize" Text="—" FontSize="{DynamicResource FontSizeLabel}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="72,*">
                        <TextBlock Text="类型" FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="InfoType" Text="—" FontSize="{DynamicResource FontSizeLabel}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="72,*">
                        <TextBlock Text="修改时间" FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="InfoModified" Text="—" FontSize="{DynamicResource FontSizeLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="72,*">
                        <TextBlock Text="创建时间" FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="InfoCreated" Text="—" FontSize="{DynamicResource FontSizeLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="72,*">
                        <TextBlock Text="访问时间" FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="InfoAccessed" Text="—" FontSize="{DynamicResource FontSizeLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Tab: EXIF Info -->
                <StackPanel x:Name="ExifTabContent" IsVisible="False" Margin="14,10,14,0" Spacing="8">
                    <TextBlock x:Name="ExifNoDataLabel" Text="无 EXIF 信息" FontSize="{DynamicResource FontSizeLabel}"
                               Foreground="{DynamicResource TextMutedBrush}" IsVisible="False"/>
                    <StackPanel x:Name="ExifFieldsPanel" Spacing="8"/>
                </StackPanel>

                <!-- Tags Section -->
                <Border Height="1" Background="{DynamicResource ColorDivider}" Margin="16,12"/>
                <StackPanel Margin="16,0" Spacing="8">
                    <TextBlock Text="标签" FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <!-- System color tags (Apple style) -->
                    <StackPanel x:Name="SystemTagsPanel" Spacing="6" Orientation="Horizontal"/>

                    <!-- Custom tags -->
                    <WrapPanel x:Name="CustomTagsPanel"/>

                    <!-- Add tag input -->
                    <Border Margin="0,2,0,0">
                        <TextBox x:Name="TagInput" AutomationProperties.Name="添加标签"
                                 PlaceholderText="添加标签，回车确认"
                                 KeyDown="OnTagInputKeyDown"/>
                    </Border>
                </StackPanel>

                <!-- Quick Actions -->
                <Border Height="1" Background="{DynamicResource ColorDivider}" Margin="14,12"/>
                <StackPanel Margin="14,0,14,14" Spacing="8">
                    <TextBlock Text="快速操作" FontSize="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Classes="ghost info-quick-action" Click="CopyPath" AutomationProperties.Name="复制路径" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="32" Padding="8,4">
                        <Grid ColumnDefinitions="24,*">
                            <PathIcon Grid.Column="0" Data="{x:Static icons:Icons.CopyPath}"
                                      Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="复制路径" FontSize="{DynamicResource FontSizeBody}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </Button>
                    <Button Classes="ghost info-quick-action" Click="OpenInTerminal" AutomationProperties.Name="在终端中打开" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="32" Padding="8,4">
                        <Grid ColumnDefinitions="24,*">
                            <PathIcon Grid.Column="0" Data="{x:Static icons:Icons.Terminal}"
                                      Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="在终端中打开" FontSize="{DynamicResource FontSizeBody}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </Button>
                    <Button Classes="ghost info-quick-action" Click="CompressFile" AutomationProperties.Name="压缩" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="32" Padding="8,4">
                        <Grid ColumnDefinitions="24,*">
                            <PathIcon Grid.Column="0" Data="{x:Static icons:Icons.Compress}"
                                      Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="压缩" FontSize="{DynamicResource FontSizeBody}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </Button>
                </StackPanel>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
