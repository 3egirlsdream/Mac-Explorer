<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MacExplorer</RootNamespace>
    <ApplicationId Condition="'$(DistributionChannel)' == 'Website'">com.thankful.top.macexplorer</ApplicationId>
    <AppStoreBundleId Condition="'$(AppStoreBundleId)' == ''">com.thankful.top.macexplorer.store</AppStoreBundleId>
    <ApplicationId Condition="'$(DistributionChannel)' == 'AppStore'">$(AppStoreBundleId)</ApplicationId>
    <Version>1.0.51</Version>
    <MacOSBuildNumber Condition="'$(MacOSBuildNumber)' == ''">$(Version)</MacOSBuildNumber>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/PrivacyPolicy.txt" LogicalName="MacExplorer.PrivacyPolicy.txt" />
    <AssemblyMetadata Include="PrivacyPolicyUrl" Value="$(PrivacyPolicyUrl)" />
    <AvaloniaResource Include="Assets\**" Exclude="Assets\*.cs;Assets\*.axaml" />
    <Compile Remove="Plugins/**/*.cs" />
    <Compile Remove="Tools/PluginTestFixture/**/*.cs" />
    <Compile Remove="Tests/**/*.cs" />
    <Compile Remove="Tools/Performance/FastListBench/**/*.cs" />
    <Compile Remove="Tools/GlassDemo/**/*.cs" />
    <Compile Remove="ThirdParty/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="Plugins/UI/MacExplorer.PluginUi.csproj" />
    <ProjectReference Include="Plugins/SDK/MacExplorer.PluginSdk.csproj" />
    <ProjectReference Include="Plugins/FileConversion/MacExplorer.FileConversion.Plugin.csproj" ReferenceOutputAssembly="true" />
    <ProjectReference Include="ThirdParty/LiquidGlassAvaloniaUI/LiquidGlassAvaloniaUI.csproj" />
    <None Update="ThirdParty/LiquidGlassAvaloniaUI/LICENSE" TargetPath="LiquidGlassAvaloniaUI.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdParty/Vex/LICENSE" TargetPath="Markdown/Vex.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdParty/Vex/NOTICE.md" TargetPath="Markdown/NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdParty/Vex/FluentIcons.LICENSE.txt" TargetPath="Markdown/FluentIcons.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="ThirdParty/LibRaw/$(RuntimeIdentifier)/libraw.dylib" TargetPath="libraw.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Copilot/Skills/**/SKILL.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="VerifyLibRawArchitecture" BeforeTargets="GetCopyToOutputDirectoryItems" Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <PropertyGroup>
      <_LibRawArchitecture Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">arm64</_LibRawArchitecture>
      <_LibRawArchitecture Condition="'$(RuntimeIdentifier)' == 'osx-x64'">x86_64</_LibRawArchitecture>
      <_LibRawPath>$(MSBuildProjectDirectory)/ThirdParty/LibRaw/$(RuntimeIdentifier)/libraw.dylib</_LibRawPath>
    </PropertyGroup>
    <Error Condition="'$(_LibRawArchitecture)' == ''" Text="Unsupported LibRaw runtime identifier: $(RuntimeIdentifier)" />
    <Error Condition="!Exists('$(_LibRawPath)')" Text="Missing LibRaw library for $(RuntimeIdentifier): $(_LibRawPath)" />
    <Exec Command="lipo '$(_LibRawPath)' -verify_arch $(_LibRawArchitecture)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <!-- Vex editor core, pinned to the host's Avalonia 12.0.4 line. -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="CodeWF.Markdown" Version="12.0.4.3" />
    <PackageReference Include="CodeWF.Markdown.Themes" Version="12.0.4.3" />

    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />

    <PackageReference Include="SharpZipLib" Version="1.4.2" />

    <PackageReference Include="Microsoft.Agents.AI" Version="1.22.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Svg.Skia" Version="5.0.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <!-- Create macOS .app bundle after build (macOS-only: Avalonia Desktop outputs a raw binary, not a bundle) -->
  <Target Name="ValidateStoreSubmission" BeforeTargets="PrepareForBuild" Condition="'$(StoreSubmission)' == 'true'">
    <Error Condition="'$(DistributionChannel)' != 'AppStore'" Text="StoreSubmission requires the AppStore channel."/>
    <Exec Command="python3 Tools/Distribution/verify-release-config.py --identifier '$(AppStoreBundleId)' --policy '$(PrivacyPolicyUrl)'"/>
  </Target>
  <Target Name="BuildMacOSImageAnalysisHelper" AfterTargets="Build" BeforeTargets="CreateMacOSBundle" Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <Exec Command="bash Tools/Distribution/build-helper.sh 'Platforms/MacOS/ImageAnalysisHelper.swift' '$(OutputPath)MacExplorer.ImageAnalysis' '$(_NativeArchitecture)-apple-macosx$(MacOSMinimumVersion)' -framework Vision -framework CoreLocation -framework PDFKit -framework AppKit" />
  </Target>

  <Target Name="BuildMacOSNativeDragHelper" AfterTargets="Build" BeforeTargets="CreateMacOSBundle" Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <Exec Command="clang++ -fobjc-arc -dynamiclib -arch $(_NativeArchitecture) -mmacosx-version-min=$(MacOSMinimumVersion) 'Platforms/MacOS/NativeFileDrag.mm' 'Platforms/MacOS/FileDeliveryStatusItem.mm' 'Platforms/MacOS/KeyboardMonitor.mm' 'Platforms/MacOS/FolderIcon.mm' 'Platforms/MacOS/SandboxAccess.mm' -framework AppKit -framework Foundation -framework Security -framework Quartz -framework CoreServices -o '$(OutputPath)libMacExplorerNativeDrag.dylib'" />
  </Target>

  <Target Name="PackageBuiltInPlugins" AfterTargets="Build" BeforeTargets="CreateMacOSBundle">
    <MSBuild Projects="Plugins/FileConversion/MacExplorer.FileConversion.Plugin.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="_ConversionAssembly" />
    </MSBuild>
    <PropertyGroup>
      <_ConversionPluginOutput>@(_ConversionAssembly->'%(RootDir)%(Directory)')</_ConversionPluginOutput>
    </PropertyGroup>
    <MakeDir Directories="$(OutputPath)BundledPlugins" />
    <Copy SourceFiles="$(_ConversionPluginOutput)MacExplorer.FileConversion" DestinationFolder="$(OutputPath)" />
    <Copy SourceFiles="Plugins/FileConversion/plugin.json" DestinationFiles="$(OutputPath)BuiltInConversion/plugin.json" />
    <ZipDirectory SourceDirectory="$(_ConversionPluginOutput)" DestinationFile="$(OutputPath)BundledPlugins/FileConversion.mexplug" Overwrite="true" />
  </Target>

  <Target Name="BuildMacOSThumbnailHelper" AfterTargets="Build" BeforeTargets="CreateMacOSBundle" Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <Exec Command="bash Tools/Distribution/build-helper.sh 'Platforms/MacOS/ThumbnailHelper.swift' '$(OutputPath)MacExplorer.Thumbnail' '$(_NativeArchitecture)-apple-macosx$(MacOSMinimumVersion)' -framework QuickLookThumbnailing -framework ImageIO -framework UniformTypeIdentifiers" />
  </Target>

  <Target Name="BuildMacOSGitHelper" AfterTargets="Build" BeforeTargets="CreateMacOSBundle" Condition="$([MSBuild]::IsOSPlatform('osx')) and '$(DistributionChannel)' == 'AppStore'">
    <Exec Command="bash Tools/Distribution/build-helper.sh 'Platforms/MacOS/GitHelper.swift' '$(OutputPath)MacExplorer.Git' '$(_NativeArchitecture)-apple-macosx$(MacOSMinimumVersion)'" />
  </Target>

  <Target Name="CopyMacOSAppIconToOutput" AfterTargets="Build" BeforeTargets="CreateMacOSBundle" Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Assets/appicon.icns" DestinationFolder="$(OutputPath)" Condition="Exists('$(MSBuildProjectDirectory)/Assets/appicon.icns')" />
  </Target>

  <Target Name="CreateMacOSBundle" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <Error Condition="'$(DistributionChannel)' == 'AppStore' and '$(AppStoreBundleId)' == ''" Text="Set AppStoreBundleId explicitly; website identity is preserved." />
    <PropertyGroup>
      <_AppBundleName>Mac Explorer.app</_AppBundleName>
      <_AppBundleDir>$(OutputPath)$(_AppBundleName)</_AppBundleDir>
      <_MacOSDir>$(_AppBundleDir)/Contents/MacOS</_MacOSDir>
      <_ResourcesDir>$(_AppBundleDir)/Contents/Resources</_ResourcesDir>
      <_ManagedDir>$(_ResourcesDir)/Managed</_ManagedDir>
      <_FrameworksDir>$(_AppBundleDir)/Contents/Frameworks</_FrameworksDir>
      <_IconSource>$(MSBuildProjectDirectory)/Assets/appicon.icns</_IconSource>
    </PropertyGroup>

    <Message Text="[macOS] Creating .app bundle: $(_AppBundleDir)" Importance="high" />

    <!-- Create dirs -->
    <RemoveDir Directories="$(_AppBundleDir)" Condition="Exists('$(_AppBundleDir)')" />
    <MakeDir Directories="$(_MacOSDir)" />
    <MakeDir Directories="$(_ResourcesDir);$(_ManagedDir);$(_FrameworksDir)" />

    <!-- Copy executable -->
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)" AppHostDestinationPath="$(_MacOSDir)/$(AssemblyName)"
                   AppBinaryName="../Resources/Managed/$(AssemblyName).dll" IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')" Condition="'$(DistributionChannel)' == 'Website'" />
    <Exec Command="clang++ -fobjc-arc -std=c++17 -arch $(_NativeArchitecture) -mmacosx-version-min=$(MacOSMinimumVersion) Platforms/MacOS/StoreLauncher.mm -framework AppKit -o '$(_MacOSDir)/$(AssemblyName)'" Condition="'$(DistributionChannel)' == 'AppStore'" />

    <!-- Copy Info.plist -->
    <Copy SourceFiles="Platforms/MacOS/Info.plist" DestinationFolder="$(_AppBundleDir)/Contents" />
    <Exec Command="/usr/libexec/PlistBuddy -c &quot;Set :CFBundleShortVersionString $(Version)&quot; '$(_AppBundleDir)/Contents/Info.plist'" />
    <Exec Command="/usr/libexec/PlistBuddy -c &quot;Set :CFBundleVersion $(MacOSBuildNumber)&quot; '$(_AppBundleDir)/Contents/Info.plist'" />

    <Exec Command="/usr/libexec/PlistBuddy -c &quot;Set :CFBundleIdentifier $(ApplicationId)&quot; '$(_AppBundleDir)/Contents/Info.plist'" />
    <Exec Command="/usr/libexec/PlistBuddy -c &quot;Set :LSMinimumSystemVersion $(MacOSMinimumVersion)&quot; '$(_AppBundleDir)/Contents/Info.plist'" />
    <!-- Copy icon -->
    <Copy SourceFiles="$(_IconSource)" DestinationFolder="$(_ResourcesDir)" Condition="Exists('$(_IconSource)')" />

    <Copy SourceFiles="Assets/ConversionNotices.txt;Assets/PrivacyPolicy.txt" DestinationFolder="$(_ResourcesDir)" />
    <Exec Command="/usr/libexec/PlistBuddy -c &quot;Add :PrivacyPolicyURL string $(PrivacyPolicyUrl)&quot; '$(_AppBundleDir)/Contents/Info.plist'" />
    <Exec Command="/usr/libexec/PlistBuddy -c &quot;Add :DistributionChannel string $(DistributionChannel)&quot; '$(_AppBundleDir)/Contents/Info.plist'" />
    <ItemGroup><_LegalNotices Include="ThirdParty/Notices/**/*" /></ItemGroup>
    <Copy SourceFiles="@(_LegalNotices)" DestinationFiles="@(_LegalNotices->'$(_ResourcesDir)/Notices/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="LICENSE" DestinationFiles="$(_ResourcesDir)/Notices/Project.LICENSE.txt" />
    <Copy SourceFiles="Assets/localsend-logo.png;Assets/localsend-LICENSE.txt;Assets/localsend-ATTRIBUTION.txt" DestinationFolder="$(_ResourcesDir)/LocalSend" />
    <Copy SourceFiles="ThirdParty/LiquidGlassAvaloniaUI/LICENSE" DestinationFiles="$(_ResourcesDir)/LiquidGlassAvaloniaUI.LICENSE.txt" />
    <Copy SourceFiles="ThirdParty/Vex/LICENSE;ThirdParty/Vex/NOTICE.md;ThirdParty/Vex/FluentIcons.LICENSE.txt" DestinationFolder="$(_ResourcesDir)/Markdown" />
    <Copy SourceFiles="ThirdParty/LibRaw/COPYRIGHT;ThirdParty/LibRaw/LICENSE.LGPL;ThirdParty/LibRaw/LICENSE.CDDL;ThirdParty/LibRaw/SOURCE.md" DestinationFolder="$(_ResourcesDir)/LibRaw" />

    <!-- Keep managed assemblies in resources and actual native code in Frameworks. -->
    <ItemGroup>
      <_BundleFiles Include="$(OutputPath)*.dll" />
      <_NativeLibs Include="$(OutputPath)*.dylib" />
      <_BundleFiles Include="$(OutputPath)*.deps.json" />
      <_BundleFiles Include="$(OutputPath)*.runtimeconfig.json" />
      <_BundleFiles Include="$(OutputPath)*.pdb" />
      <!-- Copy macOS native libraries (Avalonia.Native, Skia, HarfBuzz, SQLite) -->
      <_NativeLibs Include="$(OutputPath)runtimes/osx/native/*.dylib" />
      <_NativeLibs Include="$(OutputPath)runtimes/osx-arm64/native/*.dylib" />
      <_NativeLibs Include="$(OutputPath)runtimes/osx-x64/native/*.dylib" />
      <_NativeHelpers Include="$(OutputPath)MacExplorer.ImageAnalysis" />
      <_NativeHelpers Include="$(OutputPath)MacExplorer.Thumbnail" />
      <_NativeHelpers Include="$(OutputPath)MacExplorer.Git" Condition="'$(DistributionChannel)' == 'AppStore'" />
      <_NativeHelpers Include="$(OutputPath)MacExplorer.FileConversion" />
      <_PluginPackages Include="$(OutputPath)BundledPlugins/*.mexplug" />
      <!-- CodeWF.Markdown resolves its translations relative to the app resources. -->
      <_I18nFiles Include="$(OutputPath)I18n/**/*.json" />
      <_SkillFiles Include="$(OutputPath)Copilot/Skills/**/SKILL.md" />
    </ItemGroup>
    <Copy SourceFiles="@(_BundleFiles)" DestinationFolder="$(_ManagedDir)" />
    <Copy SourceFiles="@(_I18nFiles)" DestinationFiles="@(_I18nFiles->'$(_ResourcesDir)/I18n/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_SkillFiles)" DestinationFiles="@(_SkillFiles->'$(_ManagedDir)/Copilot/Skills/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_NativeLibs)" DestinationFolder="$(_FrameworksDir)" />
    <Exec Command="bash Tools/Distribution/link-native-libraries.sh '$(_FrameworksDir)' '$(_ManagedDir)'" />
    <Copy SourceFiles="@(_NativeHelpers)" DestinationFolder="$(_MacOSDir)" />

    <Copy SourceFiles="@(_PluginPackages)" DestinationFolder="$(_ResourcesDir)/BundledPlugins" Condition="'$(DistributionChannel)' == 'Website'" />
    <Copy SourceFiles="$(OutputPath)BuiltInConversion/plugin.json" DestinationFolder="$(_ResourcesDir)/BuiltInConversion" />

    <Exec Command="python3 Tools/Distribution/verify-notices.py '$(_AppBundleDir)'" />
    <!-- Sign actual native code individually; managed files are sealed resources. -->
    <Copy SourceFiles="$(AppStoreProvisioningProfile)" DestinationFiles="$(_AppBundleDir)/Contents/embedded.provisionprofile" Condition="'$(DistributionChannel)' == 'AppStore' and '$(AppStoreProvisioningProfile)' != ''" />
    <Exec Command="xattr -r -d com.apple.quarantine '$(_AppBundleDir)'" Condition="'$(DistributionChannel)' == 'AppStore'" />
    <Exec Command="bash Tools/Distribution/sign-app.sh '$(_AppBundleDir)' '$(DistributionChannel)' '$(MacOSSigningIdentity)' '$(MacOSTeamIdentifier)'" />

    <Message Text="[macOS] .app bundle ready at: $(_AppBundleDir)" Importance="high" />
  </Target>

  <Target Name="CreateMacOSReleaseDMG" AfterTargets="CreateMacOSBundle" Condition="$([MSBuild]::IsOSPlatform('osx')) and '$(Configuration)' == 'Release' and '$(SkipMacOSReleaseDMG)' != 'true' and '$(DistributionChannel)' == 'Website'">
    <PropertyGroup>
      <_ReleaseAppBundle>$(OutputPath)Mac Explorer.app</_ReleaseAppBundle>
      <_ReleaseArchSuffix Condition="'$(RuntimeIdentifier)' == 'osx-x64'">-intel</_ReleaseArchSuffix>
      <_ReleaseDMG>$(OutputPath)MacExplorer-$(Version)-macos$(_ReleaseArchSuffix).dmg</_ReleaseDMG>
      <_DMGStaging>$(OutputPath)dmg-staging</_DMGStaging>
    </PropertyGroup>

    <!-- Remove old DMG and staging dir -->
    <Delete Files="$(_ReleaseDMG)" Condition="Exists('$(_ReleaseDMG)')" />
    <RemoveDir Directories="$(_DMGStaging)" Condition="Exists('$(_DMGStaging)')" />

    <!-- Create staging directory -->
    <MakeDir Directories="$(_DMGStaging)" />

    <!-- Copy .app to staging -->
    <Exec Command="cp -R '$(_ReleaseAppBundle)' '$(_DMGStaging)/'" />

    <!-- Create symlink to /Applications in staging (for drag-to-install) -->
    <Exec Command="ln -s /Applications '$(_DMGStaging)/Applications'" />

    <!-- Create DMG -->
    <Exec Command="hdiutil create -volname 'Mac Explorer' -srcfolder '$(_DMGStaging)' -ov -format UDZO -imagekey zlib-level=9 '$(_ReleaseDMG)'" />

    <!-- Clean up staging -->
    <RemoveDir Directories="$(_DMGStaging)" Condition="Exists('$(_DMGStaging)')" />

    <Message Text="[macOS] Release DMG ready at: $(_ReleaseDMG)" Importance="high" />
  </Target>
</Project>
