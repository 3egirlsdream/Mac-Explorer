<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MacExplorer</RootNamespace>
    <ApplicationId Condition="'$(DistributionChannel)' == 'Website'">com.thankful.top.macexplorer</ApplicationId>
    <AppStoreBundleId Condition="'$(AppStoreBundleId)' == ''">com.thankful.top.macexplorer.store</AppStoreBundleId>
    <AppStoreSubscriptionProductId Condition="'$(DistributionChannel)' == 'AppStore' and '$(AppStoreSubscriptionProductId)' == ''">001</AppStoreSubscriptionProductId>
    <ApplicationId Condition="'$(DistributionChannel)' == 'AppStore'">$(AppStoreBundleId)</ApplicationId>
    <Version>2.0.17</Version>
    <MacOSBuildNumber Condition="'$(MacOSBuildNumber)' == ''">$(Version)</MacOSBuildNumber>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot Condition="'$(_IsPublishing)' == 'true'">true</PublishAot>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>false</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <AppleMinOSVersion>$(MacOSMinimumVersion)</AppleMinOSVersion>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <DefineConstants Condition="'$(EnableDemoAutomation)' == 'true'">$(DefineConstants);DEMO_AUTOMATION</DefineConstants>
    <ApplicationId Condition="'$(EnableDemoAutomation)' == 'true'">com.macexplorer.demo</ApplicationId>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Languages/Markdown/*.json" TargetPath="I18n/CodeWF.Markdown/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets/PrivacyPolicy.txt" LogicalName="MacExplorer.PrivacyPolicy.txt" />
    <EmbeddedResource Include="Tools/Distribution/website-signing.requirement" LogicalName="MacExplorer.WebsiteSigningRequirement" />
    <AssemblyMetadata Include="PrivacyPolicyUrl" Value="$(PrivacyPolicyUrl)" />
    <AssemblyMetadata Include="AppStoreSubscriptionProductId" Value="$(AppStoreSubscriptionProductId)" Condition="'$(DistributionChannel)' == 'AppStore'" />
    <AvaloniaResource Include="Assets\**" Exclude="Assets\*.cs;Assets\*.axaml;Assets\FolderArtwork\*.png;Assets\**\*.md;Assets\mac-explorer-*.png;Assets\appicon.svg;Assets\appicon.icns;Assets\PrivacyPolicy.txt;Assets\ConversionNotices.txt;Assets\localsend-*.txt" />
    <EmbeddedResource Include="Assets/FolderArtwork/*.png" LogicalName="MacExplorer.FolderArtwork.%(Filename)%(Extension)" />
    <Compile Remove="Plugins/**/*.cs" />
    <Compile Remove="Tests/**/*.cs" />
    <Compile Remove="Tools/Performance/**/*.cs" />
    <Compile Remove="Tools/Design/**/*.cs" />
    <Compile Remove="Tools/GlassDemo/**/*.cs" />
    <Compile Remove="Tools/DemoRecord/**/*.cs" Condition="'$(EnableDemoAutomation)' != 'true'" />
    <Compile Remove="ThirdParty/**/*.cs" />
    <Compile Remove="outputs/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="Plugins/SDK/MacExplorer.PluginSdk.csproj" />
    <ProjectReference Include="Plugins/FileConversion/MacExplorer.FileConversion.Plugin.csproj" ReferenceOutputAssembly="true" />
    <ProjectReference Include="ThirdParty/LiquidGlassAvaloniaUI/LiquidGlassAvaloniaUI.csproj" />
    <ProjectReference Include="ThirdParty/Avalonia.TextShaping/MacExplorer.TextShaping.csproj" />
    <None Update="ThirdParty/LiquidGlassAvaloniaUI/LICENSE" TargetPath="LiquidGlassAvaloniaUI.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdParty/Vex/LICENSE" TargetPath="Markdown/Vex.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdParty/Vex/NOTICE.md" TargetPath="Markdown/NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdParty/Vex/FluentIcons.LICENSE.txt" TargetPath="Markdown/FluentIcons.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="ThirdParty/LibRaw/$(RuntimeIdentifier)/libraw.dylib" TargetPath="libraw.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="ThirdParty/LibZip/$(RuntimeIdentifier)/libzip.dylib" TargetPath="libzip.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$([MSBuild]::IsOSPlatform('osx'))" />
    <None Update="Plugins/FileConversion/plugin.json" TargetPath="BuiltInConversion/plugin.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Copilot/Skills/**/SKILL.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="VerifyLibRawArchitecture" BeforeTargets="GetCopyToOutputDirectoryItems" Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <PropertyGroup>
      <_LibRawArchitecture Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">arm64</_LibRawArchitecture>
      <_LibRawArchitecture Condition="'$(RuntimeIdentifier)' == 'osx-x64'">x86_64</_LibRawArchitecture>
      <_LibRawPath>$(MSBuildProjectDirectory)/ThirdParty/LibRaw/$(RuntimeIdentifier)/libraw.dylib</_LibRawPath>
    </PropertyGroup>
    <Error Condition="'$(_LibRawArchitecture)' == ''" Text="Unsupported LibRaw runtime identifier: $(RuntimeIdentifier)" />
    <Error Condition="!Exists('$(_LibRawPath)')" Text="Missing LibRaw library for $(RuntimeIdentifier): $(_LibRawPath)" />
    <Exec Command="lipo '$(_LibRawPath)' -verify_arch $(_LibRawArchitecture)" />
    <Exec Command="lipo '$(MSBuildProjectDirectory)/ThirdParty/LibZip/$(RuntimeIdentifier)/libzip.dylib' -verify_arch $(_LibRawArchitecture)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <!-- Vex editor core, pinned to the host's Avalonia 12.0.4 line. -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="CodeWF.Markdown" Version="12.0.4.3" />
    <PackageReference Include="CodeWF.Markdown.Themes" Version="12.0.4.3" />

    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />

    <PackageReference Include="SharpZipLib" Version="1.4.2" />

    <PackageReference Include="Microsoft.Agents.AI" Version="1.22.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <PackageReference Include="Svg.Skia" Version="5.0.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <!-- Language files are discovered at build time. Runtime lookups never read or parse files. -->
  <Target Name="GenerateLocalizationCatalog" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <_LocalizationCatalog>$(IntermediateOutputPath)LocalizationCatalog.g.cs</_LocalizationCatalog>
    </PropertyGroup>
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/Tools/Localization/generate_catalog.py&quot; &quot;$(MSBuildProjectDirectory)/Languages&quot; &quot;$(_LocalizationCatalog)&quot;" />
    <ItemGroup>
      <Compile Include="$(_LocalizationCatalog)" />
      <FileWrites Include="$(_LocalizationCatalog)" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(PublishAot)' == 'true' and $([MSBuild]::IsOSPlatform('osx'))">
    <LinkerArg Include="-Wl,-rpath,@executable_path/../Frameworks" />
  </ItemGroup>

  <Target Name="CompileStoreStartup"
          Inputs="Platforms/MacOS/StoreLauncher.mm;MacExplorer.csproj;Directory.Build.props;$(IntermediateOutputPath)macos-native-options.txt"
          Outputs="$(IntermediateOutputPath)StoreLauncher.o">
    <Exec Command="clang++ -fobjc-arc -arch $(_NativeArchitecture) -mmacosx-version-min=$(MacOSMinimumVersion) -c Platforms/MacOS/StoreLauncher.mm -o '$(IntermediateOutputPath)StoreLauncher.o'" />
  </Target>
  <Target Name="LinkStoreStartup" BeforeTargets="IlcCompile;LinkNative"
          DependsOnTargets="PrepareMacOSNativeOptions;CompileStoreStartup"
          Condition="'$(DistributionChannel)' == 'AppStore' and '$(PublishAot)' == 'true' and $([MSBuild]::IsOSPlatform('osx'))">
    <ItemGroup>
      <LinkerArg Include="$(IntermediateOutputPath)StoreLauncher.o" />
      <LinkerArg Include="-Wl,-u,_InitializeStoreApplication" />
      <LinkerArg Include="-framework AppKit" />
    </ItemGroup>
  </Target>
  <Target Name="ValidateStoreSubmission" BeforeTargets="PrepareForBuild" Condition="'$(StoreSubmission)' == 'true'">
    <Error Condition="'$(DistributionChannel)' != 'AppStore'" Text="StoreSubmission requires the AppStore channel."/>
    <Error Condition="'$(AppStoreSubscriptionProductId)' == ''" Text="Set AppStoreSubscriptionProductId to the actual annual subscription product before submission."/>
    <Exec Command="python3 Tools/Distribution/verify-release-config.py --identifier '$(AppStoreBundleId)' --policy '$(PrivacyPolicyUrl)' --subscription-product '$(AppStoreSubscriptionProductId)'"/>
  </Target>
  <Target Name="ValidateDemoBuild" BeforeTargets="PrepareForBuild" Condition="'$(EnableDemoAutomation)' == 'true'">
    <Error Condition="'$(DistributionChannel)' != 'Website'" Text="Demo automation is only available in the isolated website build." />
  </Target>
  <Target Name="BuildMacOSStoreKitBridge" DependsOnTargets="PrepareMacOSNativeOptions" AfterTargets="Build" BeforeTargets="CreateMacOSBundle" Condition="$([MSBuild]::IsOSPlatform('osx')) and '$(DistributionChannel)' == 'AppStore' and '$(SkipMacOSNativeHelpers)' != 'true'" Inputs="Platforms/MacOS/StoreKitBridge.swift;MacExplorer.csproj;Directory.Build.props;$(IntermediateOutputPath)macos-native-options.txt" Outputs="$(OutputPath)libMacExplorerStoreKit.dylib">
    <Exec Command="xcrun swiftc -parse-as-library -emit-library -O -target '$(_NativeArchitecture)-apple-macosx$(MacOSMinimumVersion)' 'Platforms/MacOS/StoreKitBridge.swift' -framework StoreKit -framework AppKit -Xlinker -install_name -Xlinker '@rpath/libMacExplorerStoreKit.dylib' -o '$(OutputPath)libMacExplorerStoreKit.dylib'" />
  </Target>
  <Target Name="BuildMacOSImageAnalysisHelper" DependsOnTargets="PrepareMacOSNativeOptions" AfterTargets="Build" BeforeTargets="CreateMacOSBundle" Condition="$([MSBuild]::IsOSPlatform('osx')) and '$(SkipMacOSNativeHelpers)' != 'true'" Inputs="Platforms/MacOS/ImageAnalysisHelper.swift;Platforms/MacOS/ImageAnalysisHelper.plist;Platforms/MacOS/HelperFileAccess.swift;Tools/Distribution/build-helper.sh;MacExplorer.csproj;Directory.Build.props;$(IntermediateOutputPath)macos-native-options.txt" Outputs="$(OutputPath)MacExplorer.ImageAnalysis">
    <Exec Command="bash Tools/Distribution/build-helper.sh 'Platforms/MacOS/ImageAnalysisHelper.swift' '$(OutputPath)MacExplorer.ImageAnalysis' '$(_NativeArchitecture)-apple-macosx$(MacOSMinimumVersion)' -framework Vision -framework CoreLocation -framework PDFKit -framework AppKit -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker 'Platforms/MacOS/ImageAnalysisHelper.plist'" />
  </Target>

  <Target Name="BuildMacOSNativeDragHelper" DependsOnTargets="PrepareMacOSNativeOptions" AfterTargets="Build" BeforeTargets="CreateMacOSBundle" Condition="$([MSBuild]::IsOSPlatform('osx'))" Inputs="Platforms/MacOS/AirDropBridge.mm;Platforms/MacOS/NativeFileDrag.mm;Platforms/MacOS/FileDropBridge.mm;Platforms/MacOS/FileDeliveryStatusItem.mm;Platforms/MacOS/KeyboardMonitor.mm;Platforms/MacOS/FolderIcon.mm;Platforms/MacOS/SandboxAccess.mm;Platforms/MacOS/DocumentPreview.mm;Platforms/MacOS/DocumentPreviewScrollbars.mm;Platforms/MacOS/DocumentPreviewScrollbars.h;Platforms/MacOS/VideoPreview.mm;Platforms/MacOS/NetworkBridge.mm;Platforms/MacOS/DiskInformation.mm;Platforms/MacOS/WindowShadow.mm;Platforms/MacOS/AutomationLifetime.mm;Platforms/MacOS/MemoryDiagnostics.mm;MacExplorer.csproj;Directory.Build.props;$(IntermediateOutputPath)macos-native-options.txt" Outputs="$(OutputPath)libMacExplorerNativeDrag.dylib">
    <Exec Command="clang++ -fobjc-arc -dynamiclib -arch $(_NativeArchitecture) -mmacosx-version-min=$(MacOSMinimumVersion) 'Platforms/MacOS/AirDropBridge.mm' 'Platforms/MacOS/NativeFileDrag.mm' 'Platforms/MacOS/FileDropBridge.mm' 'Platforms/MacOS/FileDeliveryStatusItem.mm' 'Platforms/MacOS/KeyboardMonitor.mm' 'Platforms/MacOS/FolderIcon.mm' 'Platforms/MacOS/SandboxAccess.mm' 'Platforms/MacOS/DocumentPreview.mm' 'Platforms/MacOS/DocumentPreviewScrollbars.mm' 'Platforms/MacOS/VideoPreview.mm' 'Platforms/MacOS/NetworkBridge.mm' 'Platforms/MacOS/DiskInformation.mm' 'Platforms/MacOS/WindowShadow.mm' 'Platforms/MacOS/AutomationLifetime.mm' 'Platforms/MacOS/MemoryDiagnostics.mm' -framework DiskArbitration -framework Network -framework NetFS -framework AppKit -framework Foundation -framework Security -framework Quartz -framework WebKit -framework AVKit -framework AVFoundation -framework CoreMedia -framework CoreServices -install_name @rpath/libMacExplorerNativeDrag.dylib -o '$(OutputPath)libMacExplorerNativeDrag.dylib'" />
  </Target>

  <Target Name="CopyBuiltInConversionHelper" AfterTargets="Build" BeforeTargets="CreateMacOSBundle"
          Condition="$([MSBuild]::IsOSPlatform('osx')) and '$(SkipMacOSNativeHelpers)' != 'true'">
    <ItemGroup>
      <_ConversionAssembly Include="@(ReferenceCopyLocalPaths)"
                           Condition="'%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)' == 'MacExplorer.FileConversion.Plugin.dll'" />
    </ItemGroup>
    <Copy SourceFiles="@(_ConversionAssembly->'%(RootDir)%(Directory)MacExplorer.FileConversion')"
          DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BuildMacOSThumbnailHelper" DependsOnTargets="PrepareMacOSNativeOptions" AfterTargets="Build" BeforeTargets="CreateMacOSBundle" Condition="$([MSBuild]::IsOSPlatform('osx')) and '$(SkipMacOSNativeHelpers)' != 'true'" Inputs="Platforms/MacOS/ThumbnailHelper.swift;Platforms/MacOS/HelperFileAccess.swift;Tools/Distribution/build-helper.sh;MacExplorer.csproj;Directory.Build.props;$(IntermediateOutputPath)macos-native-options.txt" Outputs="$(OutputPath)MacExplorer.Thumbnail">
    <Exec Command="bash Tools/Distribution/build-helper.sh 'Platforms/MacOS/ThumbnailHelper.swift' '$(OutputPath)MacExplorer.Thumbnail' '$(_NativeArchitecture)-apple-macosx$(MacOSMinimumVersion)' -framework QuickLookThumbnailing -framework ImageIO -framework UniformTypeIdentifiers -framework AVFoundation" />
  </Target>

  <Target Name="BuildMacOSGitHelper" DependsOnTargets="PrepareMacOSNativeOptions" AfterTargets="Build" BeforeTargets="CreateMacOSBundle" Condition="$([MSBuild]::IsOSPlatform('osx')) and '$(DistributionChannel)' == 'AppStore' and '$(SkipMacOSNativeHelpers)' != 'true'" Inputs="Platforms/MacOS/GitHelper.swift;Platforms/MacOS/HelperFileAccess.swift;Tools/Distribution/build-helper.sh;MacExplorer.csproj;Directory.Build.props;$(IntermediateOutputPath)macos-native-options.txt" Outputs="$(OutputPath)MacExplorer.Git">
    <Exec Command="bash Tools/Distribution/build-helper.sh 'Platforms/MacOS/GitHelper.swift' '$(OutputPath)MacExplorer.Git' '$(_NativeArchitecture)-apple-macosx$(MacOSMinimumVersion)'" />
  </Target>

  <Target Name="CopyMacOSAppIconToOutput" AfterTargets="Build" BeforeTargets="CreateMacOSBundle" Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Assets/appicon.icns" DestinationFolder="$(OutputPath)" Condition="Exists('$(MSBuildProjectDirectory)/Assets/appicon.icns')" />
  </Target>

  <Target Name="CreateMacOSBundle" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('osx')) and '$(SkipMacOSBundle)' != 'true' and '$(PublishAot)' == 'true'">
    <Error Condition="'$(DistributionChannel)' == 'AppStore' and '$(AppStoreBundleId)' == ''" Text="Set AppStoreBundleId explicitly; website identity is preserved." />
    <PropertyGroup>
      <_AppBundleName Condition="'$(DistributionChannel)' == 'Website'">Mac Explorer.app</_AppBundleName>
      <_AppBundleName Condition="'$(DistributionChannel)' == 'AppStore'">文件资源管理器.app</_AppBundleName>
      <_AppBundleDir>$(OutputPath)$(_AppBundleName)</_AppBundleDir>
      <_MacOSDir>$(_AppBundleDir)/Contents/MacOS</_MacOSDir>
      <_ResourcesDir>$(_AppBundleDir)/Contents/Resources</_ResourcesDir>
      <_FrameworksDir>$(_AppBundleDir)/Contents/Frameworks</_FrameworksDir>
      <_IconSource>$(MSBuildProjectDirectory)/Assets/appicon.icns</_IconSource>
    </PropertyGroup>

    <Message Text="[macOS] Creating .app bundle: $(_AppBundleDir)" Importance="high" />

    <!-- Create dirs -->
    <RemoveDir Directories="$(_AppBundleDir)" Condition="Exists('$(_AppBundleDir)')" />
    <MakeDir Directories="$(_MacOSDir)" />
    <MakeDir Directories="$(_ResourcesDir);$(_FrameworksDir)" />

    <Copy SourceFiles="$(NativeBinary)" DestinationFiles="$(_MacOSDir)/$(AssemblyName)" />

    <!-- Copy Info.plist -->
    <Copy SourceFiles="Platforms/MacOS/Info.plist" DestinationFolder="$(_AppBundleDir)/Contents" />
    <Exec Command="/usr/libexec/PlistBuddy -c &quot;Set :CFBundleShortVersionString $(Version)&quot; '$(_AppBundleDir)/Contents/Info.plist'" />
    <Exec Command="/usr/libexec/PlistBuddy -c &quot;Set :CFBundleVersion $(MacOSBuildNumber)&quot; '$(_AppBundleDir)/Contents/Info.plist'" />

    <Exec Command="/usr/libexec/PlistBuddy -c &quot;Set :CFBundleIdentifier $(ApplicationId)&quot; '$(_AppBundleDir)/Contents/Info.plist'" />
    <Exec Command="/usr/libexec/PlistBuddy -c &quot;Set :LSMinimumSystemVersion $(MacOSMinimumVersion)&quot; '$(_AppBundleDir)/Contents/Info.plist'" />
    <Exec Command="python3 Tools/Distribution/configure-bundle-branding.py '$(_AppBundleDir)' '$(DistributionChannel)'" />
    <!-- Copy icon -->
    <Copy SourceFiles="$(_IconSource)" DestinationFolder="$(_ResourcesDir)" Condition="Exists('$(_IconSource)')" />

    <Copy SourceFiles="Assets/ConversionNotices.txt;Assets/PrivacyPolicy.txt" DestinationFolder="$(_ResourcesDir)" />
    <Copy SourceFiles="Platforms/MacOS/PrivacyInfo.xcprivacy" DestinationFolder="$(_ResourcesDir)" />
    <Exec Command="/usr/libexec/PlistBuddy -c &quot;Add :PrivacyPolicyURL string $(PrivacyPolicyUrl)&quot; '$(_AppBundleDir)/Contents/Info.plist'" />
    <Exec Command="/usr/libexec/PlistBuddy -c &quot;Add :DistributionChannel string $(DistributionChannel)&quot; '$(_AppBundleDir)/Contents/Info.plist'" />
    <Exec Command="/usr/libexec/PlistBuddy -c &quot;Add :AppStoreSubscriptionProductID string $(AppStoreSubscriptionProductId)&quot; '$(_AppBundleDir)/Contents/Info.plist'" Condition="'$(DistributionChannel)' == 'AppStore' and '$(AppStoreSubscriptionProductId)' != ''" />
    <ItemGroup><_LegalNotices Include="ThirdParty/Notices/**/*" /></ItemGroup>
    <Copy SourceFiles="@(_LegalNotices)" DestinationFiles="@(_LegalNotices->'$(_ResourcesDir)/Notices/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="LICENSE" DestinationFiles="$(_ResourcesDir)/Notices/Project.LICENSE.txt" />
    <Copy SourceFiles="Assets/localsend-logo.png;Assets/localsend-LICENSE.txt;Assets/localsend-ATTRIBUTION.txt" DestinationFolder="$(_ResourcesDir)/LocalSend" />
    <Copy SourceFiles="ThirdParty/LiquidGlassAvaloniaUI/LICENSE" DestinationFiles="$(_ResourcesDir)/LiquidGlassAvaloniaUI.LICENSE.txt" />
    <Copy SourceFiles="ThirdParty/Avalonia.TextShaping/LICENSE;ThirdParty/Avalonia.TextShaping/NOTICE.md" DestinationFolder="$(_ResourcesDir)/TextShaping" />
    <Copy SourceFiles="ThirdParty/Vex/LICENSE;ThirdParty/Vex/NOTICE.md;ThirdParty/Vex/FluentIcons.LICENSE.txt" DestinationFolder="$(_ResourcesDir)/Markdown" />
    <Copy SourceFiles="ThirdParty/LibRaw/COPYRIGHT;ThirdParty/LibRaw/LICENSE.LGPL;ThirdParty/LibRaw/LICENSE.CDDL;ThirdParty/LibRaw/SOURCE.md" DestinationFolder="$(_ResourcesDir)/LibRaw" />

    <Copy SourceFiles="ThirdParty/LibZip/LICENSE;ThirdParty/LibZip/SOURCE.md" DestinationFolder="$(_ResourcesDir)/LibZip" />

    <ItemGroup>
      <_NativeLibs Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.dylib'" />
      <_NativeLibs Include="$(OutputPath)libMacExplorerNativeDrag.dylib" />
      <_NativeLibs Include="$(OutputPath)libMacExplorerStoreKit.dylib" Condition="'$(DistributionChannel)' == 'AppStore'" />
      <_NativeHelpers Include="$(OutputPath)MacExplorer.ImageAnalysis;$(OutputPath)MacExplorer.Thumbnail;$(OutputPath)MacExplorer.FileConversion" />
      <_NativeHelpers Include="$(OutputPath)MacExplorer.Git" Condition="'$(DistributionChannel)' == 'AppStore'" />
      <_I18nFiles Include="$(PublishDir)I18n/**/*.json" />
      <_SkillFiles Include="$(PublishDir)Copilot/Skills/**/SKILL.md" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeLibs)" DestinationFolder="$(_FrameworksDir)" />
    <Copy SourceFiles="@(_NativeHelpers)" DestinationFolder="$(_MacOSDir)" />
    <Exec Command="bash Tools/Distribution/link-native-libraries.sh '$(_FrameworksDir)' '$(_MacOSDir)'" />
    <Copy SourceFiles="@(_I18nFiles)" DestinationFiles="@(_I18nFiles->'$(_ResourcesDir)/I18n/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_SkillFiles)" DestinationFiles="@(_SkillFiles->'$(_ResourcesDir)/Copilot/Skills/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(PublishDir)BuiltInConversion/plugin.json" DestinationFolder="$(_ResourcesDir)/BuiltInConversion" />
    <Exec Command="python3 Tools/Distribution/verify-notices.py '$(_AppBundleDir)' '$(ProjectAssetsFile)'" />
    <Copy SourceFiles="$(AppStoreProvisioningProfile)" DestinationFiles="$(_AppBundleDir)/Contents/embedded.provisionprofile" Condition="'$(DistributionChannel)' == 'AppStore' and '$(AppStoreProvisioningProfile)' != ''" />
    <Exec Command="xattr -r -d com.apple.quarantine '$(_AppBundleDir)'" Condition="'$(DistributionChannel)' == 'AppStore'" />
    <Exec Command="bash Tools/Distribution/sign-app.sh '$(_AppBundleDir)' '$(DistributionChannel)' '$(MacOSSigningIdentity)' '$(MacOSTeamIdentifier)'" />

    <Message Text="[macOS] .app bundle ready at: $(_AppBundleDir)" Importance="high" />
  </Target>

  <Target Name="CreateMacOSReleaseDMG" AfterTargets="CreateMacOSBundle" Condition="$([MSBuild]::IsOSPlatform('osx')) and '$(Configuration)' == 'Release' and '$(SkipMacOSReleaseDMG)' != 'true' and '$(DistributionChannel)' == 'Website'">
    <PropertyGroup>
      <_ReleaseAppBundle>$(OutputPath)Mac Explorer.app</_ReleaseAppBundle>
      <_ReleaseArchSuffix Condition="'$(RuntimeIdentifier)' == 'osx-x64'">-intel</_ReleaseArchSuffix>
      <_ReleaseDMG>$(OutputPath)MacExplorer-$(Version)-macos$(_ReleaseArchSuffix).dmg</_ReleaseDMG>
      <_DMGStaging>$(OutputPath)dmg-staging</_DMGStaging>
    </PropertyGroup>

    <!-- Remove old DMG and staging dir -->
    <Delete Files="$(_ReleaseDMG)" Condition="Exists('$(_ReleaseDMG)')" />
    <RemoveDir Directories="$(_DMGStaging)" Condition="Exists('$(_DMGStaging)')" />

    <!-- Create staging directory -->
    <MakeDir Directories="$(_DMGStaging)" />

    <!-- Copy .app to staging -->
    <Exec Command="cp -R '$(_ReleaseAppBundle)' '$(_DMGStaging)/'" />

    <!-- Create symlink to /Applications in staging (for drag-to-install) -->
    <Exec Command="ln -s /Applications '$(_DMGStaging)/Applications'" />

    <!-- Create DMG -->
    <Exec Command="python3 Tools/Distribution/create-dmg.py '$(_DMGStaging)' '$(_ReleaseDMG)'" />

    <!-- Clean up staging -->
    <RemoveDir Directories="$(_DMGStaging)" Condition="Exists('$(_DMGStaging)')" />

    <Message Text="[macOS] Release DMG ready at: $(_ReleaseDMG)" Importance="high" />
  </Target>
  <Import Project="Platforms/MacOS/AotCompatibility.targets" Condition="'$(PublishAot)' == 'true'" />
</Project>
