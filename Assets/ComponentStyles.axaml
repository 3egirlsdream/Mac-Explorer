<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>

        <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Margin="12">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                BoxShadow="{DynamicResource PopupShadow}"/>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                ClipToBounds="True">
                            <ScrollViewer>
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                                Margin="{TemplateBinding Padding}"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="{StaticResource ControlPadding}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="QuadraticEaseOut"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.12" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="{DynamicResource InteractionDisabledOpacity}"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     Button.toolbar-btn:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     Button.workspace-nav-button:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     Button.info-panel-icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.sidebar-item-action:disabled">
        <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="Border.sidebar-item:pointerover Button.sidebar-item-action:disabled, Border.sidebar-item:focus-within Button.sidebar-item-action:disabled">
        <Setter Property="Opacity" Value="{DynamicResource InteractionDisabledOpacity}"/>
    </Style>

    <Style Selector="Button, ToggleButton, ListBoxItem">
        <Setter Property="FocusAdorner" Value="{StaticResource KeyboardFocusAdorner}"/>
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="Button.secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="Button.info-panel-icon">
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.info-panel-icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="Button.info-panel-icon:focus-visible">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.system-tag-dot">
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    </Style>


    <Style Selector="Button.system-tag-dot:focus-visible">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.danger:pointerover">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.primary:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.primary:pressed:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.primary:pressed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.danger:pointerover">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
    </Style>
    <Style Selector="Button.danger:pressed">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
    </Style>
    <Style Selector="Button.danger:pressed:pointerover">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
    </Style>
    <Style Selector="Button.danger:pressed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    <Style Selector="Button.compact">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="{StaticResource CompactControlPadding}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
    </Style>

    <Style Selector="TextBox, ComboBox, NumericUpDown">
        <Setter Property="MinHeight" Value="{DynamicResource TypographyTextControlMinHeight}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Background" Value="{DynamicResource AddressbarBg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="TextBox:pointerover, ComboBox:pointerover, NumericUpDown:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox:focus, ComboBox:focus, NumericUpDown:focus">
        <Setter Property="Background" Value="{DynamicResource AddressbarBgFocus}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="TextBox">
        <Setter Property="SelectionBrush" Value="{DynamicResource InteractionTextHighlightBrush}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Match every ComboBox popup to the sidebar action-menu surface. -->
    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource ComboBoxDropDownBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxDropDownBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource ComboBoxDropdownBorderThickness}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BoxShadow" Value="{DynamicResource ComboBoxDropDownShadow}"/>
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBoxItem:selected">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- Shared inline rename editor for file names and sidebar item names. -->
    <Style Selector="TextBox.inline-rename-editor">
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Height" Value="{DynamicResource TypographyInlineEditorHeight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource InteractionTextHighlightBrush}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ColorAccent}"/>
    </Style>
    <Style Selector="TextBox.inline-rename-editor:pointerover, TextBox.inline-rename-editor:focus">
        <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox.inline-rename-editor /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    </Style>
    <Style Selector="TextBox.inline-rename-editor:pointerover /template/ Border#PART_BorderElement, TextBox.inline-rename-editor:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
    </Style>
    <Style Selector="CheckBox, RadioButton, ToggleSwitch">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="ToggleButton">
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
    </Style>
    <Style Selector="ToggleButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="CheckBox:disabled, RadioButton:disabled, ToggleSwitch:disabled">
        <Setter Property="Opacity" Value="{DynamicResource InteractionDisabledOpacity}"/>
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TabItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="MenuItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>

    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource GlassMenuBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="6"/>
    </Style>
    <Style Selector="ContextMenu Popup Border">
        <Setter Property="Background" Value="{DynamicResource GlassMenuBg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="BoxShadow" Value="{DynamicResource PopupShadow}"/>
    </Style>
    <Style Selector="MenuItem Popup Border">
        <Setter Property="Background" Value="{DynamicResource GlassMenuBg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="BoxShadow" Value="{DynamicResource PopupShadow}"/>
    </Style>
    <Style Selector="Border.context-submenu-surface">
        <Setter Property="Margin" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource GlassMenuBg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="BoxShadow" Value="{DynamicResource PopupShadow}"/>
        <Setter Property="ClipToBounds" Value="False"/>
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    </Style>
    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowSm}"/>
    </Style>
    <Style Selector="Border.surface">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
    </Style>
    <Style Selector="Border.popup-surface">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowMd}"/>
    </Style>

    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
</Styles>
