<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MacExplorer.Controls"
        xmlns:glass="clr-namespace:LiquidGlassAvaloniaUI;assembly=LiquidGlassAvaloniaUI">
    <Styles.Resources>

        <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Classes="context-submenu-surface">
                        <ScrollViewer>
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="{StaticResource ControlPadding}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="QuadraticEaseOut"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.12" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="{DynamicResource InteractionDisabledOpacity}"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     Button.toolbar-btn:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     Button.workspace-nav-button:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     Button.info-panel-icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.sidebar-item-action:disabled">
        <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="Border.sidebar-item:pointerover Button.sidebar-item-action:disabled, Border.sidebar-item:focus-within Button.sidebar-item-action:disabled">
        <Setter Property="Opacity" Value="{DynamicResource InteractionDisabledOpacity}"/>
    </Style>

    <Style Selector="Button, ToggleButton, ListBoxItem">
        <Setter Property="FocusAdorner" Value="{StaticResource KeyboardFocusAdorner}"/>
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="Button.secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="Button.info-panel-icon">
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.info-panel-icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="Button.info-panel-icon:focus-visible">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.system-tag-dot">
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    </Style>


    <Style Selector="Button.system-tag-dot:focus-visible">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.danger:pointerover">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.primary:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.primary:pressed:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.primary:pressed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.danger:pointerover">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
    </Style>
    <Style Selector="Button.danger:pressed">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
    </Style>
    <Style Selector="Button.danger:pressed:pointerover">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
    </Style>
    <Style Selector="Button.danger:pressed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    <Style Selector="Button.compact">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="{StaticResource CompactControlPadding}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
    </Style>

    <!-- Search/filter tags keep their label and count in separate, centered regions. -->
    <Style Selector="Button.tag-chip">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="MaxWidth" Value="280"/>
        <Setter Property="Padding" Value="10,3,4,3"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tag-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="Button.tag-chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
    </Style>
    <Style Selector="TextBlock.tag-label, TextBlock.tag-count-text">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.tag-label">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Border.tag-count">
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    </Style>
    <Style Selector="TextBlock.tag-count-text">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    </Style>

    <Style Selector="TextBox, ComboBox, NumericUpDown">
        <Setter Property="MinHeight" Value="{DynamicResource TypographyTextControlMinHeight}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Background" Value="{DynamicResource AddressbarBg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="TextBox">
        <Setter Property="SelectionBrush" Value="{DynamicResource InteractionTextHighlightBrush}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource InputCaretBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.multiline">
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style Selector="ComboBox.icon-picker">
        <Setter Property="Width" Value="64"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox /template/ TextPresenter#PART_TextPresenter">
        <Setter Property="controls:InputCaret.Enabled" Value="True"/>
    </Style>
    <!-- Fluent changes the template border directly on hover/focus. Keep its
         surface bound to the input so embedded transparent editors stay flat. -->
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement, TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
    </Style>
    <!-- Embedded inputs share their container's surface in every interaction state. -->
    <Style Selector="TextBox.search-input, TextBox.omnibox-input, TextBox.breadcrumb-input, TextBox.home-search-input">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.search-input /template/ Border#PART_BorderElement,
                     TextBox.omnibox-input /template/ Border#PART_BorderElement,
                     TextBox.breadcrumb-input /template/ Border#PART_BorderElement,
                     TextBox.home-search-input /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ComboBox:pointerover /template/ Border#Background,
                     ComboBox:pressed /template/ Border#Background,
                     ComboBox:focus /template/ Border#Background,
                     ComboBox:dropdownopen /template/ Border#Background">
        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder">
        <!-- Keep the menu at least as wide as the field, excluding shadow space. -->
        <Setter Property="MinWidth" Value="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"/>
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBoxItem:selected">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- Shared inline rename editor for file names and sidebar item names. -->
    <Style Selector="TextBox.inline-rename-editor">
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Height" Value="{DynamicResource TypographyInlineEditorHeight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource InteractionTextHighlightBrush}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource InputCaretBrush}"/>
    </Style>
    <Style Selector="TextBox.inline-rename-editor:pointerover, TextBox.inline-rename-editor:focus">
        <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.inline-rename-editor /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    </Style>
    <Style Selector="TextBox.inline-rename-editor:pointerover /template/ Border#PART_BorderElement, TextBox.inline-rename-editor:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
    </Style>
    <Style Selector="CheckBox, RadioButton, ToggleSwitch">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <!-- Compact switch keeps Fluent keyboard, drag and state handling. -->
    <Style Selector="ToggleSwitch.compact /template/ Border#OuterBorder,
                     ToggleSwitch.compact /template/ Border#SwitchKnobBounds">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="ToggleSwitch.compact /template/ Canvas#PART_SwitchKnob">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="20"/>
    </Style>
    <Style Selector="ToggleSwitch.compact /template/ Grid#PART_MovingKnobs">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
    </Style>
    <Style Selector="ToggleSwitch.compact:unchecked /template/ Border#OuterBorder">
        <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ToggleSwitch.compact:unchecked /template/ Ellipse#SwitchKnobOff">
        <Setter Property="Fill" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="ToggleSwitch.compact /template/ Ellipse#SwitchKnobOn,
                     ToggleSwitch.compact /template/ Ellipse#SwitchKnobOff">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>

    <!-- Preserve Fluent's checked/indeterminate glyphs and interaction states. -->
    <Style Selector="CheckBox:not(:checked):not(:indeterminate) /template/ Border#NormalRectangle, CheckBox:checked /template/ Border#NormalRectangle, CheckBox:indeterminate /template/ Border#NormalRectangle">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="CheckBox:not(:checked):not(:indeterminate) /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource CheckBoxSurfaceBrush}"/>
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle, CheckBox:indeterminate /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource InputCaretBrush}"/>
    </Style>
    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph, CheckBox:indeterminate /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="White"/>
    </Style>
    <Style Selector="ToggleButton">
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
    </Style>
    <Style Selector="ToggleButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="CheckBox:disabled, RadioButton:disabled, ToggleSwitch:disabled">
        <Setter Property="Opacity" Value="{DynamicResource InteractionDisabledOpacity}"/>
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TabItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot,
                     MenuItem:pointerover /template/ Border#PART_LayoutRoot,
                     MenuItem:pressed /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource SidebarHoverOutline}"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.toolbar-popup-item:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.toolbar-popup-items ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.toolbar-popup-items ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource SidebarHoverOutline}"/>
    </Style>
    <Style Selector="Border.menu-quick-surface:pointerover">
        <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource SidebarHoverOutline}"/>
    </Style>
    <Style Selector="Button.menu-quick-action:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.menu-quick-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBlock.menu-quick-label">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="WindowManagerAddShadowHint" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="Padding" Value="6"/>
    </Style>
    <!-- The open-state trigger overrides Fluent's template-local submenu card values. -->
    <Style Selector="Border.context-submenu-surface,
                     Border.toolbar-popup, Border.omnibox-popup,
                     MenuItem[IsSubMenuOpen=True] /template/ Popup > Border,
                     ComboBox:dropdownopen /template/ Border#PopupBorder">
        <Setter Property="controls:PopupGlass.IsEnabled" Value="True"/>
        <Setter Property="Margin" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
        <Setter Property="ClipToBounds" Value="False"/>
    </Style>
    <Style Selector="glass|LiquidGlassSurface.popup-glass">
        <Setter Property="TintColor" Value="Transparent"/>
        <Setter Property="SurfaceColor" Value="{DynamicResource PopupGlassColor}"/>
        <Setter Property="BackdropOpacity" Value="{DynamicResource PopupGlassBackdrop}"/>
        <Setter Property="BlurRadius" Value="8"/>
        <Setter Property="RefractionHeight" Value="18"/>
        <Setter Property="RefractionAmount" Value="{DynamicResource PopupGlassRefraction}"/>
        <Setter Property="HighlightOpacity" Value="{DynamicResource PopupGlassHighlight}"/>
        <Setter Property="HighlightWidth" Value="0.65"/>
        <Setter Property="Vibrancy" Value="1"/>
        <Setter Property="DepthEffect" Value="False"/>
        <Setter Property="ChromaticAberration" Value="False"/>
        <Setter Property="InnerShadowEnabled" Value="False"/>
        <!-- 3 sigma + 1px antialiasing + 2px offset fits the 12px popup margin. -->
        <Setter Property="ShadowRadius" Value="3"/>
        <Setter Property="ShadowOffset" Value="0,2"/>
        <Setter Property="ShadowColor" Value="#24000000"/>
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    </Style>
    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowSm}"/>
    </Style>
    <Style Selector="Border.surface">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
    </Style>
    <Style Selector="Border.popup-surface">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowMd}"/>
    </Style>

    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
        <Style Selector="Button.workspace-nav-button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.workspace-nav-button PathIcon">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
        </Style>
        <Style Selector="Button.workspace-nav-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        </Style>

</Styles>
