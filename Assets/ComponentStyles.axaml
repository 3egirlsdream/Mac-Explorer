<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MacExplorer.Controls"
        xmlns:loc="using:MacExplorer.Controls"
        xmlns:icons="using:MacExplorer.Assets"
        xmlns:glass="clr-namespace:LiquidGlassAvaloniaUI;assembly=LiquidGlassAvaloniaUI">
    <StyleInclude Source="avares://MacExplorer/Assets/ButtonStyles.axaml"/>

    <Style Selector="Border.dialog-divider">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource DialogDividerBrush}"/>
    </Style>
    <Style Selector="Border.dialog-status-surface">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="Background" Value="{DynamicResource ToastInfoSurfaceBrush}"/>
    </Style>
    <Style Selector="PathIcon.dialog-status-icon">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource ToastInfoBrush}"/>
    </Style>
    <Style Selector="Border.dialog-status-surface.warning">
        <Setter Property="Background" Value="{DynamicResource ToastWarningSurfaceBrush}"/>
    </Style>
    <Style Selector="PathIcon.dialog-status-icon.warning">
        <Setter Property="Foreground" Value="{DynamicResource ToastWarningBrush}"/>
    </Style>
    <Style Selector="Border.dialog-status-surface.success">
        <Setter Property="Background" Value="{DynamicResource ToastSuccessSurfaceBrush}"/>
    </Style>
    <Style Selector="PathIcon.dialog-status-icon.success">
        <Setter Property="Foreground" Value="{DynamicResource ToastSuccessBrush}"/>
    </Style>

    <Style Selector="TextBlock.dialog-window-title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="TextBlock.dialog-window-title.centered">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeHeading}"/>
        <!-- Balance WindowTitleBar's 104px leading and 8px trailing insets. -->
        <Setter Property="Margin" Value="0,0,96,0"/>
    </Style>

    <Style Selector="Border.workspace-surface">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.workspace-surface.split">
        <!-- With the window's 8px inset, leave 20px for the 6px shadow and antialiasing. -->
        <Setter Property="Margin" Value="12"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="Background" Value="{DynamicResource WorkspaceSurfaceBrush}"/>
    </Style>
    <Style Selector="Border.workspace-surface.split > Grid > Border.workspace-content">
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Border.workspace-shadow">
        <Setter Property="BoxShadow" Value="{DynamicResource WorkspaceActiveShadow}"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.workspace-surface.split.active > Grid > Border.workspace-shadow">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Border.workspace-inactive-overlay">
        <Setter Property="Background" Value="{DynamicResource WorkspaceInactiveOverlayBrush}"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.workspace-surface.split:not(.active) Border.workspace-inactive-overlay">
        <Setter Property="Opacity" Value="0.3"/>
    </Style>

    <Style Selector="controls|AnimatedProgressRing">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="TrackBrush" Value="{DynamicResource ColorBorderSubtle}"/>
        <Setter Property="StartBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="EndBrush" Value="{DynamicResource ProgressRingEndBrush}"/>
    </Style>
    <Style Selector="controls|AnimatedProgressRing.muted">
        <Setter Property="StartBrush" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="EndBrush" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="controls|AnimatedProgressRing.attention, controls|AnimatedProgressRing.failed">
        <Setter Property="StartBrush" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="EndBrush" Value="{DynamicResource DangerBrush}"/>
    </Style>
    <Style Selector="controls|AnimatedProgressRing.completed">
        <Setter Property="StartBrush" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="EndBrush" Value="{DynamicResource SuccessBrush}"/>
    </Style>
    <Style Selector="controls|FastFileList">
        <Setter Property="ThumbnailShadow" Value="{DynamicResource ThumbnailShadow}"/>
    </Style>
    <Style Selector="controls|HomeFileImage">
        <Setter Property="ThumbnailShadow" Value="{DynamicResource ThumbnailShadow}"/>
    </Style>

    <Styles.Resources>
        <controls:AppScrollBarTheme x:Key="AppScrollBarTheme" TargetType="ScrollBar"/>

        <ControlTheme x:Key="CompactSliderTrackButtonTheme" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Background="Transparent" Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="CompactSliderThumbTheme" TargetType="Thumb">
            <Setter Property="Width" Value="21"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource SliderThumbBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorderBrush}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border x:Name="SliderKnob" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0.75" CornerRadius="{DynamicResource RadiusFull}"
                                BoxShadow="{DynamicResource SliderThumbShadow}"/>
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="SliderValueTip" IsVisible="False" Width="100" Canvas.Left="-39.5" Canvas.Top="-34">
                                <StackPanel HorizontalAlignment="Center" Spacing="-0.5">
                                    <Border MinWidth="46" Height="23" Padding="9,0" CornerRadius="6"
                                            Background="{DynamicResource SliderValueBackgroundBrush}">
                                        <TextBlock Text="{TemplateBinding Tag}" TextAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource SliderValueForegroundBrush}"/>
                                    </Border>
                                    <Path Data="M0,0 L12,0 L6,6 Z" Fill="{DynamicResource SliderValueBackgroundBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover, ^:pressed">
                <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbFocusBrush}"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#SliderKnob">
                <Setter Property="BoxShadow" Value="{DynamicResource SliderThumbHoverShadow}"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#SliderKnob">
                <Setter Property="BoxShadow" Value="{DynamicResource SliderThumbFocusShadow}"/>
            </Style>
            <Style Selector="^:pressed:not(:disabled) /template/ Border#SliderValueTip">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Background" Value="{DynamicResource SliderDisabledThumbBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorderBrush}"/>
            </Style>
            <Style Selector="^:disabled /template/ Border#SliderKnob">
                <Setter Property="BoxShadow" Value="none"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="CompactSliderTheme" TargetType="Slider">
            <Setter Property="Height" Value="30"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <Border x:Name="SliderRail" Height="6" Margin="10.5,0" VerticalAlignment="Center"
                                CornerRadius="3" Background="{DynamicResource SliderRailBrush}" IsHitTestVisible="False"/>
                        <Track x:Name="PART_Track" Orientation="Horizontal"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton x:Name="PART_DecreaseButton" Theme="{StaticResource CompactSliderTrackButtonTheme}">
                                    <Border x:Name="SliderFill" Height="6" Margin="10.5,0,-10.5,0"
                                            VerticalAlignment="Center" CornerRadius="3"
                                            Background="{DynamicResource SliderFillBrush}"/>
                                </RepeatButton>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton x:Name="PART_IncreaseButton" Theme="{StaticResource CompactSliderTrackButtonTheme}"/>
                            </Track.IncreaseButton>
                            <Track.Thumb>
                                <Thumb x:Name="SliderThumb" Theme="{StaticResource CompactSliderThumbTheme}" Tag="{TemplateBinding Tag}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:focus-visible /template/ Thumb#SliderThumb">
                <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbFocusBrush}"/>
            </Style>
            <Style Selector="^:disabled /template/ Border#SliderFill">
                <Setter Property="Background" Value="{DynamicResource SliderDisabledFillBrush}"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="CompactSpinnerButtonTheme" TargetType="RepeatButton" BasedOn="{StaticResource IconActionButtonTheme}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Style Selector="^:pointerover, ^:pressed">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="CompactSpinnerTheme" TargetType="ButtonSpinner">
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel>
                        <StackPanel Name="PART_SpinnerPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                            IsVisible="{TemplateBinding ShowButtonSpinner}">
                            <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource CompactSpinnerButtonTheme}"
                                IsTabStop="False" AutomationProperties.Name="增加">
                                <PathIcon Width="12" Height="12" Data="{x:Static icons:Icons.ChevronUp}"/>
                            </RepeatButton>
                            <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource CompactSpinnerButtonTheme}"
                                IsTabStop="False" AutomationProperties.Name="减少">
                                <PathIcon Width="12" Height="12" Data="{x:Static icons:Icons.ChevronDown}"/>
                            </RepeatButton>
                        </StackPanel>
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="CompactNumericTheme" TargetType="NumericUpDown">
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Border Name="NumericSurface" Background="{TemplateBinding Background}"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="{TemplateBinding CornerRadius}">
                            <ButtonSpinner Name="PART_Spinner" Theme="{StaticResource CompactSpinnerTheme}"
                                AllowSpin="{TemplateBinding AllowSpin}" ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}"
                                IsTabStop="False">
                                <TextBox Name="PART_TextBox" Text="{TemplateBinding Text}" MinWidth="0" MinHeight="0"
                                    Background="Transparent" Padding="8,2" VerticalContentAlignment="Center" TextAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}" IsReadOnly="{TemplateBinding IsReadOnly}"
                                    PlaceholderText="{TemplateBinding PlaceholderText}" FocusAdorner="{x:Null}"/>
                            </ButtonSpinner>
                        </Border>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:focus-within /template/ Border#NumericSurface">
                <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
            </Style>
        </ControlTheme>
        <!-- The header content stays independent from the disclosure hit target. -->
        <ControlTheme x:Key="CompactDetailsExpanderTheme" TargetType="Expander">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid RowDefinitions="Auto,Auto">
                        <Grid ColumnDefinitions="*,28" ColumnSpacing="6">
                            <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                            <controls:AppToggleButton Name="ExpanderHeader" Grid.Column="1" Classes="icon-action"
                                IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                ToolTip.Tip="展开／收起详情" AutomationProperties.Name="展开／收起名称详情">
                                <PathIcon Name="DisclosureIcon" Width="14" Height="14"/>
                            </controls:AppToggleButton>
                        </Grid>
                        <Border Name="ExpanderContent" Grid.Row="1" IsVisible="{TemplateBinding IsExpanded}"
                            Margin="{TemplateBinding Padding}" Padding="10,2,0,2" BorderThickness="1,0,0,0"
                            BorderBrush="{DynamicResource ColorBorderSubtle}">
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^ /template/ PathIcon#DisclosureIcon">
                <Setter Property="Data" Value="{x:Static icons:Icons.ChevronRightGeometry}"/>
            </Style>
            <Style Selector="^:expanded /template/ PathIcon#DisclosureIcon">
                <Setter Property="Data" Value="{x:Static icons:Icons.ChevronDownGeometry}"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Classes="context-submenu-surface">
                        <ScrollViewer>
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Border.copilot-history-row">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.copilot-history-row:pointerover,
                     Border.copilot-history-row:focus-within,
                     Border.copilot-history-row.active">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
    </Style>

    <!-- Copilot transcript cards and composer share the app's semantic theme surfaces. -->
    <Style Selector="Border.copilot-composer">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BoxShadow" Value="{DynamicResource SurfaceCardShadow}"/>
    </Style>
    <Style Selector="Border.copilot-attachment-drop-zone">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="Padding" Value="4,1"/>
        <Setter Property="MinHeight" Value="20"/>
    </Style>
    <Style Selector="Border.copilot-attachment-drop-zone.drag-over">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Border.copilot-attachment-chip">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
        <Setter Property="Padding" Value="3"/>
    </Style>
    <Style Selector="Grid.copilot-attachment-tag">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="TextBox.copilot-input">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="7,5"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <Style Selector="TextBox.copilot-input /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Border.copilot-assistant-bubble, Border.copilot-user-bubble">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="Padding" Value="11,8"/>
    </Style>
    <Style Selector="Border.copilot-assistant-bubble">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.copilot-user-bubble">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
    </Style>
    <Style Selector="TextBlock.copilot-process-title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.copilot-process-detail">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.copilot-error-title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>
    <Style Selector="Border.copilot-tool-card, Border.copilot-thinking-card, Border.copilot-approval-card">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style Selector="Border.copilot-tool-card, Border.copilot-thinking-card">
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style Selector="Border.copilot-tool-details">
        <Setter Property="Margin" Value="11,3,0,1"/>
        <Setter Property="Padding" Value="10,1,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
    </Style>
    <Style Selector="TextBlock.copilot-tool-title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.copilot-tool-action">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.copilot-tool-detail">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.copilot-tool-failed">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>
    <Style Selector="TextBlock.copilot-approval-title">
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.file-task-row">
        <Setter Property="Padding" Value="16,10,12,10"/>
        <Setter Property="MinHeight" Value="54"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="TextBlock.task-title">
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightBody}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.task-meta">
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightBody}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.task-percentage">
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightBody}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="MinWidth" Value="36"/>
    </Style>
    <Style Selector="TextBlock.task-percentage.state">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="ProgressBar.task-progress">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Height" Value="3"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    </Style>
    <Style Selector="ProgressBar.task-progress.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="Expander.compact-details">
        <Setter Property="Theme" Value="{StaticResource CompactDetailsExpanderTheme}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="64,6,34,8"/>
    </Style>
    <Style Selector="NumericUpDown.compact">
        <Setter Property="Theme" Value="{StaticResource CompactNumericTheme}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="NumericUpDown.compact /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- Search/filter tags keep their label and count in separate, centered regions. -->
    <Style Selector="Border.status-tag">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusFull}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    </Style>

    <Style Selector="TextBlock.tag-label, TextBlock.tag-count-text">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.tag-label">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Border.tag-count">
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    </Style>
    <Style Selector="TextBlock.tag-count-text">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    </Style>

    <Style Selector="TextBox, NumericUpDown">
        <Setter Property="MinHeight" Value="{DynamicResource TypographyTextControlMinHeight}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Background" Value="{DynamicResource AddressbarBg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="TextBox, NumericUpDown">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="TextBox">
        <Setter Property="SelectionBrush" Value="{DynamicResource InteractionTextHighlightBrush}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource InputCaretBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.multiline">
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style Selector="TextBox /template/ TextPresenter#PART_TextPresenter">
        <Setter Property="controls:InputCaret.Enabled" Value="True"/>
    </Style>
    <!-- Fluent changes the template border directly on hover/focus. Keep its
         surface bound to the input so embedded transparent editors stay flat. -->
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement, TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
    </Style>
    <!-- Embedded inputs share their container's surface in every interaction state. -->
    <Style Selector="TextBox.search-input, TextBox.omnibox-input, TextBox.breadcrumb-input, TextBox.home-search-input">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.search-input /template/ Border#PART_BorderElement,
                     TextBox.omnibox-input /template/ Border#PART_BorderElement,
                     TextBox.breadcrumb-input /template/ Border#PART_BorderElement,
                     TextBox.home-search-input /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Shared inline rename editor for file names and sidebar item names. -->
    <Style Selector="TextBox.inline-rename-editor">
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Height" Value="{DynamicResource TypographyInlineEditorHeight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource InteractionTextHighlightBrush}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource InputCaretBrush}"/>
    </Style>
    <Style Selector="TextBox.inline-rename-editor:pointerover, TextBox.inline-rename-editor:focus">
        <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.inline-rename-editor /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    </Style>
    <Style Selector="TextBox.inline-rename-editor:pointerover /template/ Border#PART_BorderElement, TextBox.inline-rename-editor:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
    </Style>
    <Style Selector="CheckBox, RadioButton, ToggleSwitch">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <!-- Compact switch keeps Fluent keyboard, drag and state handling. -->
    <Style Selector="ToggleSwitch.compact /template/ Border#OuterBorder,
                     ToggleSwitch.compact /template/ Border#SwitchKnobBounds">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="ToggleSwitch.compact /template/ Canvas#PART_SwitchKnob">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="20"/>
    </Style>
    <Style Selector="ToggleSwitch.compact /template/ Grid#PART_MovingKnobs">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
    </Style>
    <Style Selector="ToggleSwitch.compact:unchecked /template/ Border#OuterBorder">
        <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ToggleSwitch.compact:unchecked /template/ Ellipse#SwitchKnobOff">
        <Setter Property="Fill" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="ToggleSwitch.compact /template/ Ellipse#SwitchKnobOn,
                     ToggleSwitch.compact /template/ Ellipse#SwitchKnobOff">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>

    <!-- Preserve Fluent's checked/indeterminate glyphs and interaction states. -->
    <Style Selector="CheckBox:not(:checked):not(:indeterminate) /template/ Border#NormalRectangle, CheckBox:checked /template/ Border#NormalRectangle, CheckBox:indeterminate /template/ Border#NormalRectangle">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="CheckBox:not(:checked):not(:indeterminate) /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource CheckBoxSurfaceBrush}"/>
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle, CheckBox:indeterminate /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource InputCaretBrush}"/>
    </Style>
    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph, CheckBox:indeterminate /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="White"/>
    </Style>

    <Style Selector="CheckBox:disabled, RadioButton:disabled, ToggleSwitch:disabled">
        <Setter Property="Opacity" Value="{DynamicResource InteractionDisabledOpacity}"/>
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TabItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot,
                     MenuItem:pointerover /template/ Border#PART_LayoutRoot,
                     MenuItem:pressed /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource SidebarHoverOutline}"/>
    </Style>

    <Style Selector="Border.menu-quick-surface:pointerover">
        <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource SidebarHoverOutline}"/>
    </Style>

    <Style Selector="TextBlock.menu-quick-label">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="WindowManagerAddShadowHint" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="Padding" Value="6"/>
    </Style>
    <Style Selector="Border.shortcut-hint">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="12"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="ClipToBounds" Value="False"/>
    </Style>
    <Style Selector="TextBlock.shortcut-group-title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.shortcut-name, TextBlock.shortcut-keys">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.shortcut-keys, TextBlock.shortcut-symbol,
                     MenuItem /template/ TextBlock#PART_InputGestureText">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyShortcut}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}"/>
    </Style>

    <Style Selector="TextBlock.shortcut-error">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    </Style>
    <Style Selector="Border.workspace-toolbar-material">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Margin" Value="0,4,4,4"/>
    </Style>
    <Style Selector="Border.workspace-preview-surface">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
    </Style>
    <Style Selector="Border.info-tag-chip">
        <Setter Property="Background" Value="{DynamicResource ColorSurfaceSecondary}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="Padding" Value="10,4,4,4"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>
    <Style Selector="Border.info-tag-chip:pointerover">
        <Setter Property="Background" Value="{DynamicResource ColorBgHover}"/>
    </Style>
    <Style Selector=":is(controls|AppWindow).background-themed Border.workspace-preview-surface">
        <Setter Property="Background" Value="{DynamicResource WorkspacePreviewBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector=":is(controls|AppWindow).background-themed Border.info-tag-chip">
        <Setter Property="Background" Value="{DynamicResource WorkspaceInfoTagBrush}"/>
    </Style>
    <Style Selector=":is(controls|AppWindow).background-themed Border.info-tag-chip:pointerover">
        <Setter Property="Background" Value="{DynamicResource WorkspaceControlHoverBrush}"/>
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style Selector="Separator.toolbar-separator">
        <Setter Property="Background" Value="{DynamicResource WorkspaceDividerBrush}"/>
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowSm}"/>
    </Style>
    <Style Selector="Border.surface">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
    </Style>
    <Style Selector="Border.popup-surface">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowMd}"/>
    </Style>

    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <!-- Shared nested tag navigation and assignment surfaces. -->
    <Style Selector="ListBox.tag-suggestions ListBoxItem">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Border.tag-toolbar-item">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
    </Style>
    <Style Selector="Border.tag-toolbar-item.active, Border.tag-tree-row.active">
        <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
    </Style>
    <Style Selector="Border.tag-tree-row">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.tag-tree-row:pointerover, Border.tag-tree-row:focus-within, Border.tag-tree-row.drop-inside">
        <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource SidebarHoverOutline}"/>
    </Style>
    <Style Selector="Border.tag-tree-row.drop-before">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0,2,0,0"/>
    </Style>
    <Style Selector="Border.tag-tree-row.drop-after">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <Style Selector="TextBlock.tag-tree-empty">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.tag-tree-error">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Margin" Value="8,4"/>
    </Style>
    <Style Selector="PathIcon.tag-tree-check">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="TextBlock.tag-tree-partial">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <StyleInclude Source="avares://MacExplorer/Assets/ToastStyles.axaml"/>

    <Style Selector="Border.theme-swatch-image">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Border.color-palette-surface">
        <Setter Property="Background" Value="{DynamicResource ColorBgHover}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    <Style Selector="PathIcon.color-palette-reset-icon">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="controls|ColorPalette.popover Border.color-palette-surface">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="6"/>
    </Style>

    <Style Selector="controls|ColorPalette.popover TextBlock.color-palette-reset-label">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="controls|ColorPalette.popover PathIcon.color-palette-reset-icon">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="Border.color-palette-dot">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusFull}"/>
    </Style>
    <Style Selector="ListBox.tab-strip ListBoxItem">
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="ListBox.tab-strip ListBoxItem.group-separated">
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>
    <Style Selector="controls|TabGroupLine">
        <Setter Property="Height" Value="2"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="ListBox.tab-strip ListBoxItem:selected controls|TabGroupLine,
                     controls|TabGroupLine.drag-preview">
        <Setter Property="Margin" Value="6,2,6,0"/>
    </Style>
    <Style Selector="Border.tab-group-header">
        <Setter Property="Margin" Value="0,6,4,8"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.tab-group-header TextBlock">
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}"/>
    </Style>
    <Style Selector="Grid.tab-title-content">
        <Setter Property="Margin" Value="10,0,4,2"/>
    </Style>
    <Style Selector="Border.tab-group-header.active TextBlock">
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}"/>
    </Style>
    <Style Selector="Slider.compact-slider:horizontal">
        <Setter Property="Theme" Value="{StaticResource CompactSliderTheme}"/>
    </Style>
    <Style Selector="ListBox.gallery-strip">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style Selector="ListBox.gallery-strip ListBoxItem">
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
    </Style>
    <Style Selector="ListBox.gallery-strip ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="ListBox.gallery-strip ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
    </Style>
    <Style Selector="controls|HomeFileImage.gallery-thumbnail">
        <Setter Property="ThumbnailShadow" Value="{DynamicResource ThumbnailShadow}"/>
    </Style>
</Styles>
