<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ControlTheme x:Key="FileHeaderButtonTheme" TargetType="Button">
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="Center"/>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
    <Style Selector="Button.file-header-button">
        <Setter Property="Theme" Value="{StaticResource FileHeaderButtonTheme}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="FocusAdorner" Value="{StaticResource KeyboardFocusAdorner}"/>
    </Style>
    <Style Selector="Button.file-header-button:pointerover, Button.file-header-button:pressed">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="Button.file-header-button.sorted, Button.file-header-button.filtered">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.file-header-button.filtered, Button.file-header-button.filter-open">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
    </Style>
    <Style Selector="Button.file-header-filter">
        <Setter Property="Width" Value="24"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="PathIcon.file-header-sort-icon">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Button.sorted PathIcon.file-header-sort-icon, Button.file-header-button:pointerover PathIcon.file-header-sort-icon">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="CheckBox.file-filter-option">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="CheckBox.file-filter-option:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
</Styles>
