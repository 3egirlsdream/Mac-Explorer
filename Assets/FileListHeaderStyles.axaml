<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBlock.file-list-column-caption">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
    </Style>

    <Style Selector="PathIcon.file-header-sort-icon">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector="CheckBox.file-filter-option">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="CheckBox.file-filter-option:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
</Styles>
