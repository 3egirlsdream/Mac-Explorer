        <Setter Property="Theme" Value="{StaticResource SidebarGlassButton}"/>
        <Setter Property="FocusAdorner" Value="{StaticResource SidebarGlassFocusAdorner}"/>
    </Style>
    <Style Selector="Button.sidebar-item-action:pressed, Button.sidebar-header-action:pressed, Button.sidebar-inline-confirm:pressed">
        <Setter Property="RenderTransform" Value="{x:Null}"/>
