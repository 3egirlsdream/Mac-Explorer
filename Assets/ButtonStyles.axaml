    </Styles.Resources>
    <Style Selector="Border.sidebar-item Button.sidebar-item-action">
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Grid.sidebar-section-header Button.sidebar-header-action">
        <Setter Property="MinWidth" Value="22"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.sidebar-item-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.sidebar-item-action.pinned-unpin:not(:focus-visible)">
        <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="Border.sidebar-item:pointerover Button.sidebar-item-action, Border.sidebar-item:focus-within Button.sidebar-item-action">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="True"/>
    </Style>
    <Style Selector="Grid.sidebar-section-header:pointerover Button.sidebar-header-action, Grid.sidebar-section-header:focus-within Button.sidebar-header-action">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="True"/>
    </Style>
    <Style Selector="Button.sidebar-inline-confirm">
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.sidebar-inline-confirm:pointerover">
        <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
