        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.toolbar-btn">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.w32">
        <Setter Property="Padding" Value="10 0"/>
    </Style>
    <Style Selector="Button.toolbar-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource WorkspaceControlHoverBrush}"/>
    </Style>
    <Style Selector="ToggleButton.view-mode-toggle">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <!-- Let the continuous-corner shadow fade beyond the rectangular button bounds. -->
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <Path Classes="view-mode-toggle-surface" Data="{StaticResource ViewModeSegmentGeometry}" IsHitTestVisible="False"/>
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Padding="{TemplateBinding Padding}"/>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Setter Property="FocusAdorner">
            <Template>
                <Path Data="{StaticResource ViewModeSegmentGeometry}" Stroke="{DynamicResource FocusRingBrush}" StrokeThickness="2" IsHitTestVisible="False"/>
            </Template>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.view-mode-toggle /template/ Path.view-mode-toggle-surface">
        <Setter Property="Fill" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton.view-mode-toggle:pointerover /template/ Path.view-mode-toggle-surface">
        <Setter Property="Fill" Value="{DynamicResource ViewModeToggleHoverBg}"/>
    </Style>
    <Style Selector="ToggleButton.view-mode-toggle:checked">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="ToggleButton.view-mode-toggle:checked /template/ Path.view-mode-toggle-surface">
        <Setter Property="Fill" Value="{DynamicResource ViewModeToggleSelectedBg}"/>
        <Setter Property="Effect" Value="{DynamicResource ViewModeToggleShadow}"/>
    </Style>
    <Style Selector="ToggleButton.view-mode-toggle:disabled">
        <Setter Property="Opacity" Value="{DynamicResource InteractionDisabledOpacity}"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="Button.toolbar-popup-item, ListBox.toolbar-popup-items ListBoxItem">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
