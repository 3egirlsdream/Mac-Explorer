        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.close-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="Button.title-nav-button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Margin" Value="2,6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="QuadraticEaseOut"/>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Setter Property="Theme" Value="{StaticResource SurfaceButtonTheme}"/>
    </Style>
    <Style Selector="Button.title-nav-button.tab-add">
        <Setter Property="Margin" Value="6,6,2,6"/>
    </Style>
    <Style Selector="Button.title-nav-button PathIcon">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
    </Style>
    <Style Selector="Button.title-nav-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="Button.title-nav-button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.94)"/>
    </Style>
    <Style Selector="Button.title-nav-button:disabled">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Opacity" Value="{DynamicResource InteractionDisabledOpacity}"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
    </Style>
    <Style Selector="Button.title-nav-button.active">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.search-clear-btn">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="MinWidth" Value="15"/>
        <Setter Property="MinHeight" Value="15"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.search-clear-btn PathIcon">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
    </Style>
    <Style Selector="Button, ToggleButton, SplitButton">
        <Setter Property="UseLayoutRounding" Value="False"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyButton}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="{StaticResource ControlPadding}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="QuadraticEaseOut"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.12" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
