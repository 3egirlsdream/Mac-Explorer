    <Style Selector="Button#DeleteButton:pointerover PathIcon, Button#DeleteOverflowButton:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>
    <Style Selector="Button.tab-close-button">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinWidth" Value="22"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Setter Property="Theme" Value="{StaticResource SurfaceButtonTheme}"/>
    </Style>
    <Style Selector="Button.tab-close-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="Button.layout-choice">
        <Setter Property="Height" Value="64"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="5,4"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.layout-choice controls|PaneLayoutIcon">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Foreground" Value="{DynamicResource PanePreviewFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanePreviewBorderBrush}"/>
    </Style>
    <Style Selector="Button.layout-choice TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.layout-choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="Button.layout-choice.selected">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.layout-choice.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.layout-choice.selected controls|PaneLayoutIcon">
        <Setter Property="Foreground" Value="{DynamicResource PanePreviewSelectedFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanePreviewSelectedBorderBrush}"/>
    </Style>
    <Style Selector="Button.layout-choice.selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Ellipse.traffic-light">
            <Setter Property="Stroke" Value="{DynamicResource TrafficLightOutlineBrush}"/>
            <Setter Property="StrokeThickness" Value="0.5"/>
        </Style>
    <Style Selector="Ellipse.traffic-close">
            <Setter Property="Fill" Value="{DynamicResource WindowCloseBrush}"/>
        </Style>
    <Style Selector="Ellipse.traffic-minimize">
            <Setter Property="Fill" Value="{DynamicResource WindowMinimizeBrush}"/>
        </Style>
    <Style Selector="Ellipse.traffic-fullscreen">
            <Setter Property="Fill" Value="{DynamicResource WindowMaximizeBrush}"/>
        </Style>
    <Style Selector="Path.window-control-symbol">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    <Style Selector="StackPanel.window-controls:pointerover Button.window-control:not(:disabled) Path.window-control-symbol,
                         Button.window-control:not(:disabled):focus-visible Path.window-control-symbol">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    <Style Selector="Button.window-control">
        <Setter Property="Theme" Value="{StaticResource TrafficLightButtonTheme}"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.window-control:pointerover">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
    </Style>
    <Style Selector="Button.window-control:pressed">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
    </Style>
    <Style Selector="Button.window-control:disabled">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
    </Style>
    <Style Selector="Button.window-control:focus-visible">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="controls|WindowTitleBar:inactive StackPanel.window-controls:not(:pointerover) Ellipse.traffic-light, Button.window-control:disabled Ellipse.traffic-light">
        <Setter Property="Fill" Value="{DynamicResource TrafficLightInactiveBrush}"/>
    </Style>
    <Style Selector="Button.window-control:pressed Ellipse.traffic-close">
        <Setter Property="Fill" Value="{DynamicResource TrafficLightClosePressedBrush}"/>
    </Style>
    <Style Selector="Button.window-control:pressed Ellipse.traffic-minimize">
        <Setter Property="Fill" Value="{DynamicResource TrafficLightMinimizePressedBrush}"/>
    </Style>
    <Style Selector="Button.window-control:pressed Ellipse.traffic-fullscreen">
        <Setter Property="Fill" Value="{DynamicResource TrafficLightFullScreenPressedBrush}"/>
    </Style>
    <!-- Application-wide sizes and roles. Pages only supply content and layout. -->
    <Style Selector="Button.dialog-action, ToggleButton.dialog-action">
        <Setter Property="MinWidth" Value="80"/>
    </Style>
    <Style Selector="Button.large, ToggleButton.large, SplitButton.large, SplitButton.large /template/ Button#PART_PrimaryButton">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style Selector="Button.small, ToggleButton.small, SplitButton.small, SplitButton.small /template/ Button#PART_PrimaryButton">
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
    </Style>
    <Style Selector="Button.icon-action.small, Button.row-more">
        <Setter Property="Width" Value="24"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.row-action">
        <Setter Property="Width" Value="70"/>
        <Setter Property="MinWidth" Value="70"/>
        <Setter Property="ToolTip.Tip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="ContentTemplate"><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/></DataTemplate></Setter>
    </Style>
    <Style Selector="Button.row-action.connected">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.preview-action">
        <Setter Property="Background" Value="{DynamicResource WorkspacePreviewActionBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.info-quick-action">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.file-header-button.text-column">
        <Setter Property="Padding" Value="8,0"/>
    </Style>
    <Style Selector="Button.breadcrumb-dropdown.overflow">
        <Setter Property="Width" Value="28"/>
    </Style>
    <Style Selector="Button.menu-quick-action">
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.tag-tree-name">
        <Setter Property="Height" Value="30"/>
    </Style>
    <Style Selector="Button.tag-toolbar-more">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="30"/>
    </Style>
    <Style Selector="Button.home-grid-item.expanded">
        <Setter Property="Width" Value="116"/>
        <Setter Property="Height" Value="116"/>
        <Setter Property="Margin" Value="4,6"/>
    </Style>

    <Style Selector="ToggleButton.primary:checked">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="ToggleButton.primary:checked:pointerover"><Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/></Style>
    <Style Selector="ToggleButton.danger:checked">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
    </Style>
    <Style Selector="ToggleButton.danger:checked:pointerover"><Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/></Style>
    <Style Selector="ToggleButton.secondary:checked, ToggleButton.ghost:checked">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="ToggleButton.secondary:checked:pointerover, ToggleButton.ghost:checked:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedHoverBrush}"/>
    </Style>
    <Style Selector="SplitButton.small /template/ Button#PART_SecondaryButton">
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyButton}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Background" Value="{DynamicResource AddressbarBg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="ComboBox.compact">
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="8,0"/>
    </Style>
    <Style Selector="ComboBox.small">
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
    </Style>
    <Style Selector="ComboBox.large">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style Selector="ComboBox.settings-inline-input">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ComboBox.icon-picker">
        <Setter Property="Width" Value="64"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="ComboBox:pointerover /template/ Border#Background,
                     ComboBox:pressed /template/ Border#Background,
                     ComboBox:focus /template/ Border#Background,
                     ComboBox:dropdownopen /template/ Border#Background">
        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder">
        <!-- Keep the menu at least as wide as the field, excluding shadow space. -->
        <Setter Property="MinWidth" Value="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"/>
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBoxItem:selected">
        <Setter Property="IsVisible" Value="False"/>
    </Style>


    <!-- The open-state trigger overrides Fluent's template-local submenu card values. -->
    <Style Selector="Border.context-submenu-surface,
                     Border.toolbar-popup, Border.omnibox-popup,
                     MenuItem[IsSubMenuOpen=True] /template/ Popup > Border,
                     ComboBox:dropdownopen /template/ Border#PopupBorder">
        <Setter Property="controls:PopupGlass.IsEnabled" Value="True"/>
        <Setter Property="Margin" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
        <Setter Property="ClipToBounds" Value="False"/>
    </Style>
    <Style Selector="glass|LiquidGlassSurface.popup-glass">
        <Setter Property="TintColor" Value="Transparent"/>
        <Setter Property="SurfaceColor" Value="{DynamicResource PopupGlassColor}"/>
        <Setter Property="BackdropOpacity" Value="{DynamicResource PopupGlassBackdrop}"/>
        <Setter Property="BlurRadius" Value="8"/>
        <Setter Property="RefractionHeight" Value="18"/>
        <Setter Property="RefractionAmount" Value="{DynamicResource PopupGlassRefraction}"/>
        <Setter Property="HighlightOpacity" Value="{DynamicResource PopupGlassHighlight}"/>
        <Setter Property="HighlightWidth" Value="0.65"/>
        <Setter Property="Vibrancy" Value="1"/>
        <Setter Property="DepthEffect" Value="False"/>
        <Setter Property="ChromaticAberration" Value="False"/>
        <Setter Property="InnerShadowEnabled" Value="False"/>
        <!-- 3 sigma + 1px antialiasing + 2px offset fits the 12px popup margin. -->
        <Setter Property="ShadowRadius" Value="3"/>
        <Setter Property="ShadowOffset" Value="0,2"/>
        <Setter Property="ShadowColor" Value="#24000000"/>
    </Style>

    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Theme" Value="{StaticResource StandardMenuFlyoutPresenterTheme}"/>
    </Style>
    <Style Selector="Button.dialog-location">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
</Styles>
