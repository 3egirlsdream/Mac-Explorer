<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:MacExplorer.Controls" xmlns:loc="using:MacExplorer.Controls" xmlns:views="using:MacExplorer.Views" xmlns:icons="using:MacExplorer.Assets" xmlns:glass="clr-namespace:LiquidGlassAvaloniaUI;assembly=LiquidGlassAvaloniaUI">
    <Styles.Resources>
        <ControlTheme x:Key="StandardMenuFlyoutPresenterTheme" TargetType="MenuFlyoutPresenter">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MaxWidth" Value="{DynamicResource FlyoutThemeMaxWidth}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Classes="context-submenu-surface">
                        <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" KeyboardNavigation.TabNavigation="Continue" Grid.IsSharedSizeScope="True"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="SecondarySplitButtonTheme" TargetType="SplitButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <controls:AppButton Name="PART_PrimaryButton" Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="0,0,29,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </controls:AppButton>
                        <Border Width="1" HorizontalAlignment="Right" Margin="0,5,28,5" Background="{DynamicResource DialogDividerBrush}" IsHitTestVisible="False"/>
                        <controls:AppButton Name="PART_SecondaryButton" Classes="icon-action" AutomationProperties.Name="{loc:Loc ui.runtime.188}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <PathIcon Data="{x:Static icons:Icons.ChevronDownGeometry}" Width="12" Height="12"/>
                        </controls:AppButton>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="IconActionButtonTheme" TargetType="Button">
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter" Background="Transparent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="IconActionToggleTheme" TargetType="ToggleButton" BasedOn="{StaticResource IconActionButtonTheme}"/>
        <Template x:Key="SidebarGlassFocusAdorner">
            <Border BorderBrush="{DynamicResource FocusRingBrush}" BorderThickness="2" CornerRadius="{DynamicResource InteractionCornerRadius}" IsHitTestVisible="False" glass:LiquidGlassBackdrop.IsExcludedFromCapture="True"/>
        </Template>
        <ControlTheme x:Key="SidebarGlassButton" TargetType="Button">
            <Setter Property="Template">
                <ControlTemplate>
                    <glass:LiquidGlassInteractiveSurface x:Name="ButtonGlass" CornerRadius="{TemplateBinding CornerRadius}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" TintColor="Transparent" SurfaceColor="Transparent" BackdropOpacity="{DynamicResource SidebarActionBackdropOpacity}" BlurRadius="0" RefractionHeight="8" RefractionAmount="0" HighlightOpacity="0" HighlightWidth="0.75" ShadowEnabled="False" InnerShadowEnabled="False" InteractiveMaxScaleDip="0.8">
                        <ContentPresenter x:Name="PART_ContentPresenter" Background="Transparent" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </glass:LiquidGlassInteractiveSurface>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ glass|LiquidGlassInteractiveSurface#ButtonGlass">
                <Setter Property="RefractionAmount" Value="{DynamicResource SidebarActionRefraction}"/>
                <Setter Property="HighlightOpacity" Value="{DynamicResource SidebarActionHoverHighlight}"/>
            </Style>
            <Style Selector="^:focus-visible /template/ glass|LiquidGlassInteractiveSurface#ButtonGlass">
                <Setter Property="RefractionAmount" Value="{DynamicResource SidebarActionRefraction}"/>
                <Setter Property="HighlightOpacity" Value="{DynamicResource SidebarActionFocusHighlight}"/>
            </Style>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="TrafficLightButtonTheme" TargetType="Button">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Ellipse x:Name="FocusRing" Width="22" Height="22" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^ /template/ Ellipse#FocusRing">
                <Setter Property="Opacity" Value="0"/>
            </Style>
            <Style Selector="^:focus-visible /template/ Ellipse#FocusRing">
                <Setter Property="Opacity" Value="1"/>
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="SurfaceButtonTheme" TargetType="Button">
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
