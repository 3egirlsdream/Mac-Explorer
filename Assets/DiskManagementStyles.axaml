<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="ListBox.disk-list">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    <Style Selector="ListBox.disk-list ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBox.disk-list ListBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.disk-row">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
    </Style>
    <Style Selector="ListBox.disk-list ListBoxItem:pointerover Border.disk-row">
        <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
    </Style>
    <Style Selector="ListBox.disk-list ListBoxItem:selected Border.disk-row">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
    </Style>
    <Style Selector="ProgressBar.disk-capacity">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="5"/>
        <Setter Property="MinHeight" Value="5"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource DialogDividerBrush}"/>
    </Style>
</Styles>
