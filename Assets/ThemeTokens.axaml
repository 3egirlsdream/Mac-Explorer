                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#202329"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#30343B"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="#12FFFFFF"/>
                    <SolidColorBrush x:Key="ControlPressedBrush" Color="#1CFFFFFF"/>
                    <SolidColorBrush x:Key="SelectionBrush" Color="#304C8DFF"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C2C3C5"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E9094"/>
                    <SolidColorBrush x:Key="TextSubtleBrush" Color="#6F7277"/>
                    <SolidColorBrush x:Key="TextDisabledBrush" Color="#55585D"/>
                    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#22FFFFFF"/>
                    <SolidColorBrush x:Key="BorderStrongBrush" Color="#38FFFFFF"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#5B9BFF"/>
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#77AAFF"/>
