<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System">
    <Styles.Resources>
        <ResourceDictionary>
        <Template x:Key="KeyboardFocusAdorner">
            <Border BorderBrush="{DynamicResource FocusRingBrush}" BorderThickness="2"
                    CornerRadius="{DynamicResource InteractionCornerRadius}" IsHitTestVisible="False"/>
        </Template>
            <sys:Double x:Key="Space1">4</sys:Double>
            <sys:Double x:Key="Space2">8</sys:Double>
            <sys:Double x:Key="Space3">12</sys:Double>
            <sys:Double x:Key="Space4">16</sys:Double>
            <sys:Double x:Key="Space5">20</sys:Double>
            <sys:Double x:Key="Space6">24</sys:Double>

            <CornerRadius x:Key="RadiusSm">4</CornerRadius>
            <CornerRadius x:Key="RadiusMd">7</CornerRadius>
            <CornerRadius x:Key="RadiusLg">10</CornerRadius>
            <CornerRadius x:Key="RadiusXl">14</CornerRadius>
            <CornerRadius x:Key="RadiusFull">999</CornerRadius>
            <!-- Shared geometry for ordinary interactive states. -->
            <CornerRadius x:Key="InteractionCornerRadius">10</CornerRadius>
            <sys:Double x:Key="InteractionDisabledOpacity">0.45</sys:Double>

            <Thickness x:Key="ControlPadding">12,7</Thickness>
            <Thickness x:Key="CompactControlPadding">9,5</Thickness>
            <Thickness x:Key="CardPadding">16</Thickness>

            <SolidColorBrush x:Key="WindowCloseBrush" Color="#FF5F57"/>
            <SolidColorBrush x:Key="WindowMinimizeBrush" Color="#FEBC2E"/>
            <SolidColorBrush x:Key="WindowMaximizeBrush" Color="#28C840"/>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PanePreviewFillBrush" Color="#E0E3E8"/>
                    <SolidColorBrush x:Key="PanePreviewBorderBrush" Color="#CBD0D8"/>
                    <SolidColorBrush x:Key="PanePreviewSelectedFillBrush" Color="#9FC7FF"/>
                    <SolidColorBrush x:Key="PanePreviewSelectedBorderBrush" Color="#72AEFF"/>
                    <BoxShadows x:Key="ShadowSm">0 0 2 0 #16000000</BoxShadows>
                    <BoxShadows x:Key="SurfaceCardShadow">0 0 8 -3 #2E000000, 0 0 3 -1 #20000000</BoxShadows>
                    <BoxShadows x:Key="ShadowMd">0 0 34 -10 #30000000</BoxShadows>
                    <BoxShadows x:Key="WindowShadow">0 0 32 -6 #40000000</BoxShadows>
                    <BoxShadows x:Key="InsetHairlineShadow">inset 0 0 0 1 #06000000</BoxShadows>
                    <BoxShadows x:Key="InputFocusShadow">0 0 28 -18 #2A000000, inset 0 0 0 1 #10000000</BoxShadows>
                    <BoxShadows x:Key="HomeSearchShadow">0 0 34 -22 #28000000, inset 0 0 0 1 #06000000</BoxShadows>
                    <BoxShadows x:Key="HomeSearchFocusShadow">0 0 42 -24 #30000000, inset 0 0 0 1 #10000000</BoxShadows>
                    <BoxShadows x:Key="ViewModeToggleShadow">0 1 2 0 #14000000</BoxShadows>
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#ECEEF1"/>
                    <SolidColorBrush x:Key="WindowBorderBrush" Color="#18000000"/>
                    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="ButtonPrimaryForegroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonDangerForegroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="DangerHoverBrush" Color="#A32E38"/>
                    <BoxShadows x:Key="SelectionOutlineShadow">none</BoxShadows>
                    <BoxShadows x:Key="FocusOutlineShadow">inset 0 0 0 2 #2463D4</BoxShadows>
                    <BoxShadows x:Key="InactiveSelectionOutlineShadow">none</BoxShadows>
                    <BoxShadows x:Key="PopupShadow">0 8 24 -8 #26000000</BoxShadows>
                    <!-- Semantic interaction tokens. Fluent compatibility resources are bridged at runtime. -->
                    <SolidColorBrush x:Key="InteractionHoverBrush" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="InteractionSelectedBrush" Color="#E5EEFC"/>
                    <SolidColorBrush x:Key="InteractionSelectedHoverBrush" Color="#D8E6FA"/>
                    <SolidColorBrush x:Key="InteractionTextHighlightBrush" Color="#22000000"/>
                    <!-- Fluent Button template source. -->
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#D8E6FA"/>
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="#D8E6FA"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#D8E6FA"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#D8E6FA"/>
                    <!-- Fluent input template source. -->
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2463D4"/>
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#22000000"/>
                    <!-- Keep Fluent scrollbars slim in both their resting and expanded states. -->
                    <Color x:Key="ScrollBarThumbBackgroundColor">#C9C9C9</Color>
                    <Color x:Key="ScrollBarPanningThumbBackgroundColor">#D9D9D9</Color>
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#D9D9D9"/>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#C9C9C9"/>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#B8B8B8"/>
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="Transparent"/>
                    <sys:Double x:Key="ScrollBarSize">8</sys:Double>
                    <TransformOperations x:Key="VerticalSmallScrollThumbScaleTransform">scaleX(0.75) translateX(-1px)</TransformOperations>
                    <TransformOperations x:Key="HorizontalSmallScrollThumbScaleTransform">scaleY(0.75) translateY(-1px)</TransformOperations>
                    <!-- ComboBox popups use the same compact surface as sidebar action menus. -->
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#2463D4"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="#252830"/>
                    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#252830"/>
                    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#252830"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#565D67"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#565D67"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#565D67"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#E1E4E9"/>
                    <BoxShadows x:Key="ComboBoxDropDownShadow">0 4 16 -8 #26000000</BoxShadows>
                    <Thickness x:Key="ComboBoxDropdownBorderThickness">1</Thickness>
                    <Thickness x:Key="ComboBoxDropdownBorderPadding">6</Thickness>
                    <Thickness x:Key="ComboBoxDropdownContentMargin">0</Thickness>
                    <Thickness x:Key="ComboBoxItemThemePadding">10,6</Thickness>
                    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#252830"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#252830"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="#252830"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#252830"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#252830"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#252830"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="SelectionBrush" Color="#E5EEFC"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#252830"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#565D67"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#646B76"/>
                    <SolidColorBrush x:Key="TextSubtleBrush" Color="#737A86"/>
                    <SolidColorBrush x:Key="TextDisabledBrush" Color="#A0A5AF"/>
                    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#E1E4E9"/>
                    <SolidColorBrush x:Key="BorderStrongBrush" Color="#7C8491"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#2463D4"/>
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1F56BA"/>
                    <SolidColorBrush x:Key="FocusRingBrush" Color="#2463D4"/>
                    <SolidColorBrush x:Key="DangerBrush" Color="#BF3B43"/>
                    <SolidColorBrush x:Key="SuccessBrush" Color="#23784D"/>
                    <SolidColorBrush x:Key="WarningBrush" Color="#946200"/>
                    <SolidColorBrush x:Key="OverlayBrush" Color="#B8FFFFFF"/>

                    <!-- Compatibility semantic names used by existing views. -->
                    <SolidColorBrush x:Key="ColorBgPrimary" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="ColorBgSidebar" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="ColorBgToolbar" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ColorBgContent" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ColorBgHover" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ColorBgHoverStrong" Color="#E0E4EA"/>
                    <SolidColorBrush x:Key="ColorBgActive" Color="#E0E4EA"/>
                    <SolidColorBrush x:Key="ColorBgSelected" Color="#E5EEFC"/>
                    <SolidColorBrush x:Key="ColorBgSelectedHover" Color="#D8E6FA"/>
                    <SolidColorBrush x:Key="ColorAccent" Color="#2463D4"/>
                    <SolidColorBrush x:Key="ColorAccentHover" Color="#1F56BA"/>
                    <SolidColorBrush x:Key="ColorAccentLight" Color="#E5EEFC"/>
                    <SolidColorBrush x:Key="ColorAccentMedium" Color="#2A3B82F6"/>
                    <SolidColorBrush x:Key="ColorBorder" Color="#E1E4E9"/>
                    <SolidColorBrush x:Key="ColorBorderStrong" Color="#7C8491"/>
                    <SolidColorBrush x:Key="ColorBorderSubtle" Color="#E1E4E9"/>
                    <SolidColorBrush x:Key="ColorBorderPrimary" Color="#E1E4E9"/>
                    <SolidColorBrush x:Key="ColorDivider" Color="#E1E4E9"/>
                    <SolidColorBrush x:Key="ColorDanger" Color="#BF3B43"/>
                    <SolidColorBrush x:Key="ColorWarning" Color="#946200"/>
                    <SolidColorBrush x:Key="ColorSuccess" Color="#23784D"/>
                    <SolidColorBrush x:Key="ColorSurfaceSecondary" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="GlassSidebarBg" Color="#EAFFFFFF"/>
                    <SolidColorBrush x:Key="GlassToolbarBg" Color="#F2FFFFFF"/>
                    <SolidColorBrush x:Key="GlassContentBg" Color="#F5FFFFFF"/>
                    <SolidColorBrush x:Key="GlassSurfaceTint" Color="#66FAFAFA"/>
                    <SolidColorBrush x:Key="GlassElevatedTint" Color="#66FAFAFA"/>
                    <SolidColorBrush x:Key="GlassMenuBg" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="GlassPanelBg" Color="#EEFFFFFF"/>
                    <SolidColorBrush x:Key="GlassEffectBg" Color="#FAFFFFFF"/>
                    <SolidColorBrush x:Key="GlassEffectBgSubmenu" Color="#F2FFFFFF"/>
                    <SolidColorBrush x:Key="AddressbarBg" Color="#080F172A"/>
                    <SolidColorBrush x:Key="AddressbarBgHover" Color="#100F172A"/>
                    <SolidColorBrush x:Key="AddressbarBgFocus" Color="#FAFFFFFF"/>
                    <SolidColorBrush x:Key="ViewModeToggleBg" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="ViewModeToggleBorder" Color="#E1E4E9"/>
                    <SolidColorBrush x:Key="ViewModeToggleHoverBg" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ViewModeToggleSelectedBg" Color="#E5EEFC"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PanePreviewFillBrush" Color="#424750"/>
                    <SolidColorBrush x:Key="PanePreviewBorderBrush" Color="#5A626E"/>
                    <SolidColorBrush x:Key="PanePreviewSelectedFillBrush" Color="#365E97"/>
                    <SolidColorBrush x:Key="PanePreviewSelectedBorderBrush" Color="#689EED"/>
                    <BoxShadows x:Key="ShadowSm">0 0 2 0 #70000000</BoxShadows>
                    <BoxShadows x:Key="SurfaceCardShadow">0 0 8 -3 #70000000, 0 0 3 -1 #58000000, inset 0 0 0 1 #18FFFFFF</BoxShadows>
                    <BoxShadows x:Key="ShadowMd">0 0 34 -10 #90000000</BoxShadows>
                    <BoxShadows x:Key="WindowShadow">0 0 32 -6 #A8000000</BoxShadows>
                    <BoxShadows x:Key="InsetHairlineShadow">inset 0 0 0 1 #36000000</BoxShadows>
                    <BoxShadows x:Key="InputFocusShadow">0 0 28 -18 #90000000, inset 0 0 0 1 #42000000</BoxShadows>
                    <BoxShadows x:Key="HomeSearchShadow">0 0 34 -22 #90000000, inset 0 0 0 1 #36000000</BoxShadows>
                    <BoxShadows x:Key="HomeSearchFocusShadow">0 0 42 -24 #A0000000, inset 0 0 0 1 #42000000</BoxShadows>
                    <BoxShadows x:Key="ViewModeToggleShadow">0 1 2 0 #76000000</BoxShadows>
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#17191D"/>
                    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#202329"/>
                    <SolidColorBrush x:Key="WindowBorderBrush" Color="#22000000"/>
                    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#17191D"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1D21"/>
                    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#292D34"/>
                    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#24272D"/>
                    <SolidColorBrush x:Key="ButtonPrimaryForegroundBrush" Color="#17253D"/>
                    <SolidColorBrush x:Key="ButtonDangerForegroundBrush" Color="#381A20"/>
                    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FFA6AC"/>
                    <BoxShadows x:Key="SelectionOutlineShadow">none</BoxShadows>
                    <BoxShadows x:Key="FocusOutlineShadow">inset 0 0 0 2 #8AB4FF</BoxShadows>
                    <BoxShadows x:Key="InactiveSelectionOutlineShadow">none</BoxShadows>
                    <BoxShadows x:Key="PopupShadow">0 8 24 -8 #90000000</BoxShadows>
                    <!-- Semantic interaction tokens. Fluent compatibility resources are bridged at runtime. -->
                    <SolidColorBrush x:Key="InteractionHoverBrush" Color="#2B3038"/>
                    <SolidColorBrush x:Key="InteractionSelectedBrush" Color="#283E61"/>
                    <SolidColorBrush x:Key="InteractionSelectedHoverBrush" Color="#324C74"/>
                    <SolidColorBrush x:Key="InteractionTextHighlightBrush" Color="#33FFFFFF"/>
                    <!-- Fluent Button template source. -->
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2B3038"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2B3038"/>
                    <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#2B3038"/>
                    <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="#2B3038"/>
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#324C74"/>
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="#324C74"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#2B3038"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#2B3038"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#324C74"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#324C74"/>
                    <!-- Fluent input template source. -->
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2B3038"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8AB4FF"/>
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#33FFFFFF"/>
                    <Color x:Key="ScrollBarThumbBackgroundColor">#8B8E94</Color>
                    <Color x:Key="ScrollBarPanningThumbBackgroundColor">#73767C</Color>
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#73767C"/>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#8B8E94"/>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#A2A5AB"/>
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="Transparent"/>
                    <sys:Double x:Key="ScrollBarSize">8</sys:Double>
                    <TransformOperations x:Key="VerticalSmallScrollThumbScaleTransform">scaleX(0.75) translateX(-1px)</TransformOperations>
                    <TransformOperations x:Key="HorizontalSmallScrollThumbScaleTransform">scaleY(0.75) translateY(-1px)</TransformOperations>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#2B3038"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#8AB4FF"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#2B3038"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#24272D"/>
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#B8BEC8"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#B8BEC8"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#B8BEC8"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#292D34"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#343942"/>
                    <BoxShadows x:Key="ComboBoxDropDownShadow">0 4 16 -8 #70000000</BoxShadows>
                    <Thickness x:Key="ComboBoxDropdownBorderThickness">1</Thickness>
                    <Thickness x:Key="ComboBoxDropdownBorderPadding">6</Thickness>
                    <Thickness x:Key="ComboBoxDropdownContentMargin">0</Thickness>
                    <Thickness x:Key="ComboBoxItemThemePadding">10,6</Thickness>
                    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#2B3038"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#2B3038"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="#2B3038"/>
                    <SolidColorBrush x:Key="SelectionBrush" Color="#283E61"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEEF2"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8BEC8"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#A4AAB5"/>
                    <SolidColorBrush x:Key="TextSubtleBrush" Color="#8E98A8"/>
                    <SolidColorBrush x:Key="TextDisabledBrush" Color="#686F7C"/>
                    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#343942"/>
                    <SolidColorBrush x:Key="BorderStrongBrush" Color="#A4AAB5"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#8AB4FF"/>
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#A3C4FF"/>
                    <SolidColorBrush x:Key="FocusRingBrush" Color="#8AB4FF"/>
                    <SolidColorBrush x:Key="DangerBrush" Color="#FF8D94"/>
                    <SolidColorBrush x:Key="SuccessBrush" Color="#7AC99A"/>
                    <SolidColorBrush x:Key="WarningBrush" Color="#EBC16A"/>
                    <SolidColorBrush x:Key="OverlayBrush" Color="#76000000"/>

                    <SolidColorBrush x:Key="ColorBgPrimary" Color="#17191D"/>
                    <SolidColorBrush x:Key="ColorBgSidebar" Color="#202329"/>
                    <SolidColorBrush x:Key="ColorBgToolbar" Color="#1B1D21"/>
                    <SolidColorBrush x:Key="ColorBgContent" Color="#1B1D21"/>
                    <SolidColorBrush x:Key="ColorBgHover" Color="#2B3038"/>
                    <SolidColorBrush x:Key="ColorBgHoverStrong" Color="#363D48"/>
                    <SolidColorBrush x:Key="ColorBgActive" Color="#363D48"/>
                    <SolidColorBrush x:Key="ColorBgSelected" Color="#283E61"/>
                    <SolidColorBrush x:Key="ColorBgSelectedHover" Color="#324C74"/>
                    <SolidColorBrush x:Key="ColorAccent" Color="#8AB4FF"/>
                    <SolidColorBrush x:Key="ColorAccentHover" Color="#A3C4FF"/>
                    <SolidColorBrush x:Key="ColorAccentLight" Color="#283E61"/>
                    <SolidColorBrush x:Key="ColorAccentMedium" Color="#405B9BFF"/>
                    <SolidColorBrush x:Key="ColorBorder" Color="#343942"/>
                    <SolidColorBrush x:Key="ColorBorderStrong" Color="#A4AAB5"/>
                    <SolidColorBrush x:Key="ColorBorderSubtle" Color="#343942"/>
                    <SolidColorBrush x:Key="ColorBorderPrimary" Color="#343942"/>
                    <SolidColorBrush x:Key="ColorDivider" Color="#343942"/>
                    <SolidColorBrush x:Key="ColorDanger" Color="#FF8D94"/>
                    <SolidColorBrush x:Key="ColorWarning" Color="#EBC16A"/>
                    <SolidColorBrush x:Key="ColorSuccess" Color="#7AC99A"/>
                    <SolidColorBrush x:Key="ColorSurfaceSecondary" Color="#24272D"/>
                    <SolidColorBrush x:Key="GlassSidebarBg" Color="#EA181A1F"/>
                    <SolidColorBrush x:Key="GlassToolbarBg" Color="#F21B1D23"/>
                    <SolidColorBrush x:Key="GlassContentBg" Color="#F21E2026"/>
                    <SolidColorBrush x:Key="GlassSurfaceTint" Color="#661E2026"/>
                    <SolidColorBrush x:Key="GlassElevatedTint" Color="#66252830"/>
                    <SolidColorBrush x:Key="GlassMenuBg" Color="#292D34"/>
                    <SolidColorBrush x:Key="GlassPanelBg" Color="#F022252B"/>
                    <SolidColorBrush x:Key="GlassEffectBg" Color="#FA202329"/>
                    <SolidColorBrush x:Key="GlassEffectBgSubmenu" Color="#F2252830"/>
                    <SolidColorBrush x:Key="AddressbarBg" Color="#10FFFFFF"/>
                    <SolidColorBrush x:Key="AddressbarBgHover" Color="#18FFFFFF"/>
                    <SolidColorBrush x:Key="AddressbarBgFocus" Color="#F2252830"/>
                    <SolidColorBrush x:Key="ViewModeToggleBg" Color="#24272D"/>
                    <SolidColorBrush x:Key="ViewModeToggleBorder" Color="#343942"/>
                    <SolidColorBrush x:Key="ViewModeToggleHoverBg" Color="#2B3038"/>
                    <SolidColorBrush x:Key="ViewModeToggleSelectedBg" Color="#283E61"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
