<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System">
    <Styles.Resources>
        <ResourceDictionary>
            <sys:Double x:Key="Space1">4</sys:Double>
            <sys:Double x:Key="Space2">8</sys:Double>
            <sys:Double x:Key="Space3">12</sys:Double>
            <sys:Double x:Key="Space4">16</sys:Double>
            <sys:Double x:Key="Space5">20</sys:Double>
            <sys:Double x:Key="Space6">24</sys:Double>

            <CornerRadius x:Key="RadiusSm">4</CornerRadius>
            <CornerRadius x:Key="RadiusMd">7</CornerRadius>
            <CornerRadius x:Key="RadiusLg">10</CornerRadius>
            <CornerRadius x:Key="RadiusXl">14</CornerRadius>
            <CornerRadius x:Key="RadiusFull">999</CornerRadius>
            <!-- Shared geometry for ordinary interactive states. -->
            <CornerRadius x:Key="InteractionCornerRadius">10</CornerRadius>
            <sys:Double x:Key="InteractionDisabledOpacity">0.45</sys:Double>

            <Thickness x:Key="ControlPadding">12,7</Thickness>
            <Thickness x:Key="CompactControlPadding">9,5</Thickness>
            <Thickness x:Key="CardPadding">16</Thickness>

            <SolidColorBrush x:Key="WindowCloseBrush" Color="#FF5F57"/>
            <SolidColorBrush x:Key="WindowMinimizeBrush" Color="#FEBC2E"/>
            <SolidColorBrush x:Key="WindowMaximizeBrush" Color="#28C840"/>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <BoxShadows x:Key="ShadowSm">0 0 2 0 #16000000</BoxShadows>
                    <BoxShadows x:Key="SurfaceCardShadow">0 0 8 -3 #2E000000, 0 0 3 -1 #20000000</BoxShadows>
                    <BoxShadows x:Key="ShadowMd">0 0 34 -10 #30000000</BoxShadows>
                    <BoxShadows x:Key="WindowShadow">0 0 32 -6 #40000000</BoxShadows>
                    <BoxShadows x:Key="InsetHairlineShadow">inset 0 0 0 1 #06000000</BoxShadows>
                    <BoxShadows x:Key="InputFocusShadow">0 0 28 -18 #2A000000, inset 0 0 0 1 #10000000</BoxShadows>
                    <BoxShadows x:Key="HomeSearchShadow">0 0 34 -22 #28000000, inset 0 0 0 1 #06000000</BoxShadows>
                    <BoxShadows x:Key="HomeSearchFocusShadow">0 0 42 -24 #30000000, inset 0 0 0 1 #10000000</BoxShadows>
                    <BoxShadows x:Key="ViewModeToggleShadow">0 1 2 0 #14000000</BoxShadows>
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FAFAFA"/>
                    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#E7E0DB"/>
                    <SolidColorBrush x:Key="WindowBorderBrush" Color="#18000000"/>
                    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FAFAFA"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F0F1F3"/>
                    <!-- Semantic interaction tokens. Fluent compatibility resources are bridged at runtime. -->
                    <SolidColorBrush x:Key="InteractionHoverBrush" Color="#F0F1F3"/>
                    <SolidColorBrush x:Key="InteractionPressedBrush" Color="#E4E6EA"/>
                    <SolidColorBrush x:Key="InteractionSelectedBrush" Color="#163B82F6"/>
                    <SolidColorBrush x:Key="InteractionSelectedHoverBrush" Color="#253B82F6"/>
                    <SolidColorBrush x:Key="InteractionTextHighlightBrush" Color="#22000000"/>
                    <!-- Fluent Button template source. -->
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F0F1F3"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E4E6EA"/>
                    <!-- Fluent input template source. -->
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F0F1F3"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#163B82F6"/>
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#22000000"/>
                    <!-- Keep Fluent scrollbars slim in both their resting and expanded states. -->
                    <Color x:Key="ScrollBarThumbBackgroundColor">#C9C9C9</Color>
                    <Color x:Key="ScrollBarPanningThumbBackgroundColor">#D9D9D9</Color>
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#D9D9D9"/>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#C9C9C9"/>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#B8B8B8"/>
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="Transparent"/>
                    <sys:Double x:Key="ScrollBarSize">8</sys:Double>
                    <TransformOperations x:Key="VerticalSmallScrollThumbScaleTransform">scaleX(0.75) translateX(-1px)</TransformOperations>
                    <TransformOperations x:Key="HorizontalSmallScrollThumbScaleTransform">scaleY(0.75) translateY(-1px)</TransformOperations>
                    <!-- ComboBox popups use the same compact surface as sidebar action menus. -->
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F0F1F3"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#163B82F6"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#E4E6EA"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#F0F1F3"/>
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="#444648"/>
                    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#444648"/>
                    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#444648"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#626468"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#626468"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#626468"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F7FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#E6E8ED"/>
                    <BoxShadows x:Key="ComboBoxDropDownShadow">0 4 16 -8 #26000000</BoxShadows>
                    <Thickness x:Key="ComboBoxDropdownBorderThickness">1</Thickness>
                    <Thickness x:Key="ComboBoxDropdownBorderPadding">6</Thickness>
                    <Thickness x:Key="ComboBoxDropdownContentMargin">0</Thickness>
                    <Thickness x:Key="ComboBoxItemThemePadding">10,6</Thickness>
                    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#444648"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#444648"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="#444648"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#444648"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#444648"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#444648"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#F0F1F3"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#E4E6EA"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="#0B0F172A"/>
                    <SolidColorBrush x:Key="ControlPressedBrush" Color="#120F172A"/>
                    <SolidColorBrush x:Key="SelectionBrush" Color="#163B82F6"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#444648"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#626468"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#989A9E"/>
                    <SolidColorBrush x:Key="TextSubtleBrush" Color="#AEB0B4"/>
                    <SolidColorBrush x:Key="TextDisabledBrush" Color="#C2C4C7"/>
                    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#18000000"/>
                    <SolidColorBrush x:Key="BorderStrongBrush" Color="#2A000000"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB"/>
                    <SolidColorBrush x:Key="FocusRingBrush" Color="#163B82F6"/>
                    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>
                    <SolidColorBrush x:Key="SuccessBrush" Color="#2F9E64"/>
                    <SolidColorBrush x:Key="WarningBrush" Color="#D99000"/>
                    <SolidColorBrush x:Key="OverlayBrush" Color="#B8FFFFFF"/>

                    <!-- Compatibility semantic names used by existing views. -->
                    <SolidColorBrush x:Key="ColorBgPrimary" Color="#FAFAFA"/>
                    <SolidColorBrush x:Key="ColorBgSidebar" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ColorBgToolbar" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ColorBgContent" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ColorBgHover" Color="#0B0F172A"/>
                    <SolidColorBrush x:Key="ColorBgHoverStrong" Color="#120F172A"/>
                    <SolidColorBrush x:Key="ColorBgActive" Color="#100F172A"/>
                    <SolidColorBrush x:Key="ColorBgSelected" Color="#163B82F6"/>
                    <SolidColorBrush x:Key="ColorBgSelectedHover" Color="#253B82F6"/>
                    <SolidColorBrush x:Key="ColorAccent" Color="#3B82F6"/>
                    <SolidColorBrush x:Key="ColorAccentHover" Color="#2563EB"/>
                    <SolidColorBrush x:Key="ColorAccentLight" Color="#163B82F6"/>
                    <SolidColorBrush x:Key="ColorAccentMedium" Color="#2A3B82F6"/>
                    <SolidColorBrush x:Key="ColorBorder" Color="#18000000"/>
                    <SolidColorBrush x:Key="ColorBorderStrong" Color="#2A000000"/>
                    <SolidColorBrush x:Key="ColorBorderSubtle" Color="#10000000"/>
                    <SolidColorBrush x:Key="ColorBorderPrimary" Color="#18000000"/>
                    <SolidColorBrush x:Key="ColorDivider" Color="#14000000"/>
                    <SolidColorBrush x:Key="ColorDanger" Color="#E5484D"/>
                    <SolidColorBrush x:Key="ColorWarning" Color="#D99000"/>
                    <SolidColorBrush x:Key="ColorSuccess" Color="#2F9E64"/>
                    <SolidColorBrush x:Key="ColorSurfaceSecondary" Color="#F0F1F3"/>
                    <SolidColorBrush x:Key="GlassSidebarBg" Color="#EAFFFFFF"/>
                    <SolidColorBrush x:Key="GlassToolbarBg" Color="#F2FFFFFF"/>
                    <SolidColorBrush x:Key="GlassContentBg" Color="#F5FFFFFF"/>
                    <SolidColorBrush x:Key="GlassSurfaceTint" Color="#66FAFAFA"/>
                    <SolidColorBrush x:Key="GlassElevatedTint" Color="#66FAFAFA"/>
                    <SolidColorBrush x:Key="GlassMenuBg" Color="#F7FFFFFF"/>
                    <SolidColorBrush x:Key="GlassPanelBg" Color="#EEFFFFFF"/>
                    <SolidColorBrush x:Key="GlassEffectBg" Color="#FAFFFFFF"/>
                    <SolidColorBrush x:Key="GlassEffectBgSubmenu" Color="#F2FFFFFF"/>
                    <SolidColorBrush x:Key="AddressbarBg" Color="#080F172A"/>
                    <SolidColorBrush x:Key="AddressbarBgHover" Color="#100F172A"/>
                    <SolidColorBrush x:Key="AddressbarBgFocus" Color="#FAFFFFFF"/>
                    <SolidColorBrush x:Key="ViewModeToggleBg" Color="#F0F1F4"/>
                    <SolidColorBrush x:Key="ViewModeToggleBorder" Color="#E6E8ED"/>
                    <SolidColorBrush x:Key="ViewModeToggleHoverBg" Color="#E7E9EE"/>
                    <SolidColorBrush x:Key="ViewModeToggleSelectedBg" Color="#FFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <BoxShadows x:Key="ShadowSm">0 0 2 0 #70000000</BoxShadows>
                    <BoxShadows x:Key="SurfaceCardShadow">0 0 8 -3 #70000000, 0 0 3 -1 #58000000, inset 0 0 0 1 #18FFFFFF</BoxShadows>
                    <BoxShadows x:Key="ShadowMd">0 0 34 -10 #90000000</BoxShadows>
                    <BoxShadows x:Key="WindowShadow">0 0 32 -6 #A8000000</BoxShadows>
                    <BoxShadows x:Key="InsetHairlineShadow">inset 0 0 0 1 #36000000</BoxShadows>
                    <BoxShadows x:Key="InputFocusShadow">0 0 28 -18 #90000000, inset 0 0 0 1 #42000000</BoxShadows>
                    <BoxShadows x:Key="HomeSearchShadow">0 0 34 -22 #90000000, inset 0 0 0 1 #36000000</BoxShadows>
                    <BoxShadows x:Key="HomeSearchFocusShadow">0 0 42 -24 #A0000000, inset 0 0 0 1 #42000000</BoxShadows>
                    <BoxShadows x:Key="ViewModeToggleShadow">0 1 2 0 #76000000</BoxShadows>
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#181A1F"/>
                    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#302B28"/>
                    <SolidColorBrush x:Key="WindowBorderBrush" Color="#22000000"/>
                    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#14161A"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#F21E2026"/>
                    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#252830"/>
                    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#202329"/>
                    <!-- Semantic interaction tokens. Fluent compatibility resources are bridged at runtime. -->
                    <SolidColorBrush x:Key="InteractionHoverBrush" Color="#202329"/>
                    <SolidColorBrush x:Key="InteractionPressedBrush" Color="#30343B"/>
                    <SolidColorBrush x:Key="InteractionSelectedBrush" Color="#304C8DFF"/>
                    <SolidColorBrush x:Key="InteractionSelectedHoverBrush" Color="#405B9BFF"/>
                    <SolidColorBrush x:Key="InteractionTextHighlightBrush" Color="#33FFFFFF"/>
                    <!-- Fluent Button template source. -->
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#202329"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#30343B"/>
                    <!-- Fluent input template source. -->
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#202329"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#304C8DFF"/>
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#33FFFFFF"/>
                    <Color x:Key="ScrollBarThumbBackgroundColor">#8B8E94</Color>
                    <Color x:Key="ScrollBarPanningThumbBackgroundColor">#73767C</Color>
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#73767C"/>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#8B8E94"/>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#A2A5AB"/>
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="Transparent"/>
                    <sys:Double x:Key="ScrollBarSize">8</sys:Double>
                    <TransformOperations x:Key="VerticalSmallScrollThumbScaleTransform">scaleX(0.75) translateX(-1px)</TransformOperations>
                    <TransformOperations x:Key="HorizontalSmallScrollThumbScaleTransform">scaleY(0.75) translateY(-1px)</TransformOperations>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#202329"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#304C8DFF"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#30343B"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#202329"/>
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="#F2F2F2"/>
                    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#F2F2F2"/>
                    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#F2F2F2"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#C2C3C5"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#C2C3C5"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#C2C3C5"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FA252830"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#30343D"/>
                    <BoxShadows x:Key="ComboBoxDropDownShadow">0 4 16 -8 #70000000</BoxShadows>
                    <Thickness x:Key="ComboBoxDropdownBorderThickness">1</Thickness>
                    <Thickness x:Key="ComboBoxDropdownBorderPadding">6</Thickness>
                    <Thickness x:Key="ComboBoxDropdownContentMargin">0</Thickness>
                    <Thickness x:Key="ComboBoxItemThemePadding">10,6</Thickness>
                    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#F2F2F2"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#F2F2F2"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="#F2F2F2"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#F2F2F2"/>
