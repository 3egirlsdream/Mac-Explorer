<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- SwiftUI RoundedRectangle(style: .continuous) outlines at the fixed toolbar sizes:
             track 68x32 / radius 11; segment 32x28 / radius 9. Keep these sizes together. -->
        <StreamGeometry x:Key="ViewModeTrackGeometry">
            M 68.00000,16.00000
            L 68.00000,16.00000
            C 68.00000,20.22477 68.00000,22.52218 67.17597,25.05357
            C 66.14034,27.89894 63.89894,30.14034 61.05357,31.17597
            C 58.44752,32.00000 56.02661,32.00000 51.18469,32.00000
            L 16.81531,32.00000
            C 11.97339,32.00000 9.55248,32.00000 6.94643,31.17597
            C 4.10106,30.14034 1.85966,27.89894 0.82403,25.05357
            C 0.00000,22.52218 0.00000,20.22477 0.00000,16.00000
            L 0.00000,16.00000
            C 0.00000,11.77523 0.00000,9.47782 0.82403,6.94643
            C 1.85966,4.10106 4.10106,1.85966 6.94643,0.82403
            C 9.55248,0.00000 11.97339,0.00000 16.81531,0.00000
            L 51.18469,0.00000
            C 56.02661,0.00000 58.44752,0.00000 61.05357,0.82403
            C 63.89894,1.85966 66.14034,4.10106 67.17597,6.94643
            C 68.00000,9.47782 68.00000,11.77523 68.00000,16.00000
            Z
        </StreamGeometry>
        <StreamGeometry x:Key="ViewModeSegmentGeometry">
            M 32.00000,14.00000
            L 32.00000,14.24202
            C 32.00000,18.20359 32.00000,20.18434 31.32580,22.31655
            C 30.47846,24.64458 28.64458,26.47846 26.31655,27.32580
            C 24.18434,28.00000 22.20359,28.00000 18.24202,28.00000
            L 13.75798,28.00000
            C 9.79641,28.00000 7.81566,28.00000 5.68345,27.32580
            C 3.35542,26.47846 1.52154,24.64458 0.67420,22.31655
            C 0.00000,20.18434 0.00000,18.20359 0.00000,14.24202
            L 0.00000,13.75798
            C 0.00000,9.79641 0.00000,7.81566 0.67420,5.68345
            C 1.52154,3.35542 3.35542,1.52154 5.68345,0.67420
            C 7.81566,0.00000 9.79641,0.00000 13.75798,0.00000
            L 18.24202,0.00000
            C 22.20359,0.00000 24.18434,0.00000 26.31655,0.67420
            C 28.64458,1.52154 30.47846,3.35542 31.32580,5.68345
            C 32.00000,7.81566 32.00000,9.79641 32.00000,13.75798
            Z
        </StreamGeometry>
    </Styles.Resources>

    <!-- ═══════════════════════════════════════
       MacExplorer Design System v3 — Avalonia
       Windows 11 Fluent Design × macOS Vibrancy
       ═══════════════════════════════════════ -->

    <!-- ── Glass Effect ── -->
    <Style Selector="Border.glass-effect">
        <Setter Property="Background" Value="{DynamicResource GlassEffectBg}"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style Selector="Border.glass-effect-without-border">
        <Setter Property="Background" Value="{DynamicResource GlassEffectBg}"/>
    </Style>

    <!-- ═══ Sidebar Styles ═══ -->
    <Style Selector="Border.finder-sidebar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBox.sidebar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem">
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySidebar}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightLight}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Margin" Value="4,1"/>
        <Setter Property="MinHeight" Value="{DynamicResource TypographyListRowMinHeight}"/>
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
    </Style>

    <Style Selector="TextBlock.sidebar-section-title">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySidebar}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="18,4,18,4"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <!-- Collapsible section title -->
    <Style Selector="TextBlock.sidebar-section-title-collapsible">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySidebar}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="18,4,18,4"/>
        <Setter Property="Margin" Value="0,8,0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Collapse chevron -->
    <Style Selector="PathIcon.sidebar-collapse-icon">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}"/>
    </Style>

    <Style Selector="PathIcon.sidebar-collapse-icon.expanded">
        <Setter Property="RenderTransform" Value="rotate(0.25turn)"/>
    </Style>

    <Style Selector="Grid.sidebar-section-header">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Grid.sidebar-section-header PathIcon.sidebar-header-reveal">
        <Setter Property="Opacity" Value="0.65"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- Sidebar item action button (visible on hover) -->
    <Style Selector="Border.sidebar-item Button.sidebar-item-action">
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Grid.sidebar-section-header Button.sidebar-header-action">
        <Setter Property="MinWidth" Value="22"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.sidebar-item-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Button.sidebar-item-action.pinned-unpin:not(:focus-visible)">
        <Setter Property="Opacity" Value="0"/>
    </Style>

    <Style Selector="ItemsControl.sidebar-items">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="ItemsControl.sidebar-items ContentPresenter">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>



    <!-- Sidebar item — non-ListBox, for single items with inline buttons -->
    <Style Selector="Border.sidebar-item">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Margin" Value="4,1"/>
        <Setter Property="MinHeight" Value="{DynamicResource TypographyListRowMinHeight}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Border.sidebar-item > Grid">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.sidebar-item > StackPanel">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.sidebar-item PathIcon">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.sidebar-item TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySidebar}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightLight}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightBodyLarge}"/>
    </Style>

    <Style Selector="Border.sidebar-item TextBlock.sidebar-secondary-text">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightBody}"/>
    </Style>

    <Style Selector="TextBox.collection-name-editor">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySidebar}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightLight}"/>
    </Style>

    <Style Selector="Border.sidebar-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>

    <Style Selector="Border.sidebar-item:pointerover Button.sidebar-item-action, Border.sidebar-item:focus-within Button.sidebar-item-action">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="True"/>
    </Style>

    <Style Selector="Grid.sidebar-section-header:pointerover Button.sidebar-header-action, Grid.sidebar-section-header:focus-within Button.sidebar-header-action">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="True"/>
    </Style>

    <Style Selector="Grid.sidebar-section-header:pointerover PathIcon.sidebar-header-reveal">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Border.sidebar-item.active">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
    </Style>

    <Style Selector="Button.sidebar-inline-confirm">
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.sidebar-inline-confirm:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>

    <Style Selector="Button.sidebar-inline-confirm PathIcon">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- ═══ Toolbar Styles ═══ -->
    <Style Selector="Border.finder-toolbar">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style Selector="Border.finder-navbar">
        <Setter Property="Height" Value="52"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,0"/>
    </Style>

    <Style Selector="Button.toolbar-btn">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    
    <Style Selector="Button.w32">
        <Setter Property="Padding" Value="10 0"/>
    </Style>

    <Style Selector="Button.toolbar-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>

    <Style Selector="Grid.view-mode-segmented">
        <Setter Property="Width" Value="68"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="ToggleButton.view-mode-toggle">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <!-- Let the continuous-corner shadow fade beyond the rectangular button bounds. -->
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <Path Classes="view-mode-toggle-surface"
                          Data="{StaticResource ViewModeSegmentGeometry}"
                          IsHitTestVisible="False"/>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Padding="{TemplateBinding Padding}"/>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Setter Property="FocusAdorner">
            <Template>
                <Path Data="{StaticResource ViewModeSegmentGeometry}"
                      Stroke="{DynamicResource FocusRingBrush}" StrokeThickness="2"
                      IsHitTestVisible="False"/>
            </Template>
        </Setter>
    </Style>

    <Style Selector="ToggleButton.view-mode-toggle /template/ Path.view-mode-toggle-surface">
        <Setter Property="Fill" Value="Transparent"/>
    </Style>

    <Style Selector="ToggleButton.view-mode-toggle:pointerover /template/ Path.view-mode-toggle-surface">
        <Setter Property="Fill" Value="{DynamicResource ViewModeToggleHoverBg}"/>
    </Style>

    <Style Selector="ToggleButton.view-mode-toggle:checked">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="ToggleButton.view-mode-toggle:checked /template/ Path.view-mode-toggle-surface">
        <Setter Property="Fill" Value="{DynamicResource ViewModeToggleSelectedBg}"/>
        <Setter Property="Effect" Value="{DynamicResource ViewModeToggleShadow}"/>
    </Style>

    <Style Selector="ToggleButton.view-mode-toggle:disabled">
        <Setter Property="Opacity" Value="{DynamicResource InteractionDisabledOpacity}"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <Style Selector="TextBlock.toolbar-popup-header">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Margin" Value="8,6,8,3"/>
    </Style>

    <Style Selector="Border.toolbar-popup">
        <Setter Property="Margin" Value="12"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource GlassMenuBg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BoxShadow" Value="{DynamicResource PopupShadow}"/>
    </Style>

    <Style Selector="Button.toolbar-popup-item, ListBox.toolbar-popup-items ListBoxItem">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.toolbar-popup-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>

    <Style Selector="ListBox.toolbar-popup-items ListBoxItem:pointerover /template/ ContentPresenter,
                     ListBox.toolbar-popup-items ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
    </Style>




    <Style Selector="Button.toolbar-btn.dropdown-open">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorAccent}"/>
    </Style>

    <Style Selector="Button.toolbar-btn:disabled">
        <Setter Property="Opacity" Value="{DynamicResource InteractionDisabledOpacity}"/>
    </Style>

    <Style Selector="Button.toolbar-btn PathIcon">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
    </Style>

    <Style Selector="Button.toolbar-btn.active">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorAccent}"/>
    </Style>

    <Style Selector="Separator.toolbar-separator">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Background" Value="{DynamicResource ColorBorder}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ═══ Breadcrumb Styles ═══ -->
    <Style Selector="Border.breadcrumb-bar">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="TextBox.breadcrumb-input">
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="MaxHeight" Value="30"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.breadcrumb-bar.path-editing:focus-within">
        <Setter Property="BoxShadow" Value="{DynamicResource FocusOutlineShadow}"/>
    </Style>
    <Style Selector="Border.breadcrumb-bar.home-location">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BoxShadow" Value="none"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <Style Selector="TextBox.omnibox-input">
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource InteractionTextHighlightBrush}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

<Style Selector="TextBox.omnibox-input:pointerover, TextBox.omnibox-input:focus">
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
</Style>

<Style Selector="TextBox.omnibox-input /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
</Style>

<Style Selector="TextBox.omnibox-input:pointerover /template/ Border#PART_BorderElement, TextBox.omnibox-input:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
</Style>

    <Style Selector="Border.omnibox-popup">
        <Setter Property="Margin" Value="12"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource GlassMenuBg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BoxShadow" Value="{DynamicResource PopupShadow}"/>
    </Style>

    <Style Selector="ListBox.omnibox-suggestions">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBox.omnibox-suggestions ListBoxItem">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="ListBox.omnibox-suggestions ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
    </Style>

    <Style Selector="ListBox.omnibox-suggestions ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
    </Style>

    <!-- ═══ Search Bar Styles ═══ -->
    <Style Selector="Border.search-bar">
        <Setter Property="Background" Value="{DynamicResource AddressbarBg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Width" Value="220"/>
        <Setter Property="BoxShadow" Value="{DynamicResource InsetHairlineShadow}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.search-bar:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>

    <Style Selector="Border.search-bar:focus-within">
        <Setter Property="Background" Value="{DynamicResource AddressbarBgFocus}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="252"/>
        <Setter Property="BoxShadow" Value="{DynamicResource InputFocusShadow}"/>
    </Style>

    <!-- Fluent expands a scrollbar on hover; retain the same rounded, trackless shape. -->
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}"/>
    </Style>

    <Style Selector="TextBox.search-input">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Padding" Value="3,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ═══ File List Styles ═══ -->
    <Style Selector="Border.file-list-header">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="12,0,12,0"/>
    </Style>

    <Style Selector="ListBox.file-list">
        <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBox.file-scroll-host">
        <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBox.file-scroll-host /template/ Border">
        <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
    </Style>

    <Style Selector="ListBox.file-scroll-host /template/ ScrollViewer">
        <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
    </Style>

    <Style Selector="ListBox.file-scroll-host /template/ ScrollBar#PART_VerticalScrollBar">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>

    <Style Selector="ListBox.grouped-file-list-row">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style Selector="Border.file-list-entry TextBlock, Border.file-grid-content TextBlock">
        <Setter Property="FontWeight" Value="{StaticResource FontWeightLight}"/>
    </Style>

    <Style Selector="TextBlock.file-column-header">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="TextBlock.file-group-header">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.file-group-row">
        <Setter Property="MinHeight" Value="{DynamicResource TypographyListRowMinHeight}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style Selector="TextBlock.file-group-count">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightLight}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>

    <Style Selector="Border.file-group-divider">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource ColorDivider}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>

    <!-- ═══ Grid View Styles ═══ -->
    <Style Selector="ListBox.file-grid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <Style Selector="ListBox.file-grid-row">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style Selector="Border.file-grid-content">
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Button.rating-star">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
    </Style>
    <Style Selector="Button.rating-star PathIcon">
        <Setter Property="Width" Value="11"/>
        <Setter Property="Height" Value="11"/>
    </Style>
    <Style Selector="Button.rating-star:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>

    <Style Selector="Grid.entry-content.drag-over">
        <Setter Property="Background" Value="{DynamicResource ColorAccentLight}"/>
    </Style>
    <Style Selector="Border.entry-content.drag-over">
        <Setter Property="Background" Value="{DynamicResource ColorAccentLight}"/>
    </Style>

    <!-- ═══ Status Bar ═══ -->
    <Style Selector="Border.status-bar">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <!-- ═══ Preview Pane ═══ -->
    <Style Selector="Border.preview-pane">
        <Setter Property="Background" Value="{DynamicResource GlassPanelBg}"/>
        <Setter Property="Width" Value="280"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
    </Style>

    <Style Selector="Border.preview-pane-header">
        <Setter Property="Padding" Value="14"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- ═══ Metadata Panel ═══ -->
    <Style Selector="Border.metadata-panel">
        <Setter Property="Background" Value="{DynamicResource GlassEffectBg}"/>
        <Setter Property="Width" Value="340"/>
    </Style>

    <Style Selector="Button.info-tab">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.info-tab:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>

    <Style Selector="Button.info-tab-active">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.info-tab-active:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedHoverBrush}"/>
    </Style>

    <!-- ═══ Info Panel Rating Stars ═══ -->
    <Style Selector="Button.rating-star-btn">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.rating-star-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>

    <!-- ═══ Dialogs ═══ -->
    <Style Selector="Window.fk-dialog">
        <Setter Property="CanResize" Value="False"/>
        <Setter Property="WindowStartupLocation" Value="CenterOwner"/>
        <Setter Property="WindowDecorations" Value="Full"/>
        <Setter Property="Background" Value="{DynamicResource GlassEffectBg}"/>
    </Style>

    <Style Selector="Button.modal-btn">
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    </Style>

    <Style Selector="Button.modal-btn-cancel">
        <Setter Property="Background" Value="{DynamicResource ColorBgHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.modal-btn-danger">
        <Setter Property="Background" Value="{DynamicResource ColorDanger}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.modal-btn-danger:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>


    <!-- ═══ AI View ═══ -->
    <Style Selector="Border.ai-view-host">
        <Setter Property="Background" Value="{DynamicResource ColorBgContent}"/>
    </Style>

    <Style Selector="Border.ai-search-box">
        <Setter Property="Background" Value="{DynamicResource AddressbarBg}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="BoxShadow" Value="{DynamicResource InsetHairlineShadow}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.ai-search-box:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>

    <Style Selector="Border.ai-search-box:focus-within">
        <Setter Property="Background" Value="{DynamicResource AddressbarBgFocus}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BoxShadow" Value="{DynamicResource InputFocusShadow}"/>
    </Style>

    <!-- ═══ Task Overlay Panel ═══ -->

    <Style Selector="Border.task-overlay-row">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="Border.task-overlay-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>

    <Style Selector="Border.task-state-dot">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
    <Style Selector="Border.task-state-dot.running">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Border.task-state-dot.completed">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
    </Style>
    <Style Selector="Border.task-state-dot.failed">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <Style Selector="TextBlock.task-label">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.task-percent">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.task-status">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="ProgressBar.task-mini">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    </Style>

    <Style Selector="Button.task-row-close">
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
    </Style>
    <Style Selector="Button.task-row-close PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="Button.task-row-close:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="Button.task-row-close:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- ═══ Home View ═══ -->
    <Style Selector="Border.home-quick-links">
        <Setter Property="Background" Value="{DynamicResource ColorBgHover}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="Width" Value="360"/>
    </Style>

    <Style Selector="Border.home-search-box">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
    </Style>
    <Style Selector="Border.home-search-box:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
    <Style Selector="Border.home-search-box:focus-within">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource FocusOutlineShadow}"/>
    </Style>

    <Style Selector="TextBox.home-search-input">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}"/>
        <Setter Property="Padding" Value="4,0,14,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBox.home-search-input:pointerover, TextBox.home-search-input:focus">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.home-shortcut">
        <Setter Property="Width" Value="136"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
    </Style>

    <Style Selector="Button.home-shortcut:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>

    <Style Selector="Border.home-shortcut-icon">
        <Setter Property="Width" Value="82"/>
        <Setter Property="Height" Value="82"/>
        <Setter Property="CornerRadius" Value="41"/>
        <Setter Property="Background" Value="{DynamicResource GlassPanelBg}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ═══ Tooltip ═══ -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource GlassEffectBgSubmenu}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <!-- ═══ Settings Tab Styles ═══ -->
    <Style Selector="ListBox.settings-tabs">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="140"/>
    </Style>

    <Style Selector="ListBox.settings-tabs ListBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>

    <Style Selector="ListBox.settings-tabs ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
    </Style>

    <Style Selector="ListBox.settings-tabs ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource InteractionSelectedBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
    </Style>

    <!-- ═══ Settings Content ═══ -->
    <Style Selector="CheckBox.settings-check">
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    </Style>

    <Style Selector="TextBlock.settings-section-title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeHeading}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- ═══ Compress Dialog ═══ -->
    <Style Selector="Button.segment-btn">
        <Setter Property="Background" Value="{DynamicResource ColorBgHover}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>

    <Style Selector="Button.segment-btn.active">
        <Setter Property="Background" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>

    <!-- ═══ About Panel ═══ -->
    <Style Selector="Button.about-update-btn">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="Padding" Value="24,10"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.close-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="Button.close-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>

    <!-- ═══ Drag States ═══ -->
    <Style Selector="Border.file-list-row.external-drag-over">
        <Setter Property="Background" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="Opacity" Value="0.15"/>
    </Style>

    <!-- ═══ Empty State ═══ -->
    <Style Selector="TextBlock.empty-state-text">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ═══ Liquid Glass Buttons ═══ -->
    <Style Selector="Button.glass-btn">
        <Setter Property="Background" Value="#14000000"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Padding" Value="28,10"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.glass-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>


    <Style Selector="Button.glass-btn:disabled">
        <Setter Property="Opacity" Value="{DynamicResource InteractionDisabledOpacity}"/>
    </Style>

    <Style Selector="Button.glass-btn-ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource InteractionCornerRadius}"/>
        <Setter Property="Padding" Value="28,10"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.glass-btn-ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractionHoverBrush}"/>
    </Style>
</Styles>
